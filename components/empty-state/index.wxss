/* 公共空态：居中、图标/emoji、灰文案 */
.es {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.es-icon { margin-bottom: 20rpx; }

.es-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.es-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.es-sub {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
}

.es-btn {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #fff;
  background: var(--color-primary);
  border-radius: 999rpx;
  padding: 16rpx 48rpx;
}
.es-btn-hover { opacity: 0.85; }

/* 老年模式：页面根节点带 .elderly-mode，靠 apply-shared 命中 */
.elderly-mode .es-text { font-size: 32rpx; }
.elderly-mode .es-sub { font-size: 30rpx; }
.elderly-mode .es-btn { font-size: 30rpx; padding: 20rpx 56rpx; }
