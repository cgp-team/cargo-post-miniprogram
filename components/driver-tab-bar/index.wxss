/* 司机端自定义TabBar */
.driver-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #0D0D0D;
  border-top: 1rpx solid #2A2A2A;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 12rpx;
  position: relative;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  color: #4CAF50;
}

.tab-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.tab-label {
  font-size: 22rpx;
  font-weight: 500;
}

.tab-indicator {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #4CAF50;
  border-radius: 0 0 3rpx 3rpx;
}
