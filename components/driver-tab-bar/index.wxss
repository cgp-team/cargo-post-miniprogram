/* 司机端自定义TabBar —— 站牌车票风（暗色保留，激活图标主题主色块） */
.driver-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #12110F;
  border-top: 1rpx solid #2A2A2A;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 12rpx;
  position: relative;
  color: var(--color-text-tertiary, #8A8578);
  transition: all 0.3s;
}

.tab-item.active {
  color: var(--color-accent);
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  line-height: 1;
  transition: all 0.3s;
}

/* 激活：图标变主题主色块白字，弹跳落定 */
@keyframes tab-pop {
  0%   { transform: scale(0.72); }
  60%  { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.tab-item.active .tab-icon {
  background: var(--color-primary);
  border-radius: 22rpx;
  padding: 8rpx 26rpx;
  box-sizing: content-box;
  box-shadow: inset 0 4rpx 0 rgba(255, 255, 255, 0.16), 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
  animation: tab-pop 0.3s cubic-bezier(0.34, 1.45, 0.64, 1);
}

.tab-label {
  font-size: 22rpx;
  font-weight: 500;
}

.tab-item.active .tab-label {
  font-weight: 700;
  color: var(--color-accent);
}

/* 按压反馈 */
.tab-hover {
  opacity: 0.7;
}

/* 老年人模式：字号放大 + 加高点击区 */
.elderly-mode .tab-item {
  min-height: 116rpx;
}

.elderly-mode .tab-label {
  font-size: 30rpx;
}
