<view class="sp">
  <!-- 触发行 -->
  <view class="sp-row" bindtap="onRowTap" hover-class="hover">
    <text class="sp-row-text {{selectedName ? '' : 'sp-placeholder'}}">{{selectedName || placeholder}}</text>
    <text class="sp-arrow">▾</text>
  </view>

  <!-- 半屏弹窗遮罩 -->
  <view wx:if="{{sheetVisible}}" class="sp-mask anim-fade" bindtap="close"></view>
  <view wx:if="{{sheetVisible}}" class="sp-sheet anim-sheet">
    <view class="sp-head">
      <text class="sp-title">{{title}}</text>
      <view class="sp-close" bindtap="close" hover-class="hover">
        <text class="sp-close-x">✕</text>
      </view>
    </view>

    <view class="sp-search">
      <icon name="search" size="32" color="{{iconColor}}" />
      <input class="sp-search-input" placeholder="搜索站点名称或地址" value="{{keyword}}" bindinput="onSearchInput" />
    </view>

    <scroll-view class="sp-list" scroll-y>
      <!-- 加载态 -->
      <view wx:if="{{loading}}" class="sp-empty">
        <text class="sp-empty-text">站点加载中…</text>
      </view>
      <!-- 错误态 + 重新加载入口 -->
      <view wx:elif="{{error}}" class="sp-empty">
        <text class="sp-empty-text">站点加载失败，点击重试</text>
        <view class="sp-retry-btn" bindtap="onRetry" hover-class="hover">重新加载</view>
      </view>
      <!-- 空态 / 搜索无结果 -->
      <view wx:elif="{{!filteredStations.length}}" class="sp-empty">
        <text class="sp-empty-text">{{keyword ? '未找到相关站点' : '暂无可用站点'}}</text>
      </view>
      <block wx:else>
        <view
          wx:for="{{filteredStations}}"
          wx:key="id"
          class="sp-item {{item.id === value ? 'sp-item-active' : ''}}"
          bindtap="onSelectStation"
          data-index="{{index}}"
          hover-class="sp-item-hover"
        >
          <view class="sp-item-main">
            <text class="sp-item-name">{{item.stationName}}</text>
            <text class="sp-item-addr">{{item.address || '暂无详细地址'}}</text>
          </view>
          <text wx:if="{{item.id === value}}" class="sp-check">✓</text>
        </view>
      </block>
    </scroll-view>

    <view class="sp-foot">
      <view class="sp-cancel" bindtap="close" hover-class="hover">取消</view>
    </view>
  </view>
</view>
