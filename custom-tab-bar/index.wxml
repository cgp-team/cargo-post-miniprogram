<!-- 自定义底部 TabBar  v2: removed icon-wrap nesting, simpler DOM -->
<view class="tab-bar {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
    hover-class="tab-hover"
  >
    <icon class="tab-icon" name="{{item.icon}}" size="{{elderlyMode ? 52 : 44}}"
      color="{{selected === index ? '#FFFFFF' : '#8A8578'}}" />
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
