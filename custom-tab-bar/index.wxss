/* 自定义底部 TabBar 样式 */

/* P1 fix: touch targets ≥ 88rpx (WCAG 2.5.5 / responsive) */
/* P2 fix: reduced shadow, cleaner separation */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 9999;
  /* 主题色默认值，根节点内联 style 覆盖 */
  --color-primary: #2E7D32;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  padding: 8rpx 0;
  position: relative;
  color: #999999;
  transition: color 0.18s ease;
}

.tab-item.active {
  color: var(--color-primary);
}

.tab-hover {
  opacity: 0.7;
}

.tab-emoji {
  font-size: 42rpx;
  line-height: 1;
  display: block;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 500;
  margin-top: 2rpx;
  line-height: 1;
}

.tab-active-line {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 5rpx;
  background: var(--color-primary);
  border-radius: 0 0 4rpx 4rpx;
}
