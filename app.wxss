/* 全局样式 - 农村客货邮小程序 */

/* 颜色变量参考（山乡巴士 · 站牌与车票） */
/* 主色：#2E7D32（站牌绿，大面积主角）*/
/* 深绿：#1C4B2E（头部/标题）*/
/* 辅色：#4CAF50（新芽绿，强调）*/
/* 暖色：#C75B2A（陶土橙，司机/行动）、#D9A441（稻谷金，农产品/公告）*/
/* 底色：#F6F2E9（米纸底） */
/* 文字：#2B2B28（墨字） */

page {
  /* 主题色 CSS 变量默认值（页面根节点内联 style 可覆盖）
     设计语言：山乡巴士 · 站牌与车票 */
  --color-primary: #2E7D32;
  --color-primary-dark: #1C4B2E;
  --color-accent: #4CAF50;
  --color-primary-light: #EAF3EA;
  --color-on-primary: #ffffff;
  --color-clay: #C75B2A;   /* 陶土橙：司机/行动 */
  --color-gold: #D9A441;   /* 稻谷金：农产品/公告 */
  --color-paper: #F6F2E9;  /* 米纸底：页面底色 */
  --color-ink: #2B2B28;    /* 墨字：正文 */

  /* 语义变量（appearance.js 按主题注入同组变量） */
  --color-price: #C75B2A;          /* 价格：统一陶土橙，不再用警示红 */
  --color-danger: #C0392B;         /* 危险操作（退出/删除）专用，与价格解耦 */
  --color-text-secondary: #6B675C; /* 辅助文字（对比度 ≥ 4.5:1 的适老化基线） */
  --color-text-tertiary: #8A8778;  /* 最弱辅助文字，不允许再浅 */
  --color-status-pending: #C75B2A; /* 待付款/待处理 */
  --color-status-shipping: #2E7D32;/* 运输中/进行中（跟随主题主色） */
  --color-status-done: #8A8778;    /* 已完成/已结束 */
  --color-status-warn: #B27A12;    /* 提醒/临近 */
  --radius-s: 8rpx;
  --radius-m: 16rpx;
  --radius-l: 24rpx;
  --radius-pill: 999rpx;
  --shadow-card: 0 2rpx 8rpx rgba(60, 50, 30, 0.05), 0 8rpx 24rpx rgba(60, 50, 30, 0.06);
  --shadow-float: 0 8rpx 24rpx rgba(60, 50, 30, 0.12);

  background-color: var(--color-paper);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-ink);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  animation: page-in 0.25s ease-out;
}

@keyframes page-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 通用按钮 —— 站牌式：深绿实板，顶部一条浅色"落款横档"，似真实站牌 */
.btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border: none;
  border-radius: 10rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  letter-spacing: 2rpx;
  box-shadow: inset 0 6rpx 0 rgba(255,255,255,0.12), 0 6rpx 16rpx rgba(0,0,0,0.10);
  transition: all 0.15s ease;
}

.btn-primary:active {
  background: var(--color-primary-dark);
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.10), 0 2rpx 8rpx rgba(0,0,0,0.10);
}

.btn-orange {
  background: var(--color-clay);
  color: #ffffff;
  border: none;
  border-radius: 10rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  letter-spacing: 2rpx;
  box-shadow: inset 0 6rpx 0 rgba(255,255,255,0.12), 0 6rpx 16rpx rgba(0,0,0,0.10);
  transition: all 0.15s ease;
}

.btn-orange:active {
  background: var(--color-clay);
  filter: brightness(0.9);
  transform: scale(0.98);
}

.btn-outline {
  background-color: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 14rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.15s ease;
}

.btn-outline:active {
  background-color: var(--color-primary-light);
}

/* 输入框 */
.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E4DECD;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background-color: #FBF8F1;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.input-field:focus {
  border-color: var(--color-accent);
  background-color: #fff;
  box-shadow: 0 0 0 6rpx rgba(76,175,80,0.08);
}

.input-field::placeholder {
  color: #A6A6A6;
}

/* 卡片 — 暖白 + 柔和阴影，悬浮感 */
.card {
  background-color: #FFFDF8;
  border-radius: 18rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 50, 30, 0.05), 0 8rpx 24rpx rgba(60, 50, 30, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(60, 50, 30, 0.05), 0 4rpx 12rpx rgba(60, 50, 30, 0.06);
}

/* ============ 签名原语：山乡巴士 · 站牌与车票 ============ */

/* 站牌头部：深绿实板 + 顶部落款横档 + 角落线路号角标 */
.signpost {
  position: relative;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  color: #ffffff;
  padding: 30rpx 32rpx 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 75, 46, 0.25);
  overflow: hidden;
}

.signpost::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 24rpx;
  right: 24rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 3rpx;
}

.signpost::after {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -20rpx;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.signpost-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #ffffff;
}

.signpost-sub {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: rgba(255,255,255,0.82);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.signpost-badge {
  position: absolute;
  top: 22rpx;
  right: 24rpx;
  z-index: 2;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  letter-spacing: 1rpx;
}

/* 车票卡：暖白底 + 右侧虚线撕口 + 左上角票号位 */
.ticket-card {
  position: relative;
  background: #FFFDF8;
  border-radius: 16rpx 8rpx 8rpx 16rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 50, 30, 0.05), 0 8rpx 24rpx rgba(60, 50, 30, 0.06);
  overflow: hidden;
}

.ticket-card::after {
  /* 右侧锯齿撕口：半圆向左凸入卡片，米纸底色透出（每 16rpx 一个） */
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 16rpx;
  background: radial-gradient(circle at 0% 50%, #F6F2E9 8rpx, transparent 8.5rpx) 0 0 / 16rpx 16rpx repeat-y;
}

.ticket-card::before {
  /* 撕口内侧虚线（车票副券线） */
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  right: 16rpx;
  width: 2rpx;
  background: repeating-linear-gradient(180deg, #D8D2C4 0, #D8D2C4 8rpx, transparent 8rpx, transparent 16rpx);
}

/* 山路线：虚线道路 + 站点圆点（时间线/进度用） */
.road-line {
  position: relative;
  height: 6rpx;
  margin: 24rpx 0;
  background: repeating-linear-gradient(90deg, var(--color-accent) 0, var(--color-accent) 12rpx, transparent 12rpx, transparent 20rpx);
  opacity: 0.7;
}

/* 弹性布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 文本 */
.text-green {
  color: var(--color-primary);
}

.text-orange {
  color: var(--color-clay);
}

.text-gray {
  color: var(--color-text-secondary);
}

.text-center {
  text-align: center;
}

/* 全局按压反馈：配合 hover-class 使用。
   微信原生 hover 即时生效（约50ms），比 :active + 长过渡更跟手；
   轻微缩小 + 降透明度，模拟"按下去"的触感 */
.hover {
  opacity: 0.82;
  transform: scale(0.98);
}

/* 按钮禁用态：表单提交中/不可用时置灰，去掉立体感 */
.btn-primary[disabled],
.btn-primary.disabled,
.btn-orange[disabled],
.btn-orange.disabled,
.btn-outline[disabled],
.btn-outline.disabled {
  opacity: 0.5;
  box-shadow: none;
  pointer-events: none;
  filter: saturate(0.4);
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ============ 老年人模式：全局字体放大 ============
   页面根节点挂 .elderly-mode 类后，以下规则比页面同级选择器
   优先级更高（多一层类），会覆盖页面样式中的字号 */
.elderly-mode .btn-primary,
.elderly-mode .btn-orange,
.elderly-mode .btn-outline {
  font-size: 38rpx;
  padding: 30rpx 40rpx;
}

.elderly-mode .input-label {
  font-size: 32rpx;
}

.elderly-mode .input-field {
  font-size: 34rpx;
  height: 96rpx;
}

.elderly-mode .card {
  padding: 34rpx;
}
