/* 全局样式 - 农村客货邮小程序 */

/* 颜色变量参考 */
/* 主色：#2E7D32（深绿，代表农业/自然）*/
/* 辅色：#4CAF50（翠绿）*/
/* 辅色：#FF9800（橙色，代表公交/活力）*/
/* 背景：#F5F5F5 */
/* 文字：#333333 */

page {
  /* 主题色 CSS 变量默认值（页面根节点内联 style 可覆盖） */
  --color-primary: #2E7D32;
  --color-primary-dark: #1B5E20;
  --color-accent: #4CAF50;
  --color-primary-light: #E8F5E9;
  --color-on-primary: #ffffff;

  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  animation: page-in 0.25s ease-out;
}

@keyframes page-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: var(--color-on-primary);
  border: none;
  border-radius: 14rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  letter-spacing: 1rpx;
  transition: all 0.15s ease;
}

.btn-primary:active {
  background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  transform: scale(0.98);
}

.btn-orange {
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  color: #ffffff;
  border: none;
  border-radius: 14rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  letter-spacing: 1rpx;
  transition: all 0.15s ease;
}

.btn-orange:active {
  background: linear-gradient(135deg, #F57C00, #FF9800);
  transform: scale(0.98);
}

.btn-outline {
  background-color: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 14rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.15s ease;
}

.btn-outline:active {
  background-color: var(--color-primary-light);
}

/* 输入框 */
.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background-color: #F8FAF8;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.input-field:focus {
  border-color: var(--color-accent);
  background-color: #fff;
  box-shadow: 0 0 0 6rpx rgba(76,175,80,0.08);
}

.input-field::placeholder {
  color: #A6A6A6;
}

/* 卡片 — 深度阴影，悬浮感 */
.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04), 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 弹性布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 文本 */
.text-green {
  color: var(--color-primary);
}

.text-orange {
  color: #E65100;
}

.text-gray {
  color: #757575;
}

.text-center {
  text-align: center;
}

/* 全局按压反馈：配合 hover-class 使用。
   微信原生 hover 即时生效（约50ms），比 :active + 长过渡更跟手 */
.hover {
  opacity: 0.8;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ============ 老年人模式：全局字体放大 ============
   页面根节点挂 .elderly-mode 类后，以下规则比页面同级选择器
   优先级更高（多一层类），会覆盖页面样式中的字号 */
.elderly-mode .btn-primary,
.elderly-mode .btn-orange,
.elderly-mode .btn-outline {
  font-size: 38rpx;
  padding: 30rpx 40rpx;
}

.elderly-mode .input-label {
  font-size: 32rpx;
}

.elderly-mode .input-field {
  font-size: 34rpx;
  height: 96rpx;
}

.elderly-mode .card {
  padding: 34rpx;
}
