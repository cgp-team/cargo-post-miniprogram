/* 全局样式 - 农村客货邮小程序 */

/* 颜色变量参考（山乡巴士 · 站牌与车票） */
/* 主色：#2E7D32（站牌绿，大面积主角）*/
/* 深绿：#1C4B2E（头部/标题）*/
/* 辅色：#4CAF50（新芽绿，强调）*/
/* 暖色：#C75B2A（陶土橙，司机/行动）、#D9A441（稻谷金，农产品/公告）*/
/* 底色：#F6F2E9（米纸底） */
/* 文字：#2B2B28（墨字） */

page {
  /* 主题色 CSS 变量默认值（页面根节点内联 style 可覆盖）
     设计语言：山乡巴士 · 站牌与车票 */
  --color-primary: #2E7D32;
  --color-primary-dark: #1C4B2E;
  --color-accent: #4CAF50;
  --color-primary-light: #EAF3EA;
  --color-on-primary: #ffffff;
  --color-clay: #C75B2A;   /* 陶土橙：司机/行动 */
  --color-gold: #D9A441;   /* 稻谷金：农产品/公告 */
  --color-paper: #F6F2E9;  /* 米纸底：页面底色 */
  --color-ink: #2B2B28;    /* 墨字：正文 */

  /* 语义变量（appearance.js 按主题注入同组变量） */
  --color-price: #C75B2A;          /* 价格：统一陶土橙，不再用警示红 */
  --color-danger: #C0392B;         /* 危险操作（退出/删除）专用，与价格解耦 */
  --color-text-secondary: #6B675C; /* 辅助文字（对比度 ≥ 4.5:1 的适老化基线） */
  --color-text-tertiary: #8A8778;  /* 最弱辅助文字，不允许再浅 */
  --color-status-pending: #C75B2A; /* 待付款/待处理 */
  --color-status-shipping: #2E7D32;/* 运输中/进行中（跟随主题主色） */
  --color-status-done: #8A8778;    /* 已完成/已结束 */
  --color-status-warn: #B27A12;    /* 提醒/临近 */

  /* 表面色（换肤跟随主题；各主题值见 utils/appearance.js THEMES） */
  --color-card: #FFFDF8;        /* 卡片表面：暖白 */
  --color-card-warm: #FCF8EC;   /* 车票副券/票根：略泛黄 */
  --color-field: #FBF8F1;       /* 输入框底 */
  --color-line: #E4DECD;        /* 描边/分隔线 */
  --color-line-deep: #D8D2C4;   /* 撕票虚线/开关灭 */
  --color-track: #EDE7D9;       /* 分段控件轨道/浅暖填充 */
  --color-gold-light: #FBF3DF;  /* 稻谷金浅底 */
  --color-gold-deep: #8A6A1F;   /* 稻谷金深字 */
  --color-clay-light: #F8ECE3;  /* 陶土橙浅底 */
  --color-clay-deep: #A64A1F;   /* 陶土橙深字 */
  --color-skeleton-a: #EAE4D4;  /* 骨架流光两端 */
  --color-skeleton-b: #F7F2E6;  /* 骨架流光中段 */

  --radius-s: 8rpx;
  --radius-m: 16rpx;
  --radius-l: 24rpx;
  --radius-pill: 999rpx;
  --shadow-card: 0 2rpx 8rpx rgba(60, 50, 30, 0.05), 0 8rpx 24rpx rgba(60, 50, 30, 0.06);
  --shadow-float: 0 8rpx 24rpx rgba(60, 50, 30, 0.12);

  background-color: var(--color-paper);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-ink);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  animation: page-in 0.25s ease-out;
}

@keyframes page-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 通用按钮 —— 站牌式：深绿实板，顶部一条浅色"落款横档"，似真实站牌 */
.btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border: none;
  border-radius: 10rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  letter-spacing: 2rpx;
  box-shadow: inset 0 6rpx 0 rgba(255,255,255,0.12), 0 6rpx 16rpx rgba(0,0,0,0.10);
  transition: all 0.15s ease;
}

.btn-primary:active {
  background: var(--color-primary-dark);
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.10), 0 2rpx 8rpx rgba(0,0,0,0.10);
}

.btn-orange {
  background: var(--color-clay);
  color: #ffffff;
  border: none;
  border-radius: 10rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  letter-spacing: 2rpx;
  box-shadow: inset 0 6rpx 0 rgba(255,255,255,0.12), 0 6rpx 16rpx rgba(0,0,0,0.10);
  transition: all 0.15s ease;
}

.btn-orange:active {
  background: var(--color-clay);
  filter: brightness(0.9);
  transform: scale(0.98);
}

.btn-outline {
  background-color: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 14rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.15s ease;
}

.btn-outline:active {
  background-color: var(--color-primary-light);
}

/* 输入框 */
.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid var(--color-line);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background-color: var(--color-field);
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.input-field:focus {
  border-color: var(--color-accent);
  background-color: #fff;
  box-shadow: 0 0 0 6rpx var(--color-primary-shadow);
}

.input-field::placeholder {
  color: #A6A6A6;
}

/* 卡片 — 暖白 + 柔和阴影，悬浮感 */
.card {
  background-color: var(--color-card);
  border-radius: 18rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 50, 30, 0.05), 0 8rpx 24rpx rgba(60, 50, 30, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:active {
  transform: translateY(2rpx) !important; /* !important：同 .hover，压过入场动画定格 */
  box-shadow: 0 1rpx 4rpx rgba(60, 50, 30, 0.05), 0 4rpx 12rpx rgba(60, 50, 30, 0.06);
}

/* ============ 签名原语：山乡巴士 · 站牌与车票 ============ */

/* 站牌头部：深绿实板 + 顶部落款横档 + 角落线路号角标 */
.signpost {
  position: relative;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  color: #ffffff;
  padding: 30rpx 32rpx 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx var(--color-primary-shadow);
  overflow: hidden;
}

.signpost::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 24rpx;
  right: 24rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 3rpx;
}

.signpost::after {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -20rpx;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.signpost-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #ffffff;
}

.signpost-sub {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: rgba(255,255,255,0.82);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.signpost-badge {
  position: absolute;
  top: 22rpx;
  right: 24rpx;
  z-index: 2;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  letter-spacing: 1rpx;
}

/* 车票卡：主券 + 右侧副券，虚线撕票口上下打孔——像一张真的汽车票 */
.ticket-card {
  position: relative;
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-m);
  box-shadow: var(--shadow-card);
  overflow: hidden; /* 配合打孔圆：探出卡片边缘的半圆被裁掉，留下缺口 */
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.ticket-card:active {
  transform: translateY(2rpx) !important; /* !important：同 .hover，压过入场动画定格 */
  box-shadow: 0 1rpx 4rpx rgba(60, 50, 30, 0.05), 0 4rpx 12rpx rgba(60, 50, 30, 0.06);
}

/* 主券：票面内容区 */
.ticket-card__main {
  flex: 1;
  min-width: 0;
  padding: 24rpx 28rpx;
}

/* 票号位：票面顶部的小字编号行（可选） */
.ticket-card__serial {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
}

/* 副券：右侧撕票联 */
.ticket-card__stub {
  position: relative;
  flex: none;
  width: 148rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 20rpx 12rpx;
  background: var(--color-card-warm); /* 副券略泛黄，与主券区分 */
  border-left: 2rpx dashed var(--color-line-deep); /* 撕票线 */
}

/* 撕票线两端的打孔缺口（车票的标志性特征） */
.ticket-card__stub::before,
.ticket-card__stub::after {
  content: '';
  position: absolute;
  left: -13rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--color-paper); /* 透出页底色，形成被撕掉的缺口 */
  box-shadow: inset 0 1rpx 3rpx rgba(60, 50, 30, 0.10);
}

.ticket-card__stub::before { top: -13rpx; }
.ticket-card__stub::after { bottom: -13rpx; }

/* 副券内容：大字 + 小标签（ETA、票价、检票口等） */
.ticket-card__stub-value {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--color-clay);
  line-height: 1.1;
}

.ticket-card__stub-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 山路线：虚线道路 + 站点圆点（时间线/进度用） */
.road-line {
  position: relative;
  height: 6rpx;
  margin: 24rpx 0;
  background: repeating-linear-gradient(90deg, var(--color-accent) 0, var(--color-accent) 12rpx, transparent 12rpx, transparent 20rpx);
  opacity: 0.7;
}

/* 弹性布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 文本 */
.text-green {
  color: var(--color-primary);
}

.text-orange {
  color: var(--color-clay);
}

.text-gray {
  color: var(--color-text-secondary);
}

.text-center {
  text-align: center;
}

/* 全局按压反馈：配合 hover-class 使用。
   微信原生 hover 即时生效（约50ms），比 :active + 长过渡更跟手；
   轻微缩小 + 降透明度，模拟"按下去"的触感。
   !important：压过入场动画（.anim-rise 等 fill-mode:both 的终帧定格），
   否则动画结束后按压反馈会被动画层级永久盖住 */
.hover {
  opacity: 0.82 !important;
  transform: scale(0.98) !important;
}

/* 按钮禁用态：表单提交中/不可用时置灰，去掉立体感 */
.btn-primary[disabled],
.btn-primary.disabled,
.btn-orange[disabled],
.btn-orange.disabled,
.btn-outline[disabled],
.btn-outline.disabled {
  opacity: 0.5;
  box-shadow: none;
  pointer-events: none;
  filter: saturate(0.4);
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 统一加载态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}
.elderly-mode .loading-state {
  font-size: 30rpx;
}

/* 全宽站牌头（页面顶部通栏版 signpost）：深绿渐变 + 落款横档 + 角落光晕。
   各页自行补 padding/内边距；.page-head 与 .page-header 为历史两种写法，样式一致 */
.page-head,
.page-header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
}

/* 顶部落款横档（站牌金属边） */
.page-head::before,
.page-header::before {
  content: '';
  position: absolute;
  top: 12rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

.page-head::before { left: 28rpx; right: 28rpx; }
.page-header::before { left: 30rpx; right: 30rpx; }

/* 角落装饰光晕 */
.page-head::after,
.page-header::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* ============ 动效原语：只用 transform/opacity，合成层友好 ============
   时长 200-400ms；缓动统一"出站缓动" cubic-bezier(0.22, 0.61, 0.36, 1)。
   页面直接挂类使用；列表项配 inline animation-delay 做阶梯入场。 */

/* 入场：卡片/列表项上浮淡入 */
@keyframes rise-in {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.anim-rise { animation: rise-in 0.35s cubic-bezier(0.22, 0.61, 0.36, 1) both; }

/* 弹出：对话框/成功车票，轻微过冲回弹 */
@keyframes pop-in {
  0%   { opacity: 0; transform: scale(0.88); }
  100% { opacity: 1; transform: scale(1); }
}
.anim-pop { animation: pop-in 0.32s cubic-bezier(0.34, 1.45, 0.64, 1) both; }

/* 半屏弹层：底部上滑；遮罩淡入 */
@keyframes sheet-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
.anim-sheet { animation: sheet-up 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both; }

@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
.anim-fade { animation: fade-in 0.22s ease-out both; }

/* 骨架屏：米纸色流光。空 view 挂 .skeleton，宽高由页面类给定 */
@keyframes shimmer {
  from { background-position: 200% 0; }
  to   { background-position: -200% 0; }
}
.skeleton {
  background: linear-gradient(90deg, var(--color-skeleton-a) 25%, var(--color-skeleton-b) 50%, var(--color-skeleton-a) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.3s linear infinite;
  border-radius: 8rpx;
}

/* 骨架卡：仿卡片轮廓的占位容器（内部放 .skeleton 条块） */
.skeleton-card {
  background: var(--color-card);
  border-radius: var(--radius-m);
  box-shadow: var(--shadow-card);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

/* 呼吸圆点：进行中状态（行驶中/待处理）。色取 currentColor */
@keyframes dot-breathe {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.4; transform: scale(0.8); }
}
.dot-live {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
  animation: dot-breathe 1.4s ease-in-out infinite;
}

/* ============ 老年人模式：全局字体放大 ============
   页面根节点挂 .elderly-mode 类后，以下规则比页面同级选择器
   优先级更高（多一层类），会覆盖页面样式中的字号 */
.elderly-mode .btn-primary,
.elderly-mode .btn-orange,
.elderly-mode .btn-outline {
  font-size: 38rpx;
  padding: 30rpx 40rpx;
}

.elderly-mode .input-label {
  font-size: 32rpx;
}

.elderly-mode .input-field {
  font-size: 34rpx;
  height: 96rpx;
}

.elderly-mode .card {
  padding: 34rpx;
}

.elderly-mode .ticket-card__stub-value {
  font-size: 46rpx;
}

.elderly-mode .ticket-card__stub-label,
.elderly-mode .ticket-card__serial {
  font-size: 26rpx;
}
