/* 商品详情页样式 */
.page-detail {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 自定义导航 */
.detail-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding-bottom: 16rpx;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 50%, var(--color-accent) 100%);
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-40%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 主图区 */
.detail-hero {
  margin: 20rpx 28rpx;
}

.hero-img {
  position: relative;
  height: 440rpx;
  background: var(--color-primary-light);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.hero-emoji {
  font-size: 180rpx;
  line-height: 1;
}

.hero-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: linear-gradient(135deg, #FF9800, #FFA726);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 信息卡 */
.info-card {
  margin: 0 28rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 12rpx;
}

.detail-price {
  font-size: 48rpx;
  font-weight: 800;
  color: #E53935;
}

.detail-unit {
  font-size: 26rpx;
  color: #757575;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.detail-meta {
  display: flex;
  gap: 32rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0F0F0;
}

.meta-item {
  font-size: 24rpx;
  color: #757575;
}

/* 商品介绍 */
.desc-card {
  margin: 0 28rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.desc-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  display: block;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  display: block;
}

/* 底部操作栏 */
.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.footer-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.cart-btn {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.buy-btn {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  color: #fff;
}

.safe-area-bottom {
  height: 20rpx;
}

/* ============ 老年人模式：详情页字体放大 ============ */
.elderly-mode .detail-price { font-size: 56rpx; }
.elderly-mode .detail-name { font-size: 42rpx; }
.elderly-mode .meta-item { font-size: 28rpx; }
.elderly-mode .desc-text { font-size: 30rpx; }
.elderly-mode .footer-btn { font-size: 34rpx; height: 100rpx; }
.elderly-mode .nav-title { font-size: 36rpx; }
