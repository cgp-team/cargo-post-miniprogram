/* 商品详情页样式 */
.page-detail {
  min-height: 100vh;
  background: var(--color-paper);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 自定义导航 */
.detail-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding-bottom: 16rpx;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 50%, var(--color-accent) 100%);
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-40%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* arrow 图标朝右，镜像翻转为返回方向 */
.nav-back-flip {
  transform: scaleX(-1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 主图区 */
.detail-hero {
  margin: 20rpx 28rpx;
}

.hero-img {
  position: relative;
  height: 440rpx;
  background: var(--color-primary-light);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.hero-img-real {
  width: 100%;
  height: 100%;
}

.hero-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: var(--color-clay);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 信息卡 */
.info-card {
  margin: 0 28rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 12rpx;
}

.detail-price {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-price);
}

.detail-unit {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.detail-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.detail-meta {
  display: flex;
  gap: 32rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0F0F0;
}

.meta-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.meta-flex {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

/* 商品介绍 */
.desc-card {
  margin: 0 28rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.desc-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  display: block;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  display: block;
}

/* 底部操作栏 */
.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.footer-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.cart-btn {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.buy-btn {
  background: var(--color-clay);
  color: #fff;
}

.safe-area-bottom {
  height: 20rpx;
}

/* 下单弹窗 */
.popup-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.popup-body {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 30rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  animation: popup-slide-up 0.25s ease;
}

@keyframes popup-slide-up {
  from { transform: translateY(40%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.popup-close {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  padding: 8rpx;
}

.popup-product {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.popup-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.popup-img image {
  width: 100%;
  height: 100%;
}

.popup-product-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.popup-product-name {
  font-size: 28rpx;
  color: #333;
}

.popup-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-price);
}

.popup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.popup-row-col {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.popup-label {
  font-size: 28rpx;
  color: #555;
}

.popup-input {
  flex: 1;
  margin-left: 24rpx;
  background: var(--color-paper);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.popup-row-col .popup-input {
  width: 100%;
  margin-left: 0;
  box-sizing: border-box;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-num {
  font-size: 32rpx;
  font-weight: 600;
  min-width: 60rpx;
  text-align: center;
}

.popup-total {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 12rpx;
  margin: 16rpx 0 24rpx;
}

.popup-total-amount {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-price);
}

.popup-submit {
  height: 92rpx;
  border-radius: 46rpx;
  background: var(--color-clay);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ============ 老年人模式：详情页字体放大 ============ */
.elderly-mode .detail-price { font-size: 56rpx; }
.elderly-mode .detail-name { font-size: 42rpx; }
.elderly-mode .meta-item { font-size: 28rpx; }
.elderly-mode .desc-text { font-size: 30rpx; }
.elderly-mode .footer-btn { font-size: 34rpx; height: 100rpx; }
.elderly-mode .nav-title { font-size: 36rpx; }
.elderly-mode .popup-title { font-size: 38rpx; }
.elderly-mode .popup-label { font-size: 32rpx; }
.elderly-mode .popup-input { font-size: 32rpx; }
.elderly-mode .popup-submit { font-size: 36rpx; height: 100rpx; }
