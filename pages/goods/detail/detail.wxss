/* 商品详情页样式 —— 大图区 + 价格焦点 + 产地胶囊 + 底部购买栏 */
.page-detail {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-primary-light) 6%, var(--color-paper) 22%);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 自定义导航：深绿站牌板 + 落款横档 + 装饰光晕 */
.detail-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding-bottom: 20rpx;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 60%, var(--color-primary-dark) 100%);
  overflow: hidden;
}

/* 顶部落款横档（站牌金属边） */
.detail-nav::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 30rpx;
  right: 30rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

.detail-nav::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-40%);
  z-index: 2;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* arrow 图标朝右，镜像翻转为返回方向 */
.nav-back-flip {
  transform: scaleX(-1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  position: relative;
  z-index: 1;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 主图区：圆角大卡，稻谷金浅底占位 */
.detail-hero {
  margin: 24rpx 28rpx;
}

.hero-img {
  position: relative;
  height: 460rpx;
  background: #FBF3DF;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.hero-img-real {
  width: 100%;
  height: 100%;
}

/* 巴士带货角标：稻谷金胶囊 */
.hero-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, var(--color-gold), #B98A2E);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(217, 164, 65, 0.35);
}

/* 信息卡：价格焦点 */
.info-card {
  margin: 0 28rpx 24rpx;
  background: #FFFDF8;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: var(--shadow-card);
}

.price-row {
  position: relative;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}

/* 价格下方的稻谷金落款线（农产品基调） */
.price-row::after {
  content: '';
  position: absolute;
  left: 2rpx;
  bottom: 0;
  width: 72rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, var(--color-gold), rgba(217, 164, 65, 0.2));
}

.detail-price {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--color-price);
  line-height: 1.1;
}

.detail-unit {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.detail-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-ink);
  display: block;
  margin-bottom: 18rpx;
  line-height: 1.4;
}

/* 产地/库存胶囊 */
.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.meta-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.meta-pill-gold {
  color: #8A6A1F;
  background: #FBF3DF;
  border: 1rpx solid rgba(217, 164, 65, 0.30);
}

.meta-pill-green {
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
}

/* 商品介绍 */
.desc-card {
  margin: 0 28rpx;
  background: #FFFDF8;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: var(--shadow-card);
}

.desc-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.desc-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}

.desc-text {
  font-size: 28rpx;
  color: var(--color-ink);
  line-height: 1.8;
  display: block;
}

/* 底部操作栏：悬浮购买栏（含安全区） */
.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFDF8;
  border-top: 1rpx solid #F0E8D5;
  box-shadow: 0 -4rpx 24rpx rgba(60, 50, 30, 0.06);
}

.footer-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.buy-btn {
  background: linear-gradient(135deg, var(--color-clay), #A64A1F);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(199, 91, 42, 0.28);
}

/* 下单弹窗 */
.popup-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.popup-body {
  width: 100%;
  background: #FFFDF8;
  border-radius: 28rpx 28rpx 0 0;
  padding: 30rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  /* 入场动画：全局 .anim-sheet（底部上滑） */
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.popup-close {
  font-size: 32rpx;
  color: var(--color-text-tertiary);
  padding: 8rpx;
}

.popup-product {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--color-paper);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.popup-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #FBF3DF;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.popup-img image {
  width: 100%;
  height: 100%;
}

.popup-product-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.popup-product-name {
  font-size: 28rpx;
  color: var(--color-ink);
}

.popup-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-price);
}

.popup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.popup-row-col {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.popup-label {
  font-size: 28rpx;
  color: var(--color-ink);
  font-weight: 500;
}

.popup-input {
  flex: 1;
  margin-left: 24rpx;
  background: var(--color-paper);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--color-ink);
}

.popup-row-col .popup-input {
  width: 100%;
  margin-left: 0;
  box-sizing: border-box;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-num {
  font-size: 32rpx;
  font-weight: 600;
  min-width: 60rpx;
  text-align: center;
}

.popup-total {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 12rpx;
  margin: 16rpx 0 24rpx;
  color: var(--color-text-secondary);
}

.popup-total-amount {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-price);
}

.popup-submit {
  height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--color-clay), #A64A1F);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(199, 91, 42, 0.28);
}

/* 骨架屏：主图占位块 + 信息卡轮廓条（尺寸仿真实卡片） */
.sk-hero {
  height: 460rpx;
  border-radius: 24rpx;
  margin: 24rpx 28rpx;
}
.detail-sk-card {
  margin: 0 28rpx 24rpx;
}
.sk-title { width: 55%; height: 32rpx; margin-bottom: 20rpx; }
.sk-line { width: 90%; height: 24rpx; margin-bottom: 16rpx; }
.sk-line-mid { width: 70%; }
.detail-sk-card .skeleton:last-child { margin-bottom: 0; }

/* ============ 老年人模式：详情页字体放大 ============ */
.elderly-mode .detail-price { font-size: 60rpx; }
.elderly-mode .detail-name { font-size: 42rpx; }
.elderly-mode .detail-unit { font-size: 30rpx; }
.elderly-mode .meta-pill { font-size: 26rpx; padding: 10rpx 24rpx; }
.elderly-mode .hero-badge { font-size: 26rpx; }
.elderly-mode .desc-title { font-size: 34rpx; }
.elderly-mode .desc-text { font-size: 32rpx; }
.elderly-mode .footer-btn { font-size: 34rpx; height: 100rpx; }
.elderly-mode .nav-title { font-size: 36rpx; }
.elderly-mode .popup-title { font-size: 38rpx; }
.elderly-mode .popup-label { font-size: 32rpx; }
.elderly-mode .popup-input { font-size: 32rpx; }
.elderly-mode .popup-submit { font-size: 36rpx; height: 100rpx; }
.elderly-mode .popup-product-name { font-size: 32rpx; }
.elderly-mode .popup-price { font-size: 34rpx; }
.elderly-mode .stepper-num { font-size: 36rpx; }
.elderly-mode .popup-total-amount { font-size: 46rpx; }
