/* 商城页样式 —— 山货集市：站牌头 + 稻谷金点缀的商品网格 */
.page-goods {
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-primary-light) 8%, var(--color-paper) 25%);
  min-height: 100vh;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

/* 顶部站牌栏：深绿实板 + 落款横档 + 装饰光晕 */
.top-bar {
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 60%, var(--color-primary-dark) 100%);
  padding: 20rpx 30rpx 40rpx;
  position: relative;
  overflow: hidden;
}

/* 顶部落款横档（站牌金属边） */
.top-bar::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 30rpx;
  right: 30rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

/* 顶部装饰光晕 */
.top-bar::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.top-bar-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.top-left {
  display: flex;
  flex-direction: column;
}

.location-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.village-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.arrow-down {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

/* 线路号 chip（站牌上的"商城"标识） */
.top-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  padding: 4rpx 14rpx;
  border-radius: 22rpx;
  letter-spacing: 1rpx;
}

.top-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

/* 文字头像：昵称缩进圆内显示，无昵称时用图标 */
.user-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 3rpx solid rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.user-avatar text {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  max-width: 62rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 分类标签：胶囊横滑，选中为深绿实板 */
.category-scroll {
  white-space: nowrap;
  padding: 24rpx 28rpx 20rpx;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-tag {
  display: inline-block;
  padding: 12rpx 30rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: #FFFDF8;
  border: 1rpx solid #EAE3D2;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 50, 30, 0.04);
  transition: all 0.15s ease;
}

.category-tag.active {
  color: #ffffff;
  background: var(--color-primary-dark);
  border-color: var(--color-primary-dark);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx var(--color-primary-shadow);
}

/* 商品网格：双列留白，呼吸感 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 4rpx 24rpx 0;
}

.product-card {
  background: #FFFDF8;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.product-card:active {
  transform: scale(0.97);
}

/* 图片位：稻谷金浅底占位，圆角随卡片裁切 */
.product-img-wrap {
  width: 100%;
  height: 300rpx;
  background: #FBF3DF;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.goods-img-real {
  width: 100%;
  height: 100%;
}

/* 巴士带货角标：稻谷金胶囊 */
.product-badge {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, var(--color-gold), #B98A2E);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(217, 164, 65, 0.35);
}

.product-info {
  padding: 18rpx 20rpx 22rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.product-from {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 12rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.product-price {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-price);
}

.product-unit {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ============ 动效：骨架双列卡 / 按压保底 ============ */
/* 骨架网格：与 .product-grid 同版式（双列、同间距同内边距） */
.sk-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 4rpx 24rpx 0;
}

/* 骨架商品卡：图片位通栏 + 标题/产地/价格条块，轮廓对齐 .product-card */
.sk-goods { padding: 0; margin-bottom: 0; overflow: hidden; }
.sk-goods-img { width: 100%; height: 300rpx; border-radius: 0; }
.sk-goods-body { padding: 18rpx 20rpx 22rpx; }
.sk-goods-title { width: 72%; height: 28rpx; margin-bottom: 14rpx; }
.sk-goods-sub { width: 48%; height: 20rpx; margin-bottom: 18rpx; }
.sk-goods-price { width: 40%; height: 32rpx; }

/* ============ 老年人模式：商城页字体放大 ============ */
.elderly-mode .village-name { font-size: 44rpx; }
.elderly-mode .top-badge { font-size: 24rpx; }
.elderly-mode .top-sub { font-size: 26rpx; }
.elderly-mode .user-avatar text { font-size: 30rpx; }
.elderly-mode .category-tag { font-size: 30rpx; padding: 16rpx 34rpx; }
.elderly-mode .product-name { font-size: 32rpx; }
.elderly-mode .product-from { font-size: 26rpx; }
.elderly-mode .product-price { font-size: 42rpx; }
.elderly-mode .product-unit { font-size: 26rpx; }
.elderly-mode .product-badge { font-size: 24rpx; }
