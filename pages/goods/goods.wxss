/* 商城页样式 */
.page-goods {
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-primary-light) 8%, #F5F5F5 25%);
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 顶部栏 */
.top-bar {
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 40%, var(--color-accent) 100%);
  padding: 20rpx 30rpx 28rpx;
}

.top-bar-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.location-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.loc-emoji { font-size: 32rpx; }

.village-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.arrow-down {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.user-avatar text {
  font-size: 40rpx;
}

/* 搜索栏 */
.search-bar {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.10);
  position: relative;
  z-index: 3;
}

.search-emoji {
  font-size: 36rpx;
  margin-right: 14rpx;
  opacity: 0.45;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 分类标签 */
.category-scroll {
  white-space: nowrap;
  padding: 20rpx 28rpx;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-tag {
  display: inline-block;
  padding: 14rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  transition: all 0.15s ease;
}

.category-tag.active {
  color: var(--color-on-primary);
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  box-shadow: 0 4rpx 14rpx rgba(46,125,50,0.3);
  font-weight: 600;
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  padding: 0 24rpx;
}

.product-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04), 0 6rpx 20rpx rgba(0,0,0,0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.product-card:active {
  transform: scale(0.97);
}

.product-img-wrap {
  width: 100%;
  height: 260rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.product-emoji {
  font-size: 100rpx;
}

.product-badge {
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  background: linear-gradient(135deg, #FF9800, #FFA726);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
}

.product-info {
  padding: 18rpx 20rpx 20rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.product-from {
  font-size: 22rpx;
  color: #757575;
  margin-bottom: 10rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.product-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #E53935;
}

.product-unit {
  font-size: 22rpx;
  color: #757575;
}

.safe-area-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ============ 老年人模式：商城页字体放大 ============ */
.elderly-mode .village-name { font-size: 38rpx; }
.elderly-mode .header-title { font-size: 40rpx; }
.elderly-mode .search-input { font-size: 32rpx; }
.elderly-mode .category-tag { font-size: 30rpx; padding: 18rpx 34rpx; }
.elderly-mode .product-name { font-size: 32rpx; }
.elderly-mode .product-from { font-size: 26rpx; }
.elderly-mode .product-price { font-size: 40rpx; }
.elderly-mode .product-unit { font-size: 26rpx; }
