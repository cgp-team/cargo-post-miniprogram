<!-- 商城页 - 买家界面 -->
<view class="page-goods {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- 顶部站牌栏：深绿实板 + 落款横档 -->
  <view class="top-bar" style="padding-top: {{statusBarHeight + 16}}px">
    <view class="top-bar-main">
      <view class="top-left">
        <view class="location-info" bindtap="switchVillage" hover-class="hover">
          <text class="village-name">{{currentVillage}}</text>
          <text class="arrow-down">▾</text>
          <text class="top-badge">商城</text>
        </view>
        <text class="top-sub">山货集市 · 村里直发</text>
      </view>
      <view class="user-avatar" bindtap="goToProfile" hover-class="hover">
        <text wx:if="{{userInfo.nickname}}">{{userInfo.nickname}}</text>
        <icon wx:else name="user" size="40" color="#FFFFFF" />
      </view>
    </view>
  </view>

  <!-- 分类标签（横滑胶囊） -->
  <scroll-view class="category-scroll" scroll-x>
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-tag {{activeCategory === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="switchCategory" hover-class="hover"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 加载中（首次加载）：骨架双列卡，轮廓对齐商品卡 -->
  <view wx:if="{{loading && !allProducts.length}}" class="sk-grid">
    <view class="skeleton-card sk-goods" wx:for="{{4}}" wx:key="*this">
      <view class="skeleton sk-goods-img"></view>
      <view class="sk-goods-body">
        <view class="skeleton sk-goods-title"></view>
        <view class="skeleton sk-goods-sub"></view>
        <view class="skeleton sk-goods-price"></view>
      </view>
    </view>
  </view>

  <!-- 空列表 -->
  <empty-state wx:elif="{{!loading && !products.length}}" icon="box" text="暂无上架商品" />

  <!-- 商品网格 -->
  <view wx:else class="product-grid">
    <view
      class="product-card anim-rise"
      wx:for="{{products}}"
      wx:key="id"
      style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms"
      bindtap="goToDetail" hover-class="hover"
      data-id="{{item.id}}"
    >
      <view class="product-img-wrap">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" class="goods-img-real" mode="aspectFill" lazy-load />
        <icon wx:else name="leaf" size="72" color="#D9A441" />
        <view wx:if="{{item.badge}}" class="product-badge">
          <icon name="bus" size="22" color="#FFFFFF" />
          <text>{{item.badge}}</text>
        </view>
      </view>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <view class="product-from">
          <icon name="pin" size="20" color="#D9A441" />
          <text>{{item.fromVillage}}</text>
        </view>
        <view class="product-price-row">
          <text class="product-price">¥{{item.price}}</text>
          <text class="product-unit">/{{item.unit}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 分页加载状态：列表末尾补一排骨架双列卡 -->
  <view class="sk-grid" wx:if="{{loading && allProducts.length}}">
    <view class="skeleton-card sk-goods" wx:for="{{2}}" wx:key="*this">
      <view class="skeleton sk-goods-img"></view>
      <view class="sk-goods-body">
        <view class="skeleton sk-goods-title"></view>
        <view class="skeleton sk-goods-sub"></view>
        <view class="skeleton sk-goods-price"></view>
      </view>
    </view>
  </view>
  <view class="loading-state" wx:elif="{{!hasMore && allProducts.length}}">没有更多了</view>

  <!-- 底部安全区 -->
  <view class="safe-area-bottom"></view>
</view>
