<!-- 商品溯源页 - 大巴承运轨迹 -->
<view class="page-trace {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">

  <block wx:if="{{trace}}">
    <!-- 承运信息卡：金绿渐变票头 + 状态胶囊 -->
    <view class="carrier-card anim-rise">
      <view class="carrier-head">
        <view class="carrier-title-wrap">
          <icon name="leaf" size="30" color="#D9A441" />
          <text class="carrier-title">{{trace.productName || '商品'}}溯源</text>
        </view>
        <text class="carrier-status">{{statusText || '—'}}</text>
      </view>
      <view class="carrier-row">
        <text class="carrier-label">承运车辆</text>
        <text class="carrier-value">{{trace.vehiclePlate || '待发车'}}</text>
      </view>
      <view class="carrier-row" wx:if="{{trace.driverName}}">
        <text class="carrier-label">承运司机</text>
        <text class="carrier-value">{{trace.driverName}}{{trace.driverMobile ? ' · ' + trace.driverMobile : ''}}</text>
      </view>
      <view class="carrier-row">
        <text class="carrier-label">班次</text>
        <text class="carrier-value">{{trace.shiftCode || '—'}}</text>
      </view>
      <view class="carrier-row">
        <text class="carrier-label">线路</text>
        <text class="carrier-value">{{trace.routeName || ((trace.startStation || '—') + ' → ' + (trace.endStation || '—'))}}</text>
      </view>
      <view class="carrier-row" wx:if="{{trace.receiverName || trace.receiverAddress}}">
        <text class="carrier-label">收货信息</text>
        <text class="carrier-value">{{trace.receiverName || ''}} {{trace.receiverMobile || ''}} {{trace.receiverAddress || ''}}</text>
      </view>
      <view class="carrier-row" wx:if="{{lastReportText}}">
        <text class="carrier-label">位置上报</text>
        <text class="carrier-value">{{lastReportText}}</text>
      </view>
    </view>

    <!-- 司机到站/交付提醒（司机端"确认到达/装车/妥投"后由后端回写） -->
    <view wx:if="{{arrivedText}}" class="arrival-banner {{trace.deliverTime ? 'done' : ''}} anim-rise" style="animation-delay: 80ms">
      <view class="arrival-icon">
        <icon wx:if="{{trace.deliverTime}}" name="check" size="32" color="#FFFFFF" />
        <icon wx:else name="notice" size="32" color="#FFFFFF" />
      </view>
      <text class="arrival-text">{{arrivedText}}</text>
    </view>

    <!-- 司机核验凭证（装车拍照 / 妥投拍照）：后台与用户端看同一份 -->
    <view wx:if="{{trace.loadPhotoUrl || trace.deliverPhotoUrl}}" class="proof-card">
      <view class="proof-title">
        <icon name="camera" size="28" color="{{iconDeep}}" />
        <text>司机核验凭证</text>
      </view>
      <view class="proof-row" wx:if="{{trace.loadPhotoUrl}}">
        <image class="proof-img" src="{{trace.loadPhotoUrl}}" mode="aspectFill" bindtap="previewProof" data-url="{{trace.loadPhotoUrl}}" hover-class="hover" />
        <view class="proof-meta">
          <text class="proof-label">装车核验</text>
          <text class="proof-time">{{loadTimeText || '—'}}</text>
        </view>
      </view>
      <view class="proof-row" wx:if="{{trace.deliverPhotoUrl}}">
        <image class="proof-img" src="{{trace.deliverPhotoUrl}}" mode="aspectFill" bindtap="previewProof" data-url="{{trace.deliverPhotoUrl}}" hover-class="hover" />
        <view class="proof-meta">
          <text class="proof-label">妥投凭证</text>
          <text class="proof-time">{{deliverTimeText || '—'}}</text>
        </view>
      </view>
    </view>

    <!-- 订单二维码：司机扫码装车 / 妥投（票根式，带撕票线） -->
    <view class="order-qr-card" wx:if="{{trace.orderNo}}">
      <canvas type="2d" id="mallOrderQr" class="order-qr-canvas"></canvas>
      <text class="order-qr-no" bindlongpress="copyOrderNo">{{trace.orderNo}}</text>
      <view class="order-qr-divider"></view>
      <text class="order-qr-tip">司机扫码装车 / 妥投核验</text>
    </view>

    <!-- 轨迹地图 -->
    <view class="map-wrap">
      <map
        id="traceMap"
        class="trace-map"
        longitude="{{mapCenter.lng}}"
        latitude="{{mapCenter.lat}}"
        scale="{{mapScale}}"
        markers="{{markers}}"
        polyline="{{polyline}}"
        include-points="{{trackPoints}}"
        show-location
      ></map>
      <view class="map-legend">
        <text class="legend-line solid"></text><text class="legend-text">已行驶</text>
        <text class="legend-line dotted"></text><text class="legend-text">计划线路</text>
      </view>
    </view>

    <!-- 途经站点：竖向时间线（圆点 + 虚线山路 + 当前站高亮） -->
    <view class="stops-card" wx:if="{{stops.length}}">
      <view class="stops-title">
        <icon name="road" size="30" color="{{iconDeep}}" />
        <text>途经站点</text>
      </view>
      <view
        class="stop-item {{item.isPassed ? 'passed' : ''}} {{item.isCurrent ? 'current' : ''}} anim-rise"
        style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms"
        wx:for="{{stops}}"
        wx:key="sequenceNo"
      >
        <view class="stop-rail">
          <view class="stop-dot">
            <icon wx:if="{{item.isPassed}}" name="check" size="20" color="#FFFFFF" />
            <text wx:else>{{item.sequenceNo}}</text>
          </view>
          <view wx:if="{{index < stops.length - 1}}" class="stop-line"></view>
        </view>
        <view class="stop-body">
          <view class="stop-head">
            <text class="stop-name">{{item.stationName}}</text>
            <text class="stop-min">+{{item.plannedMinutes}}分钟</text>
          </view>
          <view class="stop-tags" wx:if="{{item.isCurrent || index === 0 || index === stops.length - 1}}">
            <text wx:if="{{item.isCurrent}}" class="stop-tag-current">当前位置</text>
            <text wx:if="{{index === 0}}" class="stop-side">起点站</text>
            <text wx:elif="{{index === stops.length - 1}}" class="stop-side">终点站</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 加载态：骨架屏（承运卡 + 地图 + 时间线轮廓） -->
  <view wx:elif="{{loading}}">
    <view class="skeleton-card trace-sk-card">
      <view class="skeleton sk-title"></view>
      <view class="skeleton sk-line"></view>
      <view class="skeleton sk-line sk-line-mid"></view>
    </view>
    <view class="skeleton trace-sk-map"></view>
    <view class="skeleton-card trace-sk-card">
      <view class="skeleton sk-title"></view>
      <view class="skeleton sk-line"></view>
      <view class="skeleton sk-line"></view>
      <view class="skeleton sk-line sk-line-mid"></view>
    </view>
  </view>

  <!-- 加载失败：弱网常见，给重新加载入口 -->
  <empty-state
    wx:elif="{{!loading && loadError}}"
    icon="notice" text="包裹轨迹暂时打不开" subText="网络不太好，请稍后再试"
    btnText="重新加载" bind:tapbtn="loadTrace"
  />

  <!-- 空态：未发货或无轨迹 -->
  <empty-state wx:elif="{{!loading}}" emoji="🗺️" text="商品还未发车，暂无运输轨迹" subText="发货后这里会展示大巴的实时轨迹" />

  <view class="safe-area-bottom"></view>
</view>
