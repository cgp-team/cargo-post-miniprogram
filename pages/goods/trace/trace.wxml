<!-- 商品溯源页 - 大巴承运轨迹 -->
<view class="page-trace {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">

  <block wx:if="{{trace}}">
    <!-- 承运信息卡 -->
    <view class="carrier-card">
      <view class="carrier-title">🌾 {{trace.productName || '商品'}}溯源</view>
      <view class="carrier-row">
        <text class="carrier-label">承运车辆</text>
        <text class="carrier-value">{{trace.vehiclePlate || '待发车'}}</text>
      </view>
      <view class="carrier-row">
        <text class="carrier-label">班次</text>
        <text class="carrier-value">{{trace.shiftCode || '—'}}</text>
      </view>
      <view class="carrier-row">
        <text class="carrier-label">线路</text>
        <text class="carrier-value">{{trace.routeName || ((trace.startStation || '—') + ' → ' + (trace.endStation || '—'))}}</text>
      </view>
      <view class="carrier-row" wx:if="{{lastReportText}}">
        <text class="carrier-label">位置上报</text>
        <text class="carrier-value">{{lastReportText}}</text>
      </view>
    </view>

    <!-- 轨迹地图 -->
    <view class="map-wrap">
      <map
        id="traceMap"
        class="trace-map"
        longitude="{{mapCenter.lng}}"
        latitude="{{mapCenter.lat}}"
        scale="{{mapScale}}"
        markers="{{markers}}"
        polyline="{{polyline}}"
        include-points="{{trackPoints}}"
        show-location
      ></map>
      <view class="map-legend">
        <text class="legend-line solid"></text><text class="legend-text">已行驶</text>
        <text class="legend-line dotted"></text><text class="legend-text">计划线路</text>
      </view>
    </view>

    <!-- 途经站点 -->
    <view class="stops-card" wx:if="{{stops.length}}">
      <view class="stops-title">🚏 途经站点</view>
      <view class="stop-item" wx:for="{{stops}}" wx:key="sequenceNo">
        <view class="stop-dot"></view>
        <text class="stop-name">{{item.stationName}}</text>
        <text class="stop-min">+{{item.plannedMinutes}}分钟</text>
      </view>
    </view>
  </block>

  <!-- 加载态 -->
  <view wx:elif="{{loading}}" class="loading-state">加载中…</view>

  <!-- 空态：未发货或无轨迹 -->
  <empty-state wx:elif="{{!loading}}" emoji="🗺️" text="商品还未发车，暂无运输轨迹" subText="发货后这里会展示大巴的实时轨迹" />

  <view class="safe-area-bottom"></view>
</view>
