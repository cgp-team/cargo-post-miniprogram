/* 商品溯源页 */
.page-trace {
  min-height: 100vh;
  background: var(--color-paper);
  padding-bottom: 40rpx;
}

.carrier-card {
  margin: 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
}
.carrier-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}
.carrier-row {
  display: flex;
  padding: 8rpx 0;
  font-size: 26rpx;
}
.carrier-label {
  width: 140rpx;
  color: #999;
  flex-shrink: 0;
}
.carrier-value {
  flex: 1;
  color: #333;
  font-weight: 500;
}

.map-wrap {
  margin: 0 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}
.trace-map {
  width: 100%;
  height: 560rpx;
}
.map-legend {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 12rpx;
  padding: 10rpx 18rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #666;
}
.legend-line {
  display: inline-block;
  width: 40rpx;
  height: 6rpx;
  margin-right: 10rpx;
  vertical-align: middle;
}
.legend-line.solid { background: #2E7D32; }
.legend-line.dotted { background: repeating-linear-gradient(90deg, #9E9E9E 0, #9E9E9E 8rpx, transparent 8rpx, transparent 16rpx); }
.legend-text { margin-right: 20rpx; }
.legend-text:last-child { margin-right: 0; }

.stops-card {
  margin: 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
}
.stops-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}
.stop-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.stop-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.stop-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.stop-min {
  font-size: 24rpx;
  color: #999;
}

/* 司机到站/交付提醒：到达橙红、已送达绿 */
.arrival-banner {
  margin: 0 24rpx 20rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 16rpx;
  background: #C0392B;
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
}
.arrival-banner.done {
  background: var(--color-primary);
}
.arrival-icon {
  font-size: 32rpx;
}
.arrival-text {
  flex: 1;
  color: #fff;
}

/* 司机核验凭证（装车/妥投照片） */
.proof-card {
  margin: 0 24rpx 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.proof-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.proof-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.proof-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #F2F2F2;
}
.proof-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.proof-label {
  font-size: 27rpx;
  color: #333;
  font-weight: 600;
}
.proof-time {
  font-size: 24rpx;
  color: #999;
}

/* 订单二维码：司机扫码装车/妥投 */
.order-qr-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.order-qr-canvas {
  width: 320rpx;
  height: 320rpx;
}
.order-qr-no {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.order-qr-tip {
  font-size: 24rpx;
  color: #999;
}

/* 老年人模式 */
.elderly-mode .carrier-title { font-size: 36rpx; }
.elderly-mode .carrier-row { font-size: 30rpx; }
.elderly-mode .stop-name { font-size: 32rpx; }
.elderly-mode .stop-min { font-size: 28rpx; }
