/* 登录页面样式 - 农村客货邮小程序 */
.login-page {
  min-height: 100vh;
  background: var(--color-paper);
  box-sizing: border-box;
}

/* 品牌站牌头：深绿渐变实板，与默认导航栏同色系衔接 */
.login-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 65%, var(--color-primary-dark) 100%);
  padding: 56rpx 40rpx 150rpx;
  border-radius: 0 0 36rpx 36rpx;
  text-align: center;
}

/* 站牌顶部落款横档 */
.login-hero::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 32rpx;
  right: 32rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

/* 角落装饰光晕 */
.login-hero::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* 站牌徽章：磨砂白圆角板 + 白色巴士图标 */
.hero-badge {
  position: relative;
  z-index: 1;
  width: 116rpx;
  height: 116rpx;
  margin: 0 auto 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.16);
}

.hero-title {
  position: relative;
  z-index: 1;
  font-size: 46rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.hero-sub {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 3rpx;
}

/* 业务胶囊：公交带货 / 快递进村 / 农产品出山 */
.hero-pills {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 30rpx;
}

.hero-pill {
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

/* 表单卡：上浮叠进站牌下缘 */
.form-section {
  position: relative;
  z-index: 2;
  margin: -110rpx 30rpx 0;
  padding: 44rpx 36rpx 40rpx;
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-float);
}

/* 输入组 */
.login-page .input-group {
  margin-bottom: 32rpx;
}

/* 标签行：小绿柱 + 墨字标签 */
.input-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.input-label-row::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--color-primary), var(--color-accent));
}

.login-page .input-label {
  margin: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.login-page .input-field {
  width: 100%;
  height: 96rpx;
  border: 2rpx solid #E4DECD;
  border-radius: 14rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--color-ink);
  background-color: #FBF8F1;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.login-page .input-field:focus {
  border-color: var(--color-accent);
  background-color: #fff;
  box-shadow: 0 0 0 6rpx var(--color-primary-shadow);
}

.login-page .input-field::placeholder {
  color: var(--color-text-tertiary);
}

/* 短信验证码行 */
.sms-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sms-field {
  flex: 1;
}

/* 发送验证码：主题浅绿胶囊 */
.sms-btn {
  flex: none;
  width: 200rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  font-size: 26rpx;
  font-weight: 600;
  background: var(--color-primary-light);
  color: var(--color-primary);
  border: none;
  border-radius: var(--radius-pill);
  text-align: center;
}

.sms-btn.disabled {
  background: #EFEAE0;
  color: var(--color-text-tertiary);
}

/* 测试验证码提示：稻谷金告示条 */
.sms-tip {
  margin: -12rpx 0 4rpx;
  padding: 12rpx 20rpx;
  background: #FBF3DF;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #8A6A1F;
  text-align: center;
}

/* 主登录按钮：站牌式实板放大 */
.login-btn {
  margin-top: 40rpx;
  height: 104rpx;
  line-height: 104rpx;
  font-size: 36rpx;
}

.login-btn[loading] {
  opacity: 0.8;
}

/* 切换登录方式 */
.switch-mode {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 28rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-primary);
}

/* 分隔：其他登录方式 */
.login-divider {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #E4DECD;
}

.divider-text {
  margin: 0 20rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 微信一键登录：白底绿边次级按钮 */
.wechat-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  height: 96rpx;
  background: #FFFDF8;
  border: 2rpx solid var(--color-accent);
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.wechat-login-btn:active {
  background: var(--color-primary-light);
}

/* 去掉微信 button 默认描边 */
.login-btn::after,
.sms-btn::after,
.wechat-login-btn::after {
  border: none;
}

/* 大字模式入口 */
.elderly-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 26rpx 0 18rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* 协议说明 */
.agreement {
  padding: 12rpx 60rpx calc(48rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ============ 老年人模式：登录页字体放大 ============ */
.elderly-mode .hero-title { font-size: 54rpx; }
.elderly-mode .hero-sub { font-size: 28rpx; }
.elderly-mode .hero-pill { font-size: 24rpx; padding: 8rpx 22rpx; }
.elderly-mode .login-page .input-label { font-size: 32rpx; }
.elderly-mode .login-page .input-field { font-size: 34rpx; height: 104rpx; }
.elderly-mode .login-btn { font-size: 40rpx; }
.elderly-mode .wechat-login-btn { font-size: 34rpx; }
.elderly-mode .sms-btn { font-size: 30rpx; width: 220rpx; }
.elderly-mode .sms-tip { font-size: 28rpx; }
.elderly-mode .switch-mode { font-size: 32rpx; padding: 26rpx 0; }
.elderly-mode .divider-text { font-size: 26rpx; }
.elderly-mode .elderly-entry { font-size: 32rpx; padding: 32rpx 0 26rpx; }
.elderly-mode .agreement { font-size: 26rpx; }
