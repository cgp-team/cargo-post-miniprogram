/* 登录页面样式 - 农村客货邮小程序 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-primary-light) 35%, #F5F5F5 70%);
  padding: 0 40rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.login-page::before {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(76,175,80,0.12) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.login-page::after {
  content: '';
  position: absolute;
  bottom: 200rpx;
  left: -100rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(129,199,132,0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
  padding-top: 100rpx;
  position: relative;
  z-index: 1;
}

.logo-img-wrap {
  position: relative;
  margin-bottom: 24rpx;
}

.logo-placeholder {
  width: 150rpx;
  height: 150rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary), var(--color-accent));
  font-size: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(46,125,50,0.25);
  position: relative;
  z-index: 1;
}

.logo-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  width: 166rpx;
  height: 166rpx;
  border-radius: 36rpx;
  border: 3rpx dashed rgba(76,175,80,0.25);
  animation: ringRotate 20s linear infinite;
}

@keyframes ringRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.logo-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1B5E20;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.logo-desc {
  font-size: 26rpx;
  color: #4E7A56;
  letter-spacing: 1rpx;
}

/* 角色切换 */
.role-switch {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 1;
}

.role-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #999;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.role-tab.active {
  background: linear-gradient(135deg, #2E7D32, #388E3C, #43A047);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(46,125,50,0.3);
  transform: scale(1.02);
}

.role-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 10rpx;
  transition: all 0.15s ease;
}

.role-tab.active .role-icon {
  filter: brightness(0) invert(1);
}

/* 表单卡片 */
.form-section {
  padding: 48rpx 36rpx;
  position: relative;
  z-index: 1;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.07);
}

/* 输入组 */
.login-page .input-group {
  margin-bottom: 32rpx;
}

.login-page .input-label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 14rpx;
  display: block;
  font-weight: 500;
}

.login-page .input-field {
  width: 100%;
  height: 96rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  background-color: #F8FAF8;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.login-page .input-field:focus {
  border-color: var(--color-accent);
  background-color: #fff;
  box-shadow: 0 0 0 6rpx rgba(76, 175, 80, 0.08);
}

.login-page .input-field::placeholder {
  color: #A6A6A6;
}

/* 登录按钮 */
.login-btn {
  margin-top: 44rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: var(--color-on-primary);
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  transition: all 0.15s ease;
}

.login-btn:active {
  background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.14);
  transform: scale(0.98);
}

.login-btn[loading] {
  opacity: 0.8;
}

/* 微信登录按钮 */
.wechat-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  height: 100rpx;
  background: #ffffff;
  border: 2rpx solid #E8ECEE;
  border-radius: 50rpx;
  font-size: 30rpx;
  color: #333;
  letter-spacing: 1rpx;
  transition: all 0.15s ease;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.wechat-login-btn:active {
  background: #F5F5F5;
  border-color: var(--color-accent);
}

.wechat-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 14rpx;
}

/* 图标行 */
.input-label-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  gap: 8rpx;
}

.input-icon {
  font-size: 30rpx;
}

.role-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.04);
  transition: all 0.15s ease;
}

.role-tab.active .role-icon-wrap {
  background: rgba(255,255,255,0.2);
}

.role-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.wechat-emoji {
  font-size: 36rpx;
  margin-right: 12rpx;
}

/* 注册入口 */
.register-link {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  gap: 8rpx;
  padding-bottom: 10rpx;
}

.register-link .text-green {
  font-weight: 600;
}

/* 短信验证码行 */
.sms-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sms-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sms-field {
  flex: 1;
}

.sms-btn {
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  background: #fff;
  border: 2rpx solid var(--color-accent);
  color: var(--color-primary);
  border-radius: 36rpx;
  padding: 0;
  text-align: center;
}

.sms-btn.disabled {
  border-color: #BDBDBD;
  color: #BDBDBD;
}

.sms-tip {
  text-align: center;
  font-size: 24rpx;
  color: #757575;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
}

/* 切换登录方式 */
.switch-mode {
  text-align: center;
  font-size: 28rpx;
  color: var(--color-primary);
  margin-top: 24rpx;
  text-decoration: underline;
}

/* 卡片通用样式 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.07);
}

/* ============ 老年人模式：登录页字体放大 ============ */
.elderly-mode .logo-title { font-size: 56rpx; }
.elderly-mode .logo-desc { font-size: 30rpx; }
.elderly-mode .login-page .input-label { font-size: 32rpx; }
.elderly-mode .login-page .input-field { font-size: 34rpx; height: 104rpx; }
.elderly-mode .login-btn { font-size: 40rpx; }
.elderly-mode .wechat-login-btn { font-size: 34rpx; }
.elderly-mode .sms-btn { font-size: 30rpx; width: 220rpx; }
.elderly-mode .switch-mode { font-size: 32rpx; }
.elderly-mode .register-link { font-size: 32rpx; }
