<!-- 登录页面 - 农村客货邮小程序 -->
<view class="login-page {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- 品牌站牌头：深绿渐变实板，与默认导航栏同色系衔接 -->
  <view class="login-hero">
    <view class="hero-badge">
      <icon name="bus" size="64" color="#FFFFFF" />
    </view>
    <text class="hero-title">农村客货邮</text>
    <text class="hero-sub">客货邮 · 城乡直达</text>
    <view class="hero-pills">
      <text class="hero-pill">公交带货</text>
      <text class="hero-pill">快递进村</text>
      <text class="hero-pill">农产品出山</text>
    </view>
  </view>

  <!-- 登录表单卡：上浮叠进站牌下缘 -->
  <view class="form-section card">
    <!-- 手机号 -->
    <view class="input-group">
      <view class="input-label-row">
        <text class="input-label">手机号码</text>
      </view>
      <input
        class="input-field"
        type="number"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>

    <!-- 短信验证码模式 -->
    <block wx:if="{{loginMode === 'sms'}}">
      <view class="input-group">
        <view class="input-label-row">
          <text class="input-label">验证码</text>
        </view>
        <view class="sms-input-wrap">
          <input
            class="input-field sms-field"
            type="number"
            placeholder="验证码"
            value="{{smsCode}}"
            bindinput="onSmsCodeInput"
            maxlength="6"
          />
          <button
            class="sms-btn {{smsCountdown > 0 ? 'disabled' : ''}}"
            bindtap="handleSendSms" hover-class="hover"
            disabled="{{smsCountdown > 0 || smsCodeSending}}"
          >
            {{smsCountdown > 0 ? smsCountdown + 's' : '发送验证码'}}
          </button>
        </view>
      </view>
      <view class="sms-tip" wx:if="{{showSmsTip}}">测试环境固定验证码：9999</view>
    </block>

    <!-- 密码模式 -->
    <block wx:else>
      <view class="input-group">
        <view class="input-label-row">
          <text class="input-label">登录密码</text>
        </view>
        <input
          class="input-field"
          type="password"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
    </block>

    <!-- 登录按钮 -->
    <button
      class="btn-primary login-btn"
      bindtap="handleLogin" hover-class="hover"
      loading="{{loading}}"
    >
      {{loginMode === 'sms' ? '验证码登录' : '密码登录'}}
    </button>

    <!-- 切换登录方式 -->
    <view class="switch-mode" bindtap="switchMode" hover-class="hover">
      <text>{{loginMode === 'sms' ? '密码登录' : '验证码登录'}}</text>
      <icon name="arrow" size="24" color="{{iconColor}}" />
    </view>

    <!-- 其他登录方式 -->
    <view class="login-divider">
      <view class="divider-line"></view>
      <text class="divider-text">其他登录方式</text>
      <view class="divider-line"></view>
    </view>

    <!-- 微信一键登录（手机号快捷验证） -->
    <button class="wechat-login-btn" open-type="getPhoneNumber" bindgetphonenumber="onWechatPhoneNumber" hover-class="none">
      <text>微信一键登录</text>
    </button>
  </view>

  <!-- 大字模式入口 -->
  <view class="elderly-entry" bindtap="toggleElderly" hover-class="hover">
    <icon name="font" size="28" color="#8A8778" />
    <text>大字模式：{{elderlyMode ? '已开启' : '已关闭'}}</text>
  </view>

  <!-- 协议说明 -->
  <view class="agreement">登录即表示同意《用户协议》与《隐私政策》</view>
</view>
