<!-- 登录页面 - 农村客货邮小程序 -->
<view class="login-page {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo-img-wrap">
      <view class="logo-placeholder">🚐</view>
      <view class="logo-ring"></view>
    </view>
    <text class="logo-title">农村客货邮</text>
    <text class="logo-desc">公交带货 · 快递进村 · 农产品出山</text>
  </view>

  <!-- 登录表单 -->
  <view class="form-section card">
    <!-- 手机号 -->
    <view class="input-group">
      <view class="input-label-row">
        <text class="input-icon">📱</text>
        <text class="input-label">手机号码</text>
      </view>
      <input
        class="input-field"
        type="number"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>

    <!-- 短信验证码模式 -->
    <block wx:if="{{loginMode === 'sms'}}">
      <view class="input-group sms-row">
        <view class="input-label-row">
          <text class="input-icon">✉️</text>
          <text class="input-label">验证码</text>
        </view>
        <view class="sms-input-wrap">
          <input
            class="input-field sms-field"
            type="number"
            placeholder="验证码"
            value="{{smsCode}}"
            bindinput="onSmsCodeInput"
            maxlength="6"
          />
          <button
            class="sms-btn {{smsCountdown > 0 ? 'disabled' : ''}}"
            bindtap="handleSendSms" hover-class="hover"
            disabled="{{smsCountdown > 0 || smsCodeSending}}"
          >
            {{smsCountdown > 0 ? smsCountdown + 's' : '发送验证码'}}
          </button>
        </view>
      </view>
      <view class="sms-tip">测试环境固定验证码：9999</view>
    </block>

    <!-- 密码模式 -->
    <block wx:else>
      <view class="input-group">
        <view class="input-label-row">
          <text class="input-icon">🔒</text>
          <text class="input-label">登录密码</text>
        </view>
        <input
          class="input-field"
          type="password"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
    </block>

    <!-- 登录按钮 -->
    <button
      class="btn-primary login-btn"
      bindtap="{{loginMode === 'sms' ? 'handleSmsLogin' : 'handlePasswordLogin'}}" hover-class="hover"
      loading="{{loading}}"
    >
      {{loginMode === 'sms' ? '验证码登录' : '密码登录'}}
    </button>

    <!-- 切换登录方式 -->
    <view class="switch-mode" bindtap="switchMode" hover-class="hover">
      <text>{{loginMode === 'sms' ? '密码登录' : '验证码登录'}}</text>
    </view>

    <!-- 微信一键登录（手机号快捷验证） -->
    <button class="wechat-login-btn" open-type="getPhoneNumber" bindgetphonenumber="onWechatPhoneNumber" hover-class="none">
      <text class="wechat-emoji">💬</text>
      <text>微信一键登录</text>
    </button>

    <!-- 注册提示 -->
    <view class="register-link" bindtap="goToRegister" hover-class="hover">
      <text class="text-gray">首次使用？短信登录即自动注册</text>
    </view>
  </view>
</view>
