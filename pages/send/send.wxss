/* 寄货页样式 */
.page-send {
  min-height: 100vh;
  background: var(--color-paper);
  padding: 24rpx;
}

.step-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.step-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  margin-bottom: 30rpx;
}

.step-num {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: var(--color-on-primary);
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 表单 */
.form-group { margin-bottom: 26rpx; }

.form-label {
  display: block;
  font-size: 28rpx;
  color: #555;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background: #F8FAF8;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--color-accent);
  background: #fff;
}

.flex-1 { flex: 1; }

.weight-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.weight-unit {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

/* 货物类型选择器（与输入框同视觉） */
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  background: #F8FAF8;
  box-sizing: border-box;
}

.picker-arrow {
  font-size: 26rpx;
  color: #999;
}

/* 体积：长 × 宽 × 高（cm） */
.size-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.size-input {
  flex: 1;
  min-width: 0;
  padding: 0 12rpx;
  text-align: center;
}

.size-x {
  font-size: 28rpx;
  color: #999;
}

.form-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A8778;
}

/* 生鲜/冷链开关行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.switch-text {
  display: flex;
  flex-direction: column;
}

.switch-text .form-label { margin-bottom: 6rpx; }

/* 需客户送站：就近交接站点 + 导航按钮 */
.pickup-mode-row {
  display: flex;
  gap: 16rpx;
}

.mode-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 14rpx;
  border: 2rpx solid #E8ECEE;
  background: #F8FAF8;
  font-size: 27rpx;
  color: #555;
}

.mode-btn.active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-weight: 600;
}

/* 可达性评估卡片：warn=车辆无法直接进入（推荐送站） */
.reach-card {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #F8FAF8;
  font-size: 25rpx;
  color: #555;
}

.reach-card.ok {
  background: var(--color-primary-light);
}

.reach-card.warn {
  background: #F8ECE3;
}

.reach-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  margin-bottom: 8rpx;
}

.reach-line {
  display: block;
  margin-top: 4rpx;
  font-size: 25rpx;
  color: #555;
}

.reach-reason {
  color: #8A8778;
}

.reach-btn {
  margin-top: 14rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--color-clay);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.pickup-summary {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #F8FAF8;
}

.pickup-summary-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

.review-station {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #F8ECE3;
}

.review-station-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-clay);
  font-weight: 600;
}

.review-station-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-clay);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #F8FAF8;
  box-sizing: border-box;
}

.send-btn {
  margin-top: 20rpx;
  width: 100%;
}

/* 拍照区 */
.photo-area {
  width: 100%;
  height: 480rpx;
  border-radius: 20rpx;
  background: #F8FAF8;
  border: 3rpx dashed var(--color-accent);
  overflow: hidden;
  margin-bottom: 30rpx;
  transition: all 0.15s ease;
}

.photo-area:active { background: var(--color-primary-light); }

.photo-preview {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-camera { margin-bottom: 16rpx; }
.photo-hint { font-size: 30rpx; color: #333; font-weight: 600; margin-bottom: 8rpx; }
.photo-sub { font-size: 24rpx; color: #757575; }

/* 信息确认 */
.info-summary {
  background: #F8FAF8;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E8ECEE;
}
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #757575; }
.info-value { font-size: 28rpx; color: #333; font-weight: 600; }

/* 按钮组 */
.step-actions {
  display: flex;
  gap: 20rpx;
}

.step-actions .btn-outline { flex: 1; }
.step-actions .btn-primary { flex: 1.5; }

/* ====== 匹配成功 ====== */
.match-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.match-emoji { margin-bottom: 16rpx; }
.match-title { font-size: 38rpx; font-weight: 700; color: var(--color-primary); margin-bottom: 30rpx; }

.match-bus-card {
  width: 100%;
  background: var(--color-primary-light);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
}

.bus-detail { font-size: 26rpx; color: #666; display: block; margin-bottom: 24rpx; }

/* 温馨提示 */
.match-reminder {
  width: 100%;
  background: #FFF8E1;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  text-align: left;
  margin-bottom: 28rpx;
}

.reminder-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-clay);
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.reminder-text {
  font-size: 24rpx;
  color: #666;
  display: block;
  line-height: 1.6;
}

.step-actions .btn-primary { flex: none; width: 100%; }

/* 路线预估（点击"下一步"后展示：loading / 成功 / 失败重试） */
.route-preview {
  margin-top: -6rpx;
  margin-bottom: 26rpx;
  background: var(--color-primary-light);
  border-radius: 16rpx;
  padding: 24rpx;
}
.route-preview-error {
  background: #FFF8E1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.rp-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.rp-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
.rp-value {
  font-size: 30rpx;
  color: var(--color-ink);
  font-weight: 700;
}
.rp-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}
.rp-warn {
  font-size: 22rpx;
  color: var(--color-status-warn);
  display: block;
  margin-top: 8rpx;
}
.rp-retry {
  padding: 14rpx 44rpx;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: 999rpx;
  font-size: 26rpx;
}

/* 适老：路线预估 */
.elderly-mode .rp-label { font-size: 32rpx; }
.elderly-mode .rp-value { font-size: 34rpx; }
.elderly-mode .rp-text { font-size: 30rpx; }
.elderly-mode .rp-retry { font-size: 30rpx; padding: 18rpx 52rpx; }

/* 收货信息 */
.receiver-section {
  margin-bottom: 28rpx;
  border-top: 1rpx dashed #E8ECEE;
  padding-top: 24rpx;
}

.receiver-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  display: block;
  margin-bottom: 20rpx;
}

.receiver-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.receiver-head .receiver-title {
  margin-bottom: 0;
}
.receiver-addr-book {
  font-size: 26rpx;
  color: var(--color-primary);
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 提交成功 - 订单号 */
.order-no-display {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  word-break: break-all;
  display: block;
  text-align: center;
  margin-bottom: 10rpx;
}

/* 订单二维码（取件/司机扫码） */
.qr-canvas {
  width: 320rpx;
  height: 320rpx;
  margin: 0 auto 20rpx;
  background: #fff;
  border-radius: 16rpx;
  display: block;
}
.qr-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
}
.qr-btn {
  flex: 0 0 auto;
  min-width: 180rpx;
  margin: 0;
  padding: 16rpx 0;
  font-size: 28rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  background: #fff;
  text-align: center;
}
.qr-btn::after { border: none; }
.elderly-mode .qr-canvas { width: 400rpx; height: 400rpx; }
.elderly-mode .qr-btn { font-size: 32rpx; padding: 20rpx 0; min-width: 220rpx; }

/* ============ 老年人模式：寄货页字体放大 ============ */
.elderly-mode .step-title { font-size: 40rpx; }
.elderly-mode .form-label { font-size: 32rpx; }
.elderly-mode .form-input { font-size: 34rpx; height: 100rpx; }
.elderly-mode .picker-value { font-size: 34rpx; height: 100rpx; }
.elderly-mode .form-hint { font-size: 28rpx; }
.elderly-mode .form-textarea { font-size: 32rpx; }
.elderly-mode .photo-hint { font-size: 36rpx; }
.elderly-mode .photo-sub { font-size: 28rpx; }
.elderly-mode .match-title { font-size: 44rpx; }
.elderly-mode .bus-detail { font-size: 30rpx; }
.elderly-mode .reminder-text { font-size: 28rpx; }
.elderly-mode .weight-unit { font-size: 36rpx; }
.elderly-mode .info-label { font-size: 32rpx; }
.elderly-mode .info-value { font-size: 32rpx; }
.elderly-mode .receiver-addr-book { font-size: 30rpx; }
.elderly-mode .order-no-display { font-size: 36rpx; }

/* ============ 承运审核结果卡片 ============ */
.review-card {
  width: 100%;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.review-passed { background: #EAF3EA; border: 2rpx solid #CBE3CB; }
.review-conditional, .review-manual, .review-pending { background: #FDF3E7; border: 2rpx solid #F0D9B8; }
.review-rejected { background: #FBEDEA; border: 2rpx solid #F0C4BA; }
.review-title-row { display: flex; align-items: center; gap: 12rpx; }
.review-title { font-size: 30rpx; font-weight: 600; color: #1C4B2E; }
.review-rejected .review-title { color: #C0392B; }
.review-conditional .review-title, .review-manual .review-title, .review-pending .review-title { color: #C75B2A; }
.review-reason { display: block; margin-top: 12rpx; font-size: 26rpx; color: #C0392B; }
.review-hint { display: block; margin-top: 8rpx; font-size: 26rpx; color: #6B5A4A; }
.elderly-mode .review-title { font-size: 34rpx; }
.elderly-mode .review-reason, .elderly-mode .review-hint { font-size: 30rpx; }

/* ============ 站点不可达：就近换站建议 ============ */
.station-suggest {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #FDF3E7;
  border: 2rpx solid #F0D9B8;
}
.station-suggest-text {
  display: block;
  font-size: 24rpx;
  color: #8A5A2B;
  line-height: 1.5;
}
.station-suggest-btn {
  display: inline-block;
  margin-top: 12rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #1F5E9E;
  color: #FFFFFF;
  font-size: 24rpx;
}
.elderly-mode .station-suggest-text { font-size: 28rpx; }
.elderly-mode .station-suggest-btn { font-size: 28rpx; padding: 14rpx 28rpx; }
