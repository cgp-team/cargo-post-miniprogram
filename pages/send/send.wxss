/* 寄货页样式 */
.page-send {
  min-height: 100vh;
  background: var(--color-paper);
  padding: 24rpx;
}

.step-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.step-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  margin-bottom: 30rpx;
}

.step-num {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: var(--color-on-primary);
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 语音提示 */
.voice-hint {
  background: linear-gradient(135deg, #FFF8E1, #FFF3CD);
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.voice-hint.listening {
  background: linear-gradient(135deg, #E3F2E6, #D0E8D5);
  box-shadow: 0 0 0 4rpx var(--color-primary-light);
  animation: voice-pulse 1.2s ease-in-out infinite;
}
@keyframes voice-pulse {
  0%, 100% { box-shadow: 0 0 0 4rpx var(--color-primary-light); }
  50% { box-shadow: 0 0 0 12rpx rgba(46, 125, 50, 0.15); }
}

.voice-mic { font-size: 56rpx; margin-bottom: 10rpx; }
.voice-text { font-size: 26rpx; color: #666; margin-bottom: 6rpx; }
.voice-example { font-size: 24rpx; color: var(--color-clay); font-weight: 600; }

/* 表单 */
.form-group { margin-bottom: 26rpx; }

.form-label {
  display: block;
  font-size: 28rpx;
  color: #555;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background: #F8FAF8;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--color-accent);
  background: #fff;
}

.flex-1 { flex: 1; }

.weight-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.weight-unit {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #F8FAF8;
  box-sizing: border-box;
}

.send-btn {
  margin-top: 20rpx;
  width: 100%;
}

/* 拍照区 */
.photo-area {
  width: 100%;
  height: 480rpx;
  border-radius: 20rpx;
  background: #F8FAF8;
  border: 3rpx dashed var(--color-accent);
  overflow: hidden;
  margin-bottom: 30rpx;
  transition: all 0.15s ease;
}

.photo-area:active { background: var(--color-primary-light); }

.photo-preview {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-camera { font-size: 80rpx; margin-bottom: 16rpx; }
.photo-hint { font-size: 30rpx; color: #333; font-weight: 600; margin-bottom: 8rpx; }
.photo-sub { font-size: 24rpx; color: #757575; }

/* 信息确认 */
.info-summary {
  background: #F8FAF8;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E8ECEE;
}
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #757575; }
.info-value { font-size: 28rpx; color: #333; font-weight: 600; }

/* 按钮组 */
.step-actions {
  display: flex;
  gap: 20rpx;
}

.step-actions .btn-outline { flex: 1; }
.step-actions .btn-primary { flex: 1.5; }

/* ====== 匹配成功 ====== */
.match-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.match-emoji { font-size: 100rpx; margin-bottom: 16rpx; }
.match-title { font-size: 38rpx; font-weight: 700; color: var(--color-primary); margin-bottom: 30rpx; }

.match-bus-card {
  width: 100%;
  background: var(--color-primary-light);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
}

.bus-icon-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  margin-bottom: 16rpx;
}

.bus-emoji { font-size: 52rpx; }
.bus-line {
  width: 120rpx;
  height: 3rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  margin: 0 10rpx;
}
.bus-stop { font-size: 36rpx; }

.bus-route-text {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-primary);
  display: block;
  margin-bottom: 8rpx;
}

.bus-detail { font-size: 26rpx; color: #666; display: block; margin-bottom: 24rpx; }

.countdown-box {
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
  background: #fff;
  padding: 20rpx 50rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.countdown-num {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--color-clay);
  line-height: 1;
}

.countdown-unit {
  font-size: 36rpx;
  color: var(--color-clay);
  font-weight: 600;
}

.countdown-hint {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 16rpx;
}

/* 温馨提示 */
.match-reminder {
  width: 100%;
  background: #FFF8E1;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  text-align: left;
  margin-bottom: 28rpx;
}

.reminder-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-clay);
  display: block;
  margin-bottom: 10rpx;
}

.reminder-text {
  font-size: 24rpx;
  color: #666;
  display: block;
  line-height: 1.6;
}

.step-actions .btn-primary { flex: none; width: 100%; }

/* 站点选择 */
.station-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 0 24rpx;
  background: #F8FAF8;
}

.station-text {
  font-size: 30rpx;
  color: #333;
}

.station-text.placeholder {
  color: #bbb;
}

.station-arrow {
  font-size: 26rpx;
  color: #999;
}

/* 收货信息 */
.receiver-section {
  margin-bottom: 28rpx;
  border-top: 1rpx dashed #E8ECEE;
  padding-top: 24rpx;
}

.receiver-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  display: block;
  margin-bottom: 20rpx;
}

/* 提交成功 - 订单号 */
.order-no-display {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  word-break: break-all;
  display: block;
  text-align: center;
  margin-bottom: 10rpx;
}

/* 订单二维码（取件/司机扫码） */
.qr-canvas {
  width: 320rpx;
  height: 320rpx;
  margin: 0 auto 20rpx;
  background: #fff;
  border-radius: 16rpx;
  display: block;
}
.qr-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
}
.qr-btn {
  flex: 0 0 auto;
  min-width: 180rpx;
  margin: 0;
  padding: 16rpx 0;
  font-size: 28rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  background: #fff;
  text-align: center;
}
.qr-btn::after { border: none; }
.elderly-mode .qr-canvas { width: 400rpx; height: 400rpx; }
.elderly-mode .qr-btn { font-size: 32rpx; padding: 20rpx 0; min-width: 220rpx; }

/* ============ 老年人模式：寄货页字体放大 ============ */
.elderly-mode .step-title { font-size: 40rpx; }
.elderly-mode .form-label { font-size: 32rpx; }
.elderly-mode .form-input { font-size: 34rpx; height: 100rpx; }
.elderly-mode .form-textarea { font-size: 32rpx; }
.elderly-mode .photo-hint { font-size: 36rpx; }
.elderly-mode .photo-sub { font-size: 28rpx; }
.elderly-mode .match-title { font-size: 44rpx; }
.elderly-mode .bus-route-text { font-size: 56rpx; }
.elderly-mode .bus-detail { font-size: 30rpx; }
.elderly-mode .countdown-hint { font-size: 30rpx; }
.elderly-mode .reminder-text { font-size: 28rpx; }
.elderly-mode .voice-text { font-size: 30rpx; }
.elderly-mode .voice-example { font-size: 28rpx; }
