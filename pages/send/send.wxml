<!-- 寄货页 - 农户一键寄货 -->
<view class="page-send {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">

  <!-- Step 1: 填写货物信息 -->
  <view wx:if="{{step === 1}}" class="step-card">
    <view class="step-title">
      <text class="step-num">1</text>
      <text>填写货物信息</text>
    </view>

    <view class="form-group">
      <text class="form-label">货物名称 *</text>
      <input
        class="form-input"
        placeholder="如：脆李、土鸡蛋、红薯粉"
        value="{{goodsName}}"
        bindinput="onNameInput"
      />
    </view>

    <view class="form-group">
      <text class="form-label">货物重量 *</text>
      <view class="weight-row">
        <input
          class="form-input flex-1"
          type="digit"
          placeholder="如：50"
          value="{{goodsWeight}}"
          bindinput="onWeightInput"
        />
        <text class="weight-unit">斤</text>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">货物类型 *</text>
      <picker mode="selector" range="{{categoryOptions}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">
          <text>{{cargoCategory}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">货物件数 *</text>
      <view class="weight-row">
        <input
          class="form-input flex-1"
          type="number"
          placeholder="如：2"
          value="{{itemCount}}"
          bindinput="onItemCountInput"
        />
        <text class="weight-unit">件</text>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">货物体积 *</text>
      <view class="size-row">
        <input
          class="form-input size-input"
          type="digit"
          placeholder="长cm"
          value="{{sizeLength}}"
          data-field="sizeLength"
          bindinput="onSizeInput"
        />
        <text class="size-x">×</text>
        <input
          class="form-input size-input"
          type="digit"
          placeholder="宽cm"
          value="{{sizeWidth}}"
          data-field="sizeWidth"
          bindinput="onSizeInput"
        />
        <text class="size-x">×</text>
        <input
          class="form-input size-input"
          type="digit"
          placeholder="高cm"
          value="{{sizeHeight}}"
          data-field="sizeHeight"
          bindinput="onSizeInput"
        />
      </view>
      <text class="form-hint">体积约 {{volumeText}} m³（按长×宽×高，单位厘米换算）</text>
    </view>

    <view class="form-group">
      <view class="switch-row">
        <view class="switch-text">
          <text class="form-label">生鲜 / 需冷链</text>
          <text class="form-hint">勾选后承运方需人工确认运输条件</text>
        </view>
        <switch checked="{{freshFlag}}" color="{{iconColor}}" bindchange="onFreshChange" />
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">备注（选填）</text>
      <textarea
        class="form-textarea"
        placeholder="补充说明，如：麻烦放阴凉处"
        value="{{goodsNote}}"
        bindinput="onNoteInput"
        maxlength="100"
      />
    </view>

    <view class="form-group">
      <text class="form-label">取货方式 *</text>
      <view class="pickup-mode-row">
        <view class="mode-btn {{pickupMode === 'location' ? 'active' : ''}}" bindtap="useCurrentLocation" hover-class="hover">
          <text>使用当前位置</text>
        </view>
        <view class="mode-btn {{pickupMode === 'station' ? 'active' : ''}}" bindtap="switchToStationMode" hover-class="hover">
          <text>自选取货站点</text>
        </view>
      </view>

      <view wx:if="{{reachLoading}}" class="reach-card">正在判断当前位置能否安排取货…</view>
      <view wx:elif="{{reachability}}" class="reach-card {{reachability.reachable ? 'ok' : 'warn'}}">
        <text class="reach-title">{{reachability.reachable ? '当前位置可由车辆就近服务' : '当前位置车辆无法直接进入'}}</text>
        <text wx:if="{{reachability.recommendedStation}}" class="reach-line">推荐服务站点：{{reachability.recommendedStation.name}}</text>
        <text wx:if="{{reachability.distanceKm != null}}" class="reach-line">距离约 {{reachability.distanceKm}} km · 步行约 {{reachability.walkMinutes}} 分钟{{reachability.distanceProvider === 'HAVERSINE' ? '（路线估算）' : ''}}</text>
        <text class="reach-line reach-reason">{{reachability.message}}</text>
        <view wx:if="{{!reachability.reachable && reachability.recommendedStation}}" class="reach-btn" bindtap="useRecommendedStation" hover-class="hover">使用推荐站点</view>
      </view>
      <text wx:if="{{originalAddress}}" class="form-hint">原始地址：{{originalAddress}}</text>
    </view>

    <view class="form-group">
      <text class="form-label">取货站点 *</text>
      <station-picker
        title="选择取货站点"
        placeholder="请选择取货站点"
        stations="{{stations}}"
        value="{{pickupStationId}}"
        loading="{{stationsLoading}}"
        error="{{stationsError}}"
        bindchange="onPickupStationChange"
        bindretry="loadStations"
      />
    </view>

    <view class="form-group">
      <text class="form-label">送达站点 *</text>
      <station-picker
        title="选择送达站点"
        placeholder="请选择送达站点"
        stations="{{stations}}"
        value="{{deliveryStationId}}"
        loading="{{stationsLoading}}"
        error="{{stationsError}}"
        bindchange="onDeliveryStationChange"
        bindretry="loadStations"
      />
    </view>

    <!-- 路线预估：点击"下一步"后展示（loading / 成功 / 失败重试） -->
    <view wx:if="{{routeStatus === 'loading'}}" class="route-preview">
      <text class="rp-text">正在计算路线…</text>
    </view>
    <view wx:elif="{{routeStatus === 'success' && routePreview}}" class="route-preview">
      <view class="rp-row">
        <text class="rp-label">真实道路距离</text>
        <text class="rp-value">{{routePreview.distanceKm}} km</text>
      </view>
      <view class="rp-row">
        <text class="rp-label">预计行驶时间</text>
        <text class="rp-value">{{routePreview.durationMinutes}} 分钟</text>
      </view>
      <text wx:if="{{routePreview.provider && routePreview.provider !== 'amap'}}" class="rp-warn">路网暂不可用，当前为直线估算</text>
    </view>
    <view wx:elif="{{routeStatus === 'error'}}" class="route-preview route-preview-error">
      <text class="rp-text">暂时无法获取路线</text>
      <view class="rp-retry" bindtap="retryRoutePreview" hover-class="hover">重新查询</view>
    </view>

    <button class="btn-primary send-btn" bindtap="goToPhoto">下一步：拍照确认</button>
  </view>

  <!-- Step 2: 拍照确认 -->
  <view wx:if="{{step === 2}}" class="step-card">
    <view class="step-title">
      <text class="step-num">2</text>
      <text>拍照确认货物</text>
    </view>

    <view class="photo-area" bindtap="takePhoto" hover-class="hover">
      <image wx:if="{{photoPath}}" class="photo-preview" src="{{photoPath}}" mode="aspectFill"></image>
      <view wx:else class="photo-placeholder">
        <icon class="photo-camera" name="camera" size="80" color="{{iconColor}}" />
        <text class="photo-hint">点击拍照</text>
        <text class="photo-sub">拍摄货物照片，方便司机辨认</text>
      </view>
    </view>

    <view class="info-summary">
      <view class="info-row">
        <text class="info-label">货物</text>
        <text class="info-value">{{goodsName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">重量</text>
        <text class="info-value">{{goodsWeight}} 斤</text>
      </view>
      <view class="info-row">
        <text class="info-label">类型</text>
        <text class="info-value">{{cargoCategory}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">件数</text>
        <text class="info-value">{{itemCount}} 件</text>
      </view>
      <view class="info-row">
        <text class="info-label">体积</text>
        <text class="info-value">{{sizeLength}}×{{sizeWidth}}×{{sizeHeight}} cm（{{volumeText}} m³）</text>
      </view>
      <view wx:if="{{freshFlag}}" class="info-row">
        <text class="info-label">生鲜</text>
        <text class="info-value">需冷链，承运方确认</text>
      </view>
      <view wx:if="{{pickupMode === 'location'}}" class="info-row">
        <text class="info-label">取货方式</text>
        <text class="info-value">就近站点{{reachability && !reachability.reachable ? '（送站交接）' : ''}}</text>
      </view>
      <view wx:if="{{pickupMode === 'location' && reachability && reachability.distanceKm != null}}" class="info-row">
        <text class="info-label">距离/步行</text>
        <text class="info-value">{{reachability.distanceKm}} km · 约 {{reachability.walkMinutes}} 分钟</text>
      </view>
      <view wx:if="{{goodsNote}}" class="info-row">
        <text class="info-label">备注</text>
        <text class="info-value">{{goodsNote}}</text>
      </view>
    </view>

    <view class="receiver-section">
      <view class="receiver-head">
        <text class="receiver-title">收货信息</text>
        <view class="receiver-addr-book" bindtap="goToAddressBook" hover-class="hover">
          <icon name="pin" size="28" color="{{iconColor}}" />
          <text>地址簿</text>
        </view>
      </view>
      <view class="form-group">
        <text class="form-label">收货电话 *</text>
        <input
          class="form-input"
          type="number"
          value="{{receiverMobile}}"
          placeholder="请输入收货电话"
          bindinput="onReceiverMobileInput"
        />
      </view>
      <view class="form-group">
        <text class="form-label">收货人（选填）</text>
        <input
          class="form-input"
          value="{{receiverName}}"
          placeholder="请输入收货人姓名"
          bindinput="onReceiverNameInput"
        />
      </view>
      <view class="form-group">
        <text class="form-label">收货地址（选填）</text>
        <input
          class="form-input"
          value="{{receiverAddress}}"
          placeholder="请输入收货地址"
          bindinput="onReceiverAddressInput"
        />
      </view>
    </view>

    <view class="step-actions">
      <button class="btn-outline" bindtap="resetSend">重新填写</button>
      <button class="btn-primary" bindtap="confirmSend">确认发布</button>
    </view>
  </view>

  <!-- Step 3: 提交成功 -->
  <view wx:if="{{step === 3}}" class="step-card match-success">
    <icon class="match-emoji" name="send" size="100" color="{{iconColor}}" />
    <text class="match-title">寄货已提交！</text>

    <!-- 承运审核结果：可运/不可运/需操作 实时反馈 -->
    <view wx:if="{{reviewMode}}" class="review-card review-{{reviewMode}}">
      <view class="review-title-row">
        <icon name="notice" size="28" color="{{reviewMode === 'passed' ? '#2E7D32' : (reviewMode === 'rejected' ? '#C0392B' : '#C75B2A')}}" />
        <text class="review-title">{{reviewTitle}}</text>
      </view>
      <text wx:if="{{reviewReasonText}}" class="review-reason">原因：{{reviewReasonText}}</text>
      <text class="review-hint">{{reviewHint}}</text>
      <!-- 需客户送站：显示就近交接站点 + 导航（后端按取货站点最近的可用站点匹配） -->
      <view wx:if="{{reviewMode === 'conditional' && servicePointStationName}}" class="review-station">
        <text class="review-station-name">交接站点：{{servicePointStationName}}<text wx:if="{{servicePointDistanceKm != null}}">（距取货点约 {{servicePointDistanceKm}} km）</text></text>
        <view class="review-station-btn" bindtap="openServicePoint" hover-class="hover">导航前往</view>
      </view>
    </view>

    <view class="match-bus-card">
      <canvas type="2d" id="qrCanvas" class="qr-canvas"></canvas>
      <text class="order-no-display">{{orderNo}}</text>
      <text class="bus-detail">寄货订单号 · 请妥善保存</text>
      <view class="qr-actions">
        <button class="qr-btn" bindtap="copyOrderNo">复制单号</button>
        <button class="qr-btn" open-type="share" bindtap="noop">分享查件</button>
      </view>
    </view>

    <view class="match-reminder">
      <view class="reminder-title"><icon name="notice" size="30" color="{{iconClay}}" /><text>温馨提示</text></view>
      <text class="reminder-text">订单已提交，调度员将尽快为您安排班次，</text>
      <text class="reminder-text">可在「我的」→「我的寄货」查看进度。</text>
    </view>

    <view class="step-actions">
      <button class="btn-primary" bindtap="goHome">我知道了，返回首页</button>
    </view>

    <!-- 取货方式与原始地址（答辩演示重点：位置 ≠ 车辆能到的地方） -->
    <view wx:if="{{pickupMode === 'location' || originalAddress}}" class="pickup-summary">
      <view class="info-row">
        <text class="info-label">取货方式</text>
        <text class="info-value">{{pickupMode === 'location' ? '就近站点交接' : '自选取货站点'}}</text>
      </view>
      <view wx:if="{{pickupStationName}}" class="info-row">
        <text class="info-label">取货站点</text>
        <text class="info-value">{{pickupStationName}}</text>
      </view>
      <view wx:if="{{reachability && reachability.distanceKm != null}}" class="info-row">
        <text class="info-label">距离/步行</text>
        <text class="info-value">{{reachability.distanceKm}} km · 约 {{reachability.walkMinutes}} 分钟</text>
      </view>
      <view wx:if="{{originalAddress}}" class="info-row">
        <text class="info-label">原始地址</text>
        <text class="info-value">{{originalAddress}}</text>
      </view>
      <text class="pickup-summary-tip">订单已进入调度系统，调度员将安排最近班次</text>
    </view>
  </view>

</view>
