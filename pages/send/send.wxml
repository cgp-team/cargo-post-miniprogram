<!-- 寄货页 - 农户一键寄货 -->
<view class="page-send {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">

  <!-- Step 1: 填写货物信息 -->
  <view wx:if="{{step === 1}}" class="step-card">
    <view class="step-title">
      <text class="step-num">1</text>
      <text>填写货物信息</text>
    </view>

    <view class="form-group">
      <text class="form-label">货物名称 *</text>
      <input
        class="form-input"
        placeholder="如：脆李、土鸡蛋、红薯粉"
        value="{{goodsName}}"
        bindinput="onNameInput"
      />
    </view>

    <view class="form-group">
      <text class="form-label">货物重量 *</text>
      <view class="weight-row">
        <input
          class="form-input flex-1"
          type="digit"
          placeholder="如：50"
          value="{{goodsWeight}}"
          bindinput="onWeightInput"
        />
        <text class="weight-unit">斤</text>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">备注（选填）</text>
      <textarea
        class="form-textarea"
        placeholder="补充说明，如：麻烦放阴凉处"
        value="{{goodsNote}}"
        bindinput="onNoteInput"
        maxlength="100"
      />
    </view>

    <view class="form-group">
      <text class="form-label">取货站点 *</text>
      <view class="station-picker" bindtap="choosePickupStation" hover-class="hover">
        <text class="station-text {{pickupStationName ? '' : 'placeholder'}}">{{pickupStationName || '请选择取货站点'}}</text>
        <text class="station-arrow">▾</text>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">送达站点 *</text>
      <view class="station-picker" bindtap="chooseDeliveryStation" hover-class="hover">
        <text class="station-text {{deliveryStationName ? '' : 'placeholder'}}">{{deliveryStationName || '请选择送达站点'}}</text>
        <text class="station-arrow">▾</text>
      </view>
    </view>

    <button class="btn-primary send-btn" bindtap="goToPhoto">下一步：拍照确认</button>
  </view>

  <!-- Step 2: 拍照确认 -->
  <view wx:if="{{step === 2}}" class="step-card">
    <view class="step-title">
      <text class="step-num">2</text>
      <text>拍照确认货物</text>
    </view>

    <view class="photo-area" bindtap="takePhoto" hover-class="hover">
      <image wx:if="{{photoPath}}" class="photo-preview" src="{{photoPath}}" mode="aspectFill"></image>
      <view wx:else class="photo-placeholder">
        <icon class="photo-camera" name="camera" size="80" color="{{iconColor}}" />
        <text class="photo-hint">点击拍照</text>
        <text class="photo-sub">拍摄货物照片，方便司机辨认</text>
      </view>
    </view>

    <view class="info-summary">
      <view class="info-row">
        <text class="info-label">货物</text>
        <text class="info-value">{{goodsName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">重量</text>
        <text class="info-value">{{goodsWeight}} 斤</text>
      </view>
      <view wx:if="{{goodsNote}}" class="info-row">
        <text class="info-label">备注</text>
        <text class="info-value">{{goodsNote}}</text>
      </view>
    </view>

    <view class="receiver-section">
      <view class="receiver-head">
        <text class="receiver-title">收货信息</text>
        <view class="receiver-addr-book" bindtap="goToAddressBook" hover-class="hover">
          <icon name="pin" size="28" color="{{iconColor}}" />
          <text>地址簿</text>
        </view>
      </view>
      <view class="form-group">
        <text class="form-label">收货电话 *</text>
        <input
          class="form-input"
          type="number"
          value="{{receiverMobile}}"
          placeholder="请输入收货电话"
          bindinput="onReceiverMobileInput"
        />
      </view>
      <view class="form-group">
        <text class="form-label">收货人（选填）</text>
        <input
          class="form-input"
          value="{{receiverName}}"
          placeholder="请输入收货人姓名"
          bindinput="onReceiverNameInput"
        />
      </view>
      <view class="form-group">
        <text class="form-label">收货地址（选填）</text>
        <input
          class="form-input"
          value="{{receiverAddress}}"
          placeholder="请输入收货地址"
          bindinput="onReceiverAddressInput"
        />
      </view>
    </view>

    <view class="step-actions">
      <button class="btn-outline" bindtap="resetSend">重新填写</button>
      <button class="btn-primary" bindtap="confirmSend">确认发布</button>
    </view>
  </view>

  <!-- Step 3: 提交成功 -->
  <view wx:if="{{step === 3}}" class="step-card match-success">
    <icon class="match-emoji" name="send" size="100" color="{{iconColor}}" />
    <text class="match-title">寄货已提交！</text>

    <view class="match-bus-card">
      <canvas type="2d" id="qrCanvas" class="qr-canvas"></canvas>
      <text class="order-no-display">{{orderNo}}</text>
      <text class="bus-detail">寄货订单号 · 请妥善保存</text>
      <view class="qr-actions">
        <button class="qr-btn" bindtap="copyOrderNo">复制单号</button>
        <button class="qr-btn" open-type="share" bindtap="noop">分享查件</button>
      </view>
    </view>

    <view class="match-reminder">
      <view class="reminder-title"><icon name="notice" size="30" color="{{iconClay}}" /><text>温馨提示</text></view>
      <text class="reminder-text">订单已提交，调度员将尽快为您安排班次，</text>
      <text class="reminder-text">可在「我的」→「我的寄货」查看进度。</text>
    </view>

    <view class="step-actions">
      <button class="btn-primary" bindtap="goHome">我知道了，返回首页</button>
    </view>
  </view>

</view>
