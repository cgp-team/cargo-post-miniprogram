<!-- 司机收益页 -->
<view class="earnings-page {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- 顶部站牌头（与路线页同一节奏） -->
  <view class="page-header">
    <view class="header-safe" style="height: {{statusBarHeight}}px;"></view>
    <view class="page-title-row">
      <icon name="wallet" size="40" color="#FFFFFF" />
      <text class="page-title">我的收益</text>
    </view>
    <text class="page-date">货运订单收益统计</text>
    <text class="header-badge">司机端</text>
  </view>

  <!-- 运营统计卡片（真实后端数据）：总额为视觉焦点 -->
  <view class="overview-card">
    <view class="overview-main">
      <view class="overview-wallet">
        <icon name="wallet" size="52" color="#FFFFFF" />
      </view>
      <text class="overview-label">累计货运订单总额（元）</text>
      <text class="overview-amount anim-rise">{{totalEarnings}}</text>
    </view>
    <view class="overview-row anim-rise" style="animation-delay: 120ms">
      <view class="overview-item">
        <text class="ov-num orange">{{todayEarnings}}</text>
        <text class="ov-label">今日</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="ov-num">{{totalOrders}}</text>
        <text class="ov-label">累计订单</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="ov-num green">{{todayOrders}}</text>
        <text class="ov-label">今日订单</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="ov-num gold">{{pendingCount}}</text>
        <text class="ov-label">待装车</text>
      </view>
    </view>
    <view class="overview-sub anim-rise" style="animation-delay: 200ms">今日计划班次 {{shiftCount}} 班 · 数据来自运输平台</view>
  </view>

  <!-- 收益明细：统一卡片行 -->
  <view class="records-section">
    <view class="section-title section-title-flex">
      <icon name="list" size="32" color="{{iconDeep}}" />
      <text>收益明细</text>
    </view>

    <view class="record-item anim-rise" wx:for="{{records}}" wx:key="id" style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms">
      <view class="record-left">
        <view class="record-type-icon {{item.type === '货运订单' ? 'green-bg' : 'gold-bg'}}">
          <icon name="{{item.type === '货运订单' ? 'leaf' : 'box'}}" size="36" color="#FFFFFF" />
        </view>
        <view class="record-info">
          <text class="record-type">{{item.type}}</text>
          <text class="record-goods">{{item.goods}} {{item.weight}}</text>
          <text class="record-meta">{{item.time}} · {{item.status}}</text>
        </view>
      </view>
      <view class="record-right">
        <text class="record-amount">¥{{item.amount}}</text>
      </view>
    </view>

    <!-- 加载骨架（仿明细行轮廓）/ 空态 -->
    <view wx:if="{{loading}}">
      <view class="skeleton-card sk-record" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="skeleton sk-icon"></view>
        <view class="sk-mid">
          <view class="skeleton sk-title"></view>
          <view class="skeleton sk-line"></view>
          <view class="skeleton sk-line w70"></view>
        </view>
        <view class="skeleton sk-amount"></view>
      </view>
    </view>
    <empty-state wx:elif="{{loaded && !records.length}}" icon="wallet" text="暂无收益记录" subText="订单完成后自动记录在这里" />
  </view>

  <!-- 底部TabBar -->
  <driver-tab-bar current="earnings" elderly="{{elderlyMode}}"></driver-tab-bar>
</view>
