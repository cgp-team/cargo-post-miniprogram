<!-- 司机收益页 -->
<view class="earnings-page">
  <!-- 顶部 -->
  <view class="page-header">
    <view class="header-safe" style="height: {{statusBarHeight}}px;"></view>
    <text class="page-title">💰 我的收益</text>
  </view>

  <!-- 收益总览卡片 -->
  <view class="overview-card">
    <view class="overview-main">
      <text class="overview-label">累计收益（元）</text>
      <text class="overview-amount">{{totalEarnings}}</text>
    </view>
    <view class="overview-row">
      <view class="overview-item">
        <text class="ov-num green">{{monthEarnings}}</text>
        <text class="ov-label">本月</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="ov-num orange">{{todayEarnings}}</text>
        <text class="ov-label">今日</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="ov-num">{{totalOrders}}</text>
        <text class="ov-label">总单数</text>
      </view>
    </view>
  </view>

  <!-- 收益明细 -->
  <view class="records-section">
    <text class="section-title">📋 收益明细</text>

    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-left">
        <view class="record-type-icon">
          <text>{{item.type === '农产品运输' ? '🥬' : '📦'}}</text>
        </view>
        <view class="record-info">
          <text class="record-type">{{item.type}}</text>
          <text class="record-goods">{{item.goods}}</text>
          <text class="record-meta">{{item.route}} · {{item.time}}</text>
        </view>
      </view>
      <view class="record-right">
        <text class="record-amount">+¥{{item.amount}}</text>
      </view>
    </view>
  </view>

  <!-- 底部TabBar -->
  <driver-tab-bar current="earnings"></driver-tab-bar>
</view>
