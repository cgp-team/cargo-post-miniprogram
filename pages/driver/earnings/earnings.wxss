/* 收益页 - 暗黑主题 */
.earnings-page {
  min-height: 100vh;
  background: #1A1A1A;
  color: #fff;
  padding-bottom: 140rpx;
}

.page-header {
  background: linear-gradient(180deg, #0D0D0D, #1A1A1A);
  padding: 0 32rpx 32rpx;
  border-bottom: 1rpx solid #2A2A2A;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
}

/* 收益总览 */
.overview-card {
  margin: 24rpx;
  background: linear-gradient(135deg, #2E5A2E, #5AAE66);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
}

.overview-main {
  text-align: center;
  margin-bottom: 32rpx;
}

.overview-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  display: block;
  margin-bottom: 8rpx;
}

.overview-amount {
  font-size: 72rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 2rpx;
}

.overview-row {
  display: flex;
  align-items: center;
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.2);
}

.ov-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  margin-bottom: 4rpx;
}

.ov-num.green { color: #A5D6A7; }
.ov-num.orange { color: #E8925B; }

.ov-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

/* 明细 */
.records-section {
  padding: 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ccc;
  display: block;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #222;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #2A2A2A;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.record-type-icon {
  width: 64rpx;
  height: 64rpx;
  background: #1A1A1A;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  overflow: hidden;
}

.record-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  display: block;
}

.record-goods {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.record-meta {
  font-size: 22rpx;
  color: #666;
  display: block;
  margin-top: 4rpx;
}

.record-right {
  flex-shrink: 0;
}

.record-amount {
  font-size: 34rpx;
  font-weight: 800;
  color: #6FBF7A;
}

.ov-num.blue {
  color: #1565C0;
}

.overview-sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  text-align: center;
}
