/* 收益页 - 对齐用户端「山乡巴士·站牌与车票」米纸暖色主题 */
.earnings-page {
  min-height: 100vh;
  background: var(--color-paper);
  color: var(--color-ink);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 头部站牌：深绿实板 + 落款横档 + 装饰光晕（与路线页同一节奏） */
.page-header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  padding: 0 32rpx 40rpx;
}

.page-header::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 30rpx;
  right: 30rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

.page-header::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.header-safe {
  width: 100%;
}

.page-title-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.page-date {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  display: block;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

/* 右上角身份角标（站牌线路号位） */
.header-badge {
  position: absolute;
  bottom: 40rpx;
  right: 32rpx;
  z-index: 2;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

/* 收益总览：深绿站牌卡，总额大字为视觉焦点 */
.overview-card {
  position: relative;
  overflow: hidden;
  margin: 24rpx;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  border-radius: 22rpx;
  padding: 40rpx 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx var(--color-primary-shadow);
}

.overview-card::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 30rpx;
  right: 30rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

.overview-card::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.overview-main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

/* wallet 图标圆牌：总额上方的视觉锚点 */
.overview-wallet {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.overview-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.overview-amount {
  font-size: 80rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.overview-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
}

.ov-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  display: block;
  margin-bottom: 4rpx;
}

.ov-num.green { color: #A5D6A7; }
.ov-num.orange { color: #FFD9B8; }
.ov-num.gold { color: var(--color-gold); }

.ov-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

.overview-sub {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  text-align: center;
}

/* 收益明细：统一暖白卡片行 */
.records-section {
  padding: 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  display: block;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
  letter-spacing: 0.5rpx;
}

.section-title-flex {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFDF8;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
}

.record-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

/* 类型图标块：货运=站牌绿渐变，其他=稻谷金渐变 */
.record-type-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.10);
}

.record-type-icon.green-bg {
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
}

.record-type-icon.gold-bg {
  background: linear-gradient(135deg, var(--color-gold), #B98A2E);
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
  display: block;
}

.record-goods {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.record-meta {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-top: 4rpx;
}

.record-right {
  flex-shrink: 0;
  padding-left: 16rpx;
}

.record-amount {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-clay);
}

/* ============ 老年人模式：司机端收益页字号放大 ============ */
.elderly-mode .page-title { font-size: 52rpx; }
.elderly-mode .page-date { font-size: 30rpx; }
.elderly-mode .header-badge { font-size: 24rpx; }
.elderly-mode .overview-wallet { width: 108rpx; height: 108rpx; }
.elderly-mode .overview-label { font-size: 28rpx; }
.elderly-mode .overview-amount { font-size: 92rpx; }
.elderly-mode .overview-sub { font-size: 26rpx; }
.elderly-mode .ov-num { font-size: 42rpx; }
.elderly-mode .ov-label { font-size: 26rpx; }
.elderly-mode .section-title { font-size: 38rpx; }
.elderly-mode .record-type { font-size: 34rpx; }
.elderly-mode .record-goods { font-size: 28rpx; }
.elderly-mode .record-meta { font-size: 26rpx; }
.elderly-mode .record-amount { font-size: 42rpx; }
