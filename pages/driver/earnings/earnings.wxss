/* 收益页 - 对齐用户端「山乡巴士·站牌与车票」米纸暖色主题 */
.earnings-page {
  min-height: 100vh;
  background: var(--color-paper, #F6F2E9);
  color: var(--color-ink, #2B2B28);
  padding-bottom: 140rpx;
}

.page-header {
  background: linear-gradient(180deg, var(--color-primary-dark, #1C4B2E), var(--color-primary, #2E7D32));
  padding: 0 32rpx 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
}

/* 收益总览 */
.overview-card {
  margin: 24rpx;
  background: linear-gradient(135deg, var(--color-primary-dark, #1C4B2E), var(--color-primary, #2E7D32));
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
}

.overview-main {
  text-align: center;
  margin-bottom: 32rpx;
}

.overview-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 8rpx;
}

.overview-amount {
  font-size: 72rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.overview-row {
  display: flex;
  align-items: center;
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
}

.ov-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  display: block;
  margin-bottom: 4rpx;
}

.ov-num.green { color: #A5D6A7; }
.ov-num.orange { color: #FFD9B8; }
.ov-num.gold { color: var(--color-gold, #D9A441); }

.ov-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

/* 明细 */
.records-section {
  padding: 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-ink, #2B2B28);
  display: block;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(43, 43, 40, 0.08);
  box-shadow: 0 4rpx 12rpx rgba(43, 43, 40, 0.04);
}

.record-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.record-type-icon {
  width: 64rpx;
  height: 64rpx;
  background: var(--color-primary-light, #EAF3EA);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  overflow: hidden;
}

.record-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink, #2B2B28);
  display: block;
}

.record-goods {
  font-size: 24rpx;
  color: var(--color-text-secondary, #6B675C);
  display: block;
  margin-top: 4rpx;
}

.record-meta {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #8A8778);
  display: block;
  margin-top: 4rpx;
}

.record-right {
  flex-shrink: 0;
}

.record-amount {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-clay, #C75B2A);
}

.section-title-flex {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.overview-sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  text-align: center;
}

/* ============ 老年人模式：司机端收益页字号放大 ============ */
.elderly-mode .page-title { font-size: 52rpx; }
.elderly-mode .overview-label { font-size: 28rpx; }
.elderly-mode .overview-amount { font-size: 84rpx; }
.elderly-mode .overview-sub { font-size: 26rpx; }
.elderly-mode .ov-num { font-size: 42rpx; }
.elderly-mode .ov-label { font-size: 26rpx; }
.elderly-mode .section-title { font-size: 38rpx; }
.elderly-mode .record-type { font-size: 34rpx; }
.elderly-mode .record-goods { font-size: 28rpx; }
.elderly-mode .record-meta { font-size: 26rpx; }
.elderly-mode .record-amount { font-size: 40rpx; }
