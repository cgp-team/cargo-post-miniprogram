/* 司机工作台 - 对齐用户端「山乡巴士·站牌与车票」米纸暖色主题 */
.workbench {
  min-height: 100vh;
  background: var(--color-paper, #F6F2E9);
  color: var(--color-ink, #2B2B28);
  padding-bottom: 140rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ========== 顶部进度条（深站牌绿头部，与用户端导航一致） ========== */
.progress-header {
  background: linear-gradient(180deg, var(--color-primary-dark, #1C4B2E) 0%, var(--color-primary, #2E7D32) 100%);
  padding: 0 32rpx 28rpx;
}

.header-safe {
  width: 100%;
}

.route-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.route-badge {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.status-tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
  color: #ffffff;
}

.status-tag.idle {
  background: rgba(255, 255, 255, 0.2);
}

.status-tag.driving {
  background: rgba(255, 255, 255, 0.22);
}

.status-tag.stopped {
  background: rgba(199, 91, 42, 0.85);
}

/* 进度条 */
.progress-bar-wrap {
  margin-top: 8rpx;
}

.progress-stops {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.stop-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.stop-label.start { color: #ffffff; }
.stop-label.end { color: #FFE0B2; }

.progress-track {
  position: relative;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 5rpx;
  overflow: visible;
}

.progress-fill {
  height: 100%;
  background: #ffffff;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

.progress-dot {
  position: absolute;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  background: #ffffff;
  border: 4rpx solid var(--color-clay, #C75B2A);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 16rpx rgba(255, 255, 255, 0.5);
  transition: left 0.5s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.next-stop-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.next-stop-dist {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

/* ========== 待发车面板 ========== */
.idle-panel {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 行李舱可视化 */
.cargo-visual {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 50rpx;
  width: 100%;
  justify-content: center;
}

.bus-graphic {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.bus-body {
  width: 240rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border: 2rpx solid rgba(43, 43, 40, 0.1);
  box-shadow: 0 8rpx 24rpx rgba(43, 43, 40, 0.06);
}

.bus-windows {
  display: flex;
  gap: 8rpx;
  justify-content: center;
}

.window {
  width: 40rpx;
  height: 28rpx;
  background: var(--color-primary-light, #EAF3EA);
  border-radius: 6rpx;
  border: 1rpx solid rgba(43, 43, 40, 0.08);
}

/* 行李舱填充区 */
.bus-cargo-area {
  flex: 1;
  background: var(--color-paper, #F6F2E9);
  border-radius: 14rpx;
  position: relative;
  overflow: hidden;
  border: 2rpx dashed rgba(43, 43, 40, 0.18);
  min-height: 200rpx;
}

.cargo-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, var(--color-accent, #4CAF50), var(--color-primary, #2E7D32));
  transition: height 0.3s ease;
  border-radius: 0 0 12rpx 12rpx;
}

.cargo-fill-inner {
  position: absolute;
  top: 8rpx;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.35);
  border-radius: 2rpx;
}

.cargo-used-mark {
  position: absolute;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--color-clay, #C75B2A);
  z-index: 2;
}

.bus-wheels {
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
}

.wheel {
  width: 32rpx;
  height: 32rpx;
  background: var(--color-ink, #2B2B28);
  border-radius: 50%;
  border: 3rpx solid rgba(43, 43, 40, 0.3);
}

/* 仓位标签 */
.cargo-labels {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 0 0;
  font-size: 20rpx;
  color: var(--color-text-tertiary, #8A8778);
}

.cargo-label-max,
.cargo-label-half,
.cargo-label-empty {
  color: var(--color-text-tertiary, #8A8778);
}

/* 仓位数据 */
.cargo-stats {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cargo-percent {
  font-size: 100rpx;
  font-weight: 900;
  color: var(--color-primary, #2E7D32);
  line-height: 1;
}

.cargo-title {
  font-size: 28rpx;
  color: var(--color-text-secondary, #6B675C);
  margin-top: 8rpx;
}

/* 滑块区域 */
.slider-section {
  width: 100%;
  margin-bottom: 50rpx;
}

.slider-ticks {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary, #8A8778);
}

.cargo-slider {
  width: 100%;
  margin: 16rpx 0;
}

.slider-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink, #2B2B28);
  border: 2rpx solid rgba(43, 43, 40, 0.1);
  transition: all 0.2s;
}

.quick-btn:active {
  background: var(--color-primary, #2E7D32);
  color: #fff;
  border-color: var(--color-primary, #2E7D32);
}

/* 发车按钮 */
.start-btn {
  width: 320rpx;
  height: 120rpx;
  background: linear-gradient(135deg, var(--color-clay, #C75B2A), var(--color-primary, #2E7D32));
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
  box-shadow: 0 12rpx 40rpx var(--color-primary-shadow, rgba(46, 125, 50, 0.2));
}

.start-btn:active {
  transform: scale(0.95);
  box-shadow: 0 6rpx 20rpx var(--color-primary-shadow, rgba(46, 125, 50, 0.2));
}

.start-icon {
  font-size: 52rpx;
}

.start-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 8rpx;
}

/* ========== 行驶中面板 ========== */
.driving-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.map-area {
  height: 600rpx;
  position: relative;
  background: var(--color-primary-light, #EAF3EA);
}

.nav-map {
  width: 100%;
  height: 100%;
}

/* 速度浮层 */
.speed-overlay {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(28, 75, 46, 0.85);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  backdrop-filter: blur(10rpx);
}

.speed-num {
  font-size: 56rpx;
  font-weight: 900;
  color: #ffffff;
  line-height: 1;
}

.speed-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 前方到站卡片（站牌式） */
.next-stop-card {
  position: absolute;
  bottom: 120rpx;
  left: 24rpx;
  right: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 2rpx solid var(--color-clay, #C75B2A);
  box-shadow: 0 8rpx 24rpx rgba(43, 43, 40, 0.12);
}

.stop-alert-icon {
  font-size: 48rpx;
}

.stop-alert-info {
  flex: 1;
}

.stop-alert-name {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--color-ink, #2B2B28);
  display: block;
}

.stop-alert-dist {
  font-size: 28rpx;
  color: var(--color-clay, #C75B2A);
  display: block;
  margin-top: 4rpx;
}

.stop-alert-task {
  font-size: 26rpx;
  color: var(--color-danger, #C0392B);
  display: block;
  margin-top: 6rpx;
}

/* 语音播报条 */
.voice-bar {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  right: 24rpx;
  background: var(--color-primary-dark, #1C4B2E);
  border-radius: 14rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.voice-icon {
  font-size: 32rpx;
}

.voice-content {
  font-size: 26rpx;
  color: #ffffff;
  flex: 1;
}

/* ETA信息栏 */
.eta-bar {
  display: flex;
  background: #ffffff;
  padding: 28rpx 32rpx;
  gap: 0;
  border-bottom: 1rpx solid rgba(43, 43, 40, 0.08);
}

.eta-item {
  flex: 1;
  text-align: center;
}

.eta-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #8A8778);
  display: block;
  margin-bottom: 8rpx;
}

.eta-value {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-ink, #2B2B28);
  display: block;
}

.eta-value.orange {
  color: var(--color-clay, #C75B2A);
}

/* ========== 停靠面板 ========== */
.stopped-panel {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 站点横幅 */
.stop-banner {
  text-align: center;
  margin-bottom: 40rpx;
}

.stop-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.stop-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-ink, #2B2B28);
  display: block;
}

.stop-subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary, #6B675C);
  display: block;
  margin-top: 8rpx;
}

/* 待装货物 */
.pickup-list {
  width: 100%;
  margin-bottom: 40rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(43, 43, 40, 0.06);
}

.pickup-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(43, 43, 40, 0.08);
}

.pickup-item:last-child {
  border-bottom: none;
}

.pickup-emoji {
  font-size: 44rpx;
}

.pickup-info {
  flex: 1;
}

.pickup-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-ink, #2B2B28);
  display: block;
}

.pickup-detail {
  font-size: 24rpx;
  color: var(--color-text-secondary, #6B675C);
  display: block;
  margin-top: 4rpx;
}

.pickup-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(43, 43, 40, 0.25);
  background: transparent;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pickup-check.checked {
  background: var(--color-primary, #2E7D32);
  border-color: var(--color-primary, #2E7D32);
}

/* 巨大扫码按钮 */
.scan-btn {
  width: 100%;
  height: 280rpx;
  background: linear-gradient(180deg, var(--color-primary, #2E7D32), var(--color-primary-dark, #1C4B2E));
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  box-shadow: 0 16rpx 48rpx var(--color-primary-shadow, rgba(46, 125, 50, 0.2));
  margin-bottom: 32rpx;
}

.scan-btn:active {
  transform: scale(0.96);
  box-shadow: 0 8rpx 24rpx var(--color-primary-shadow, rgba(46, 125, 50, 0.2));
}

.scan-icon {
  font-size: 64rpx;
}

.scan-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
}

.scan-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.skip-btn {
  font-size: 32rpx;
  color: var(--color-text-secondary, #6B675C);
  padding: 24rpx 40rpx;
}

/* 司机信息栏 */
.driver-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 30rpx 0;
  color: rgba(255, 255, 255, 0.9);
}

.driver-emoji {
  font-size: 30rpx;
}

.driver-text {
  font-size: 26rpx;
  font-weight: 600;
}

.driver-plate {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.driver-capacity {
  margin-left: auto;
  font-size: 24rpx;
}

/* 调度任务区 */
.task-list {
  margin: 20rpx 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 43, 40, 0.06);
}

.task-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary, #2E7D32);
  display: block;
  margin-bottom: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(43, 43, 40, 0.08);
}

.task-station {
  font-size: 28rpx;
  color: var(--color-ink, #2B2B28);
  font-weight: 600;
}

.task-action {
  font-size: 24rpx;
  color: var(--color-clay, #C75B2A);
  background: rgba(199, 91, 42, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.task-order {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #8A8778);
  margin-left: auto;
}

/* 到站确认按钮（行驶中） */
.arrive-btn {
  width: calc(100% - 64rpx);
  margin: 32rpx;
  height: 120rpx;
  background: linear-gradient(180deg, var(--color-clay, #C75B2A), var(--color-primary, #2E7D32));
  border-radius: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
  box-shadow: 0 12rpx 36rpx var(--color-primary-shadow, rgba(46, 125, 50, 0.2));
}

.arrive-btn:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 18rpx var(--color-primary-shadow, rgba(46, 125, 50, 0.2));
}

.arrive-icon {
  font-size: 40rpx;
}

.arrive-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

/* 妥投扫码按钮（停靠中，次按钮） */
.deliver-btn {
  height: 200rpx;
  background: var(--color-gold, #D9A441);
  box-shadow: 0 16rpx 48rpx rgba(217, 164, 65, 0.35);
}

.deliver-btn:active {
  box-shadow: 0 8rpx 24rpx rgba(217, 164, 65, 0.3);
}

/* 取件核销按钮（邮快件，次按钮） */
.verify-btn {
  height: 200rpx;
  background: linear-gradient(180deg, var(--color-primary, #2E7D32), var(--color-primary-dark, #1C4B2E));
  box-shadow: 0 16rpx 48rpx var(--color-primary-shadow, rgba(46, 125, 50, 0.2));
}

.verify-btn:active {
  box-shadow: 0 8rpx 24rpx var(--color-primary-shadow, rgba(46, 125, 50, 0.2));
}

/* ============ 老年人模式：司机端工作台字号放大 ============ */
.elderly-mode .route-badge { font-size: 52rpx; }
.elderly-mode .status-tag { font-size: 28rpx; }
.elderly-mode .stop-label { font-size: 26rpx; }
.elderly-mode .next-stop-name { font-size: 34rpx; }
.elderly-mode .next-stop-dist { font-size: 32rpx; }
.elderly-mode .cargo-title { font-size: 32rpx; }
.elderly-mode .start-text { font-size: 52rpx; }
.elderly-mode .speed-num { font-size: 68rpx; }
.elderly-mode .speed-unit { font-size: 28rpx; }

/* ============ 运营路单（signature：司机视角的任务段清单） ============ */
.task-segment-panel {
  margin: 16rpx 24rpx;
  padding: 24rpx 24rpx 16rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid rgba(43, 43, 40, 0.08);
  box-shadow: 0 8rpx 24rpx rgba(43, 43, 40, 0.08);
  /* 左侧打孔：路单装订孔 */
  background-image: radial-gradient(circle, var(--color-paper, #F6F2E9) 0 6rpx, transparent 6rpx);
  background-size: 32rpx 32rpx;
  background-position: -8rpx 12rpx;
}
.task-segment-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark, #1C4B2E);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}
.task-window {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #8A8778);
  margin-bottom: 12rpx;
}
.task-stop {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed rgba(43, 43, 40, 0.12);
}
.task-stop:last-child { border-bottom: none; }
.task-stop-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.task-stop-name { font-size: 28rpx; font-weight: 600; color: var(--color-ink, #2B2B28); }
.task-stop-status { font-size: 22rpx; color: var(--color-gold, #D9A441); }
.task-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6B675C);
}
.task-action-name { color: var(--color-primary, #2E7D32); }
.task-action-order { color: var(--color-text-tertiary, #8A8778); }
.task-action-qty { color: var(--color-clay, #C75B2A); }
.elderly-mode .task-segment-title { font-size: 34rpx; }
.elderly-mode .task-stop-name { font-size: 32rpx; }
.elderly-mode .task-action { font-size: 28rpx; }

/* ============ 偏航告警（Phase 9） ============ */
.deviation-banner {
  margin: 16rpx 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(192, 57, 43, 0.1);
  border: 2rpx solid rgba(192, 57, 43, 0.4);
  font-size: 26rpx;
  color: #C0392B;
}

/* ============ 连续任务导航（导航横幅 + 取/派 chip） ============ */
.nav-banner {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--color-primary-dark, #1C4B2E), var(--color-primary, #2E7D32));
  box-shadow: 0 8rpx 24rpx var(--color-primary-shadow, rgba(46, 125, 50, 0.2));
}
.nav-seq {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}
.nav-station-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
}
.nav-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}
.nav-chip {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
}
.nav-chip.pickup { background: rgba(255, 255, 255, 0.22); }
.nav-chip.deliver { background: var(--color-clay, #C75B2A); }
.nav-chip.board, .nav-chip.alight { background: rgba(255, 255, 255, 0.18); }
.nav-chip.none { background: rgba(255, 255, 255, 0.14); }
.nav-amap {
  align-self: flex-end;
  margin-top: 8rpx;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  color: #fff;
  background: var(--color-clay, #C75B2A);
}
.stop-alert-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}
.stop-alert-actions .nav-chip.pickup { background: rgba(46, 125, 50, 0.12); color: var(--color-primary, #2E7D32); }
.stop-alert-actions .nav-chip.deliver { background: rgba(199, 91, 42, 0.12); color: var(--color-clay, #C75B2A); }
.stop-alert-actions .nav-chip.board, .stop-alert-actions .nav-chip.alight { background: rgba(31, 94, 158, 0.1); color: #1F5E9E; }
.arrive-btn.ready {
  box-shadow: 0 0 0 6rpx var(--color-gold, #D9A441), 0 12rpx 36rpx var(--color-primary-shadow, rgba(46, 125, 50, 0.2));
}

/* ============ 位置来源状态标签（只读展示，非控制开关） ============ */
.location-source {
  margin-left: auto;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: var(--color-gold, #D9A441);
  border: 2rpx solid var(--color-gold, #D9A441);
  background: rgba(217, 164, 65, 0.18);
}

/* ============ 订阅派单通知入口 ============ */
.subscribe-entry {
  margin: 16rpx 24rpx 0;
  padding: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--color-gold, #D9A441);
  border: 2rpx dashed rgba(217, 164, 65, 0.5);
  background: rgba(217, 164, 65, 0.08);
}
