/* 司机工作台 - 暗黑主题 */
.workbench {
  min-height: 100vh;
  background: #1A1A1A;
  color: #ffffff;
  padding-bottom: 140rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ========== 顶部进度条 ========== */
.progress-header {
  background: linear-gradient(180deg, #0D0D0D 0%, #1A1A1A 100%);
  padding: 0 32rpx 28rpx;
  border-bottom: 1rpx solid #2A2A2A;
}

.header-safe {
  width: 100%;
}

.route-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.route-badge {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.status-tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.status-tag.idle {
  background: rgba(255,152,0,0.2);
  color: #FFB74D;
}

.status-tag.driving {
  background: rgba(76,175,80,0.2);
  color: #81C784;
}

.status-tag.stopped {
  background: rgba(255,82,82,0.2);
  color: #EF5350;
}

/* 进度条 */
.progress-bar-wrap {
  margin-top: 8rpx;
}

.progress-stops {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.stop-label {
  font-size: 22rpx;
  color: #888;
}

.stop-label.start { color: #81C784; }
.stop-label.end { color: #FFB74D; }

.progress-track {
  position: relative;
  height: 10rpx;
  background: #333;
  border-radius: 5rpx;
  overflow: visible;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #81C784);
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

.progress-dot {
  position: absolute;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  background: #ffffff;
  border: 4rpx solid #4CAF50;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 16rpx rgba(76,175,80,0.6);
  transition: left 0.5s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.next-stop-name {
  font-size: 28rpx;
  color: #ccc;
}

.next-stop-dist {
  font-size: 28rpx;
  color: #81C784;
  font-weight: 600;
}

/* ========== 待发车面板 ========== */
.idle-panel {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 行李舱可视化 */
.cargo-visual {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 50rpx;
  width: 100%;
  justify-content: center;
}

.bus-graphic {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.bus-body {
  width: 240rpx;
  background: #2A2A2A;
  border-radius: 24rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border: 2rpx solid #3A3A3A;
}

.bus-windows {
  display: flex;
  gap: 8rpx;
  justify-content: center;
}

.window {
  width: 40rpx;
  height: 28rpx;
  background: #1A1A1A;
  border-radius: 6rpx;
  border: 1rpx solid #444;
}

/* 行李舱填充区 */
.bus-cargo-area {
  flex: 1;
  background: #1A1A1A;
  border-radius: 14rpx;
  position: relative;
  overflow: hidden;
  border: 2rpx dashed #444;
  min-height: 200rpx;
}

.cargo-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, #4CAF50, #2E7D32);
  transition: height 0.3s ease;
  border-radius: 0 0 12rpx 12rpx;
}

.cargo-fill-inner {
  position: absolute;
  top: 8rpx;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 2rpx;
}

.cargo-used-mark {
  position: absolute;
  left: 0;
  right: 0;
  height: 3rpx;
  background: #FF9800;
  z-index: 2;
}

.bus-wheels {
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
}

.wheel {
  width: 32rpx;
  height: 32rpx;
  background: #555;
  border-radius: 50%;
  border: 3rpx solid #777;
}

/* 仓位标签 */
.cargo-labels {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 0 0;
  font-size: 20rpx;
  color: #666;
}

.cargo-label-max { color: #888; }
.cargo-label-half { color: #888; }
.cargo-label-empty { color: #888; }

/* 仓位数据 */
.cargo-stats {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cargo-percent {
  font-size: 100rpx;
  font-weight: 900;
  color: #4CAF50;
  line-height: 1;
}

.cargo-title {
  font-size: 28rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 滑块区域 */
.slider-section {
  width: 100%;
  margin-bottom: 50rpx;
}

.slider-ticks {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #666;
}

.cargo-slider {
  width: 100%;
  margin: 16rpx 0;
}

.slider-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #2A2A2A;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ccc;
  border: 2rpx solid #3A3A3A;
  transition: all 0.2s;
}

.quick-btn:active {
  background: #4CAF50;
  color: #fff;
  border-color: #4CAF50;
}

/* 发车按钮 */
.start-btn {
  width: 320rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
  box-shadow: 0 12rpx 40rpx rgba(76,175,80,0.35);
}

.start-btn:active {
  transform: scale(0.95);
  box-shadow: 0 6rpx 20rpx rgba(76,175,80,0.3);
}

.start-icon {
  font-size: 52rpx;
}

.start-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 8rpx;
}

/* ========== 行驶中面板 ========== */
.driving-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.map-area {
  height: 600rpx;
  position: relative;
  background: #222;
}

.nav-map {
  width: 100%;
  height: 100%;
}

/* 速度浮层 */
.speed-overlay {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(0,0,0,0.75);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255,255,255,0.1);
}

.speed-num {
  font-size: 56rpx;
  font-weight: 900;
  color: #4CAF50;
  line-height: 1;
}

.speed-unit {
  font-size: 24rpx;
  color: #999;
}

/* 前方到站卡片 */
.next-stop-card {
  position: absolute;
  bottom: 120rpx;
  left: 24rpx;
  right: 24rpx;
  background: rgba(20,20,20,0.92);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 2rpx solid #FFB74D;
  backdrop-filter: blur(10rpx);
}

.stop-alert-icon {
  font-size: 48rpx;
}

.stop-alert-info {
  flex: 1;
}

.stop-alert-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  display: block;
}

.stop-alert-dist {
  font-size: 28rpx;
  color: #FFB74D;
  display: block;
  margin-top: 4rpx;
}

.stop-alert-task {
  font-size: 26rpx;
  color: #EF5350;
  display: block;
  margin-top: 6rpx;
}

/* 语音播报条 */
.voice-bar {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  right: 24rpx;
  background: rgba(76,175,80,0.15);
  border-radius: 14rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid rgba(76,175,80,0.3);
}

.voice-icon {
  font-size: 32rpx;
}

.voice-content {
  font-size: 26rpx;
  color: #81C784;
  flex: 1;
}

/* ETA信息栏 */
.eta-bar {
  display: flex;
  background: #222;
  padding: 28rpx 32rpx;
  gap: 0;
  border-bottom: 1rpx solid #2A2A2A;
}

.eta-item {
  flex: 1;
  text-align: center;
}

.eta-label {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-bottom: 8rpx;
}

.eta-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  display: block;
}

.eta-value.orange {
  color: #FFB74D;
}

/* ========== 停靠面板 ========== */
.stopped-panel {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 站点横幅 */
.stop-banner {
  text-align: center;
  margin-bottom: 40rpx;
}

.stop-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.stop-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  display: block;
}

.stop-subtitle {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

/* 待装货物 */
.pickup-list {
  width: 100%;
  margin-bottom: 40rpx;
  background: #222;
  border-radius: 20rpx;
  padding: 8rpx 0;
}

.pickup-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid #2A2A2A;
}

.pickup-item:last-child {
  border-bottom: none;
}

.pickup-emoji {
  font-size: 44rpx;
}

.pickup-info {
  flex: 1;
}

.pickup-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.pickup-detail {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.pickup-check {
  font-size: 36rpx;
  color: #555;
}

/* 巨大扫码按钮 */
.scan-btn {
  width: 100%;
  height: 280rpx;
  background: linear-gradient(180deg, #4CAF50, #2E7D32);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  box-shadow: 0 16rpx 48rpx rgba(76,175,80,0.35);
  margin-bottom: 32rpx;
}

.scan-btn:active {
  transform: scale(0.96);
  box-shadow: 0 8rpx 24rpx rgba(76,175,80,0.3);
}

.scan-icon {
  font-size: 64rpx;
}

.scan-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
}

.scan-hint {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.skip-btn {
  font-size: 30rpx;
  color: #666;
  padding: 20rpx;
}

/* 司机信息栏 */
.driver-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 30rpx 0;
  color: rgba(255, 255, 255, 0.85);
}

.driver-emoji {
  font-size: 30rpx;
}

.driver-text {
  font-size: 26rpx;
  font-weight: 600;
}

.driver-plate {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.driver-capacity {
  margin-left: auto;
  font-size: 24rpx;
}

/* 调度任务区 */
.task-list {
  margin: 20rpx 28rpx;
  background: #1E1E1E;
  border-radius: 20rpx;
  padding: 24rpx;
}

.task-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #4CAF50;
  display: block;
  margin-bottom: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.task-station {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.task-action {
  font-size: 24rpx;
  color: #FFB74D;
  background: rgba(255, 183, 77, 0.12);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.task-order {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: auto;
}
