<!-- 司机工作台 - 山乡巴士 · 站牌与车票（司机=行动：陶土橙行动色 + 深绿站牌头） -->
<view class="workbench {{status}} {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- ========== 顶部：深绿站牌头 + 班次山路进度 ========== -->
  <view class="progress-header">
    <view class="header-safe" style="{{headerSafeStyle}}"></view>
    <view class="driver-bar" wx:if="{{driverName}}">
      <view class="driver-chip">
        <icon name="user" size="26" color="#FFFFFF" />
        <text class="driver-text">{{driverName}}</text>
      </view>
      <text class="driver-plate">{{plateNo}}</text>
      <text class="location-source {{locationSource === 'SIMULATED' ? 'sim' : ''}}" wx:if="{{locationSource === 'SIMULATED'}}">模拟运行</text>
      <text class="driver-capacity">货仓 {{cargoLimit}} 件</text>
      <view class="notif-bell" bindtap="goNotifications" hover-class="hover">
        <icon name="notice" size="38" color="#FFFFFF" />
        <view class="notif-badge" wx:if="{{driverUnreadCount > 0}}">{{driverUnreadCount > 99 ? '99+' : driverUnreadCount}}</view>
      </view>
    </view>
    <view class="route-label">
      <text class="route-badge">{{routeName || '今日班次'}}</text>
      <view class="status-tag {{status}}">
        <view wx:if="{{status === 'driving'}}" class="dot-live"></view>
        <text>{{status === 'idle' ? '待发车' : (status === 'driving' ? '行驶中' : '停靠中')}}</text>
      </view>
    </view>

    <!-- 山路进度：虚线道路 + 白色车票圆点 -->
    <view class="progress-bar-wrap">
      <view class="progress-stops">
        <text class="stop-label start">{{startStation}}</text>
        <text class="stop-label end">{{endStation}}</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
        <view class="progress-dot" style="left: {{progressPercent}}%;"></view>
      </view>
      <view class="progress-info" wx:if="{{status === 'driving'}}">
        <text class="next-stop-name">下一站：{{nextStation}}</text>
        <text class="next-stop-dist">约{{nextStationDistance}}m</text>
      </view>
    </view>
  </view>

  <!-- 偏航告警（Phase 9：>100m 只报警，不自动改方案） -->
  <view class="deviation-banner anim-rise" wx:if="{{deviated}}">
    <icon name="info" size="30" color="#C0392B" />
    <text class="deviation-text">偏航提醒：距规划路线约 {{deviationMeters}} 米，请回到计划道路</text>
  </view>

  <!-- 加载失败横幅：网络差时班次/任务拉不下来，给重新加载入口（别让司机对着空页面点不动发车） -->
  <view class="load-error-banner anim-rise" wx:if="{{loadError}}" bindtap="loadAll" hover-class="hover">
    <icon name="info" size="30" color="#C0392B" />
    <text class="load-error-text">网络不太好，班次任务没加载出来</text>
    <text class="load-error-retry">重新加载</text>
  </view>

  <!-- ========== 完整任务段（Phase 8）：今日运营任务路单，车票卡呈现（副券=站点数） ========== -->
  <view class="task-segment-panel" wx:if="{{taskSegment && taskSegment.length}}">
    <view class="panel-header">
      <view class="panel-title-wrap">
        <icon name="list" size="32" color="{{iconDeep}}" />
        <text class="task-segment-title">今日运营任务</text>
      </view>
    </view>
    <view class="task-segment ticket-card anim-rise" wx:for="{{taskSegment}}" wx:key="planId" wx:for-item="seg" style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms">
      <view class="ticket-card__main">
        <view class="ticket-card__serial">任务窗口 {{seg.taskWindowStart || ''}} ~ {{seg.taskWindowEnd || ''}}</view>
        <view class="task-stop" wx:for="{{seg.stops}}" wx:key="index" wx:for-item="stop">
          <view class="task-stop-head">
            <text class="task-stop-name">{{stop.stationName}}</text>
            <text class="task-stop-status">{{stop.statusName}}</text>
          </view>
          <view class="task-action" wx:for="{{stop.actions}}" wx:key="index" wx:for-item="act">
            <text class="task-action-name">{{act.actionName}}</text>
            <text wx:if="{{act.orderNo}}" class="task-action-order" bindlongpress="copyOrderNo" data-no="{{act.orderNo}}">{{act.orderNo}}</text>
            <text wx:if="{{act.quantity}}" class="task-action-qty">×{{act.quantity}}</text>
          </view>
        </view>
      </view>
      <view class="ticket-card__stub">
        <text class="ticket-card__stub-value">{{seg.stops.length}}</text>
        <text class="ticket-card__stub-label">站点</text>
      </view>
    </view>
  </view>

  <!-- ========== 多段联运：换乘交接待确认入口（有才显示） ========== -->
  <view class="handover-entry anim-rise" wx:if="{{pendingHandoverCount > 0}}" bindtap="goHandover" hover-class="hover">
    <view class="handover-entry-iconbox">
      <icon name="send" size="40" color="#FFFFFF" />
    </view>
    <view class="handover-entry-info">
      <text class="handover-entry-title">有 {{pendingHandoverCount}} 个换乘交接待确认</text>
      <text class="handover-entry-sub">点击进入，拍照确认货物交接</text>
    </view>
    <icon name="arrow" size="30" color="{{iconClay}}" />
  </view>

  <!-- ========== 路线站点地图（行驶中显示站点进度） ========== -->
  <view class="route-overview-map" wx:if="{{routeMapMarkers.length > 0}}">
    <view class="map-section-header">
      <view class="panel-title-wrap">
        <icon name="road" size="32" color="{{iconDeep}}" />
        <text class="map-section-title">路线站点地图</text>
      </view>
      <text class="map-section-subtitle">共 {{navTotalStops}} 站</text>
    </view>
    <map
      class="overview-map"
      latitude="{{mapLatitude}}"
      longitude="{{mapLongitude}}"
      markers="{{routeMapMarkers}}"
      polyline="{{routeMapPolyline}}"
      show-location="{{true}}"
      scale="13"
      enable-zoom="{{true}}"
      enable-scroll="{{true}}"
    ></map>
    <!-- 图例（圆点颜色与 js 地图标注色一一对应，勿改） -->
    <view class="map-legend">
      <view class="legend-item">
        <view class="legend-dot passed"></view>
        <text class="legend-text">已过站</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot current"></view>
        <text class="legend-text">当前站</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot next"></view>
        <text class="legend-text">下一站</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot future"></view>
        <text class="legend-text">未到站</text>
      </view>
    </view>
    <!-- 导航按钮 -->
    <view class="map-nav-bar" wx:if="{{nextStation && status !== 'idle'}}" bindtap="navigateToNextStop" hover-class="hover">
      <icon name="road" size="30" color="#FFFFFF" />
      <text class="map-nav-text">导航到 {{nextStation}}</text>
      <text class="map-nav-dist" wx:if="{{nextStationDistance > 0}}">约{{nextStationDistance}}m</text>
    </view>
  </view>

  <!-- ========== 状态一：待发车 - 行李舱可视化 ========== -->
  <view class="idle-panel anim-rise" wx:if="{{status === 'idle'}}">
    <!-- 大巴车行李舱图形 -->
    <view class="cargo-visual">
      <view class="bus-graphic">
        <view class="bus-body">
          <view class="bus-windows">
            <view class="window"></view>
            <view class="window"></view>
            <view class="window"></view>
            <view class="window"></view>
          </view>
          <view class="bus-cargo-area">
            <view class="cargo-fill" style="height: {{cargoCapacity}}%;">
              <view class="cargo-fill-inner"></view>
            </view>
            <view class="cargo-used-mark" style="bottom: {{cargoUsed}}%;"></view>
          </view>
          <view class="bus-wheels">
            <view class="wheel"></view>
            <view class="wheel"></view>
          </view>
        </view>
        <view class="cargo-labels">
          <text class="cargo-label-max">满仓</text>
          <text class="cargo-label-half">50%</text>
          <text class="cargo-label-empty">空仓</text>
        </view>
      </view>

      <!-- 运力数值 -->
      <view class="cargo-stats">
        <text class="cargo-percent">{{cargoCapacity}}%</text>
        <text class="cargo-title">当前空余仓位</text>
      </view>
    </view>

    <!-- 订阅派单通知 -->
    <view class="subscribe-entry" bindtap="subscribeDispatch" hover-class="hover">
      <icon name="notice" size="28" color="{{iconGoldDeep}}" />
      <text>订阅派单通知</text>
    </view>

    <!-- 发车按钮（陶土橙：司机=行动） -->
    <button class="start-btn" bindtap="startDrive" hover-class="hover">
      <icon name="bus" size="52" color="#FFFFFF" />
      <text class="start-text">发 车</text>
    </button>
  </view>

  <!-- ========== 状态二：行驶中 - 导航模式 ========== -->
  <view class="driving-panel" wx:if="{{status === 'driving'}}">
    <!-- 连续任务导航横幅（第 N/总站 · 站名 · 取/派） -->
    <view class="nav-banner" wx:if="{{navTotalStops > 0}}">
      <view class="nav-seq">第 {{navStopIndex}}/{{navTotalStops}} 站</view>
      <view class="nav-station-name">{{navStationName}}</view>
      <view class="nav-actions">
        <text class="nav-chip pickup" wx:if="{{navPickupCount > 0}}">取货 ×{{navPickupCount}}</text>
        <text class="nav-chip deliver" wx:if="{{navDeliverCount > 0}}">派货 ×{{navDeliverCount}}</text>
        <text class="nav-chip board" wx:if="{{navBoardCount > 0}}">接客 ×{{navBoardCount}}</text>
        <text class="nav-chip alight" wx:if="{{navAlightCount > 0}}">送客 ×{{navAlightCount}}</text>
        <text class="nav-chip return" wx:if="{{navActionTotal === 0 && navReturnPoint}}">返场确认</text>
        <text class="nav-chip none" wx:elif="{{navActionTotal === 0}}">经停通过</text>
      </view>
      <view class="nav-amap" wx:if="{{nextStationDistance > 0}}" bindtap="openAmapNav" hover-class="hover">
        <icon name="send" size="24" color="#FFFFFF" />
        <text>导航</text>
      </view>
    </view>

    <!-- 地图区域 -->
    <view class="map-area">
      <map
        class="nav-map"
        latitude="{{mapLatitude}}"
        longitude="{{mapLongitude}}"
        markers="{{markers}}"
        polyline="{{polyline}}"
        show-location="{{true}}"
        scale="14"
      ></map>

      <!-- 速度浮层 -->
      <view class="speed-overlay">
        <text class="speed-num">{{speed}}</text>
        <text class="speed-unit">km/h</text>
      </view>

      <!-- 前方到站提示 -->
      <view class="next-stop-card anim-rise" wx:if="{{nextStationDistance < 1000}}">
        <view class="stop-alert-iconbox">
          <icon name="pin" size="40" color="{{iconClay}}" />
        </view>
        <view class="stop-alert-info">
          <text class="stop-alert-name">{{nextStation}}</text>
          <text class="stop-alert-dist">前方 {{nextStationDistance}}m</text>
          <view class="stop-alert-actions">
            <text class="nav-chip pickup" wx:if="{{navPickupCount > 0}}">取货 ×{{navPickupCount}}</text>
            <text class="nav-chip deliver" wx:if="{{navDeliverCount > 0}}">派货 ×{{navDeliverCount}}</text>
            <text class="nav-chip board" wx:if="{{navBoardCount > 0}}">接客 ×{{navBoardCount}}</text>
            <text class="nav-chip alight" wx:if="{{navAlightCount > 0}}">送客 ×{{navAlightCount}}</text>
          </view>
          <text class="stop-alert-task" wx:if="{{pendingPickups.length > 0}}">
            有 {{pendingPickups.length}} 件货物待装车
          </text>
        </view>
      </view>
    </view>

    <!-- ETA信息 -->
    <view class="eta-bar">
      <view class="eta-item">
        <text class="eta-label">预计到达</text>
        <text class="eta-value">{{eta}}</text>
      </view>
      <view class="eta-item">
        <text class="eta-label">剩余站数</text>
        <text class="eta-value">{{totalStops - currentStopIndex}} 站</text>
      </view>
      <view class="eta-item">
        <text class="eta-label">待装货物</text>
        <text class="eta-value orange">{{pendingPickups.length}} 件</text>
      </view>
    </view>

    <!-- 到站确认按钮 -->
    <button class="arrive-btn {{canArrive ? 'ready' : ''}}" bindtap="arriveAtStation" hover-class="hover">
      <icon name="pin" size="40" color="#FFFFFF" />
      <text class="arrive-text">{{canArrive ? '确认到达 ' + (navStationName || nextStation) : '到达 ' + (navStationName || nextStation || '下一站')}}</text>
    </button>
  </view>

  <!-- ========== 状态三：到站停靠 - 扫码装车 ========== -->
  <view class="stopped-panel" wx:if="{{status === 'stopped'}}">
    <!-- 站点信息 -->
    <view class="stop-banner">
      <view class="stop-iconbox">
        <icon name="pin" size="56" color="#FFFFFF" />
      </view>
      <text class="stop-title">已到达 {{nextStation}}</text>
      <text class="stop-subtitle">请完成装车作业</text>
    </view>

    <!-- 待装货物列表（货运 + 邮快件） -->
    <view class="pickup-list" wx:if="{{pendingPickups.length > 0}}">
      <view class="pickup-item anim-rise" wx:for="{{pendingPickups}}" wx:key="orderId" style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms">
        <view class="pickup-type {{item.bizType === 'PRODUCT' ? 'is-product' : (item.orderType === 3 ? 'is-mail' : 'is-cargo')}}">
          <icon name="{{item.bizType === 'PRODUCT' ? 'shop' : (item.orderType === 3 ? 'box' : 'send')}}" size="34" color="{{item.bizType === 'PRODUCT' ? iconClay : (item.orderType === 3 ? '#B27A12' : iconColor)}}" />
        </view>
        <view class="pickup-info">
          <text class="pickup-name">{{item.bizType === 'PRODUCT' ? (item.goodsName || '商城订单') : (item.orderType === 3 ? (item.mailNo || '快递') : (item.goodsName || '寄货'))}}</text>
          <text wx:if="{{item.bizType === 'PRODUCT'}}" class="pickup-detail">商城订单 · 送至 {{item.receiverAddress || '自提站点'}}（{{item.receiverName || '收件人'}} {{item.receiverMobile || ''}}）</text>
          <text wx:else class="pickup-detail">{{item.weightKg}}kg · {{item.orderType === 3 ? ('取件码 ' + (item.pickupCode || '—')) : (item.receiverName || '待定')}}</text>
          <text class="pickup-detail" bindlongpress="copyOrderNo" data-no="{{item.orderNo}}">{{item.orderNo}}</text>
        </view>
        <view class="pickup-check {{item.checked ? 'checked' : ''}}">
          <view wx:if="{{item.checked}}" class="anim-pop">
            <icon name="check" size="28" color="#FFFFFF" />
          </view>
        </view>
      </view>
    </view>

    <!-- 算法调度任务（算法派单结果，预留区） -->
    <view class="task-list" wx:if="{{tasks.length > 0}}">
      <view class="panel-title-wrap task-list-head">
        <icon name="list" size="30" color="{{iconColor}}" />
        <text class="task-title">调度任务（算法规划）</text>
      </view>
      <view class="task-item anim-rise" wx:for="{{tasks}}" wx:key="id" style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms">
        <text class="task-station">{{item.stationName || '—'}}</text>
        <text class="task-action">{{item.actionName}}</text>
        <text class="task-order" wx:if="{{item.orderNo}}" bindlongpress="copyOrderNo" data-no="{{item.orderNo}}">{{item.orderNo}}</text>
      </view>
    </view>

    <!-- 巨大扫码按钮（主行动：陶土橙） -->
    <button class="scan-btn" bindtap="scanToLoad" hover-class="hover">
      <icon name="qr" size="64" color="#FFFFFF" />
      <text class="scan-text">扫码装车</text>
      <text class="scan-hint">扫寄货单/商城订单二维码，拍照核验后装车</text>
    </button>

    <!-- 妥投扫码 -->
    <button class="scan-btn deliver-btn" bindtap="scanToDeliver" hover-class="hover">
      <icon name="check" size="56" color="#FFFFFF" />
      <text class="scan-text">扫码妥投</text>
      <text class="scan-hint">送达收件人后扫码；商城订单再拍交付凭证</text>
    </button>

    <!-- 取件核销（邮快件） -->
    <button class="scan-btn verify-btn" bindtap="scanToVerify" hover-class="hover">
      <icon name="box" size="56" color="{{iconColor}}" />
      <text class="scan-text">取件核销</text>
      <text class="scan-hint">扫收件人取件码，确认取件</text>
    </button>

    <!-- 跳过 -->
    <view class="skip-btn" bindtap="skipLoading" hover-class="hover">
      <text>跳过，继续行驶 →</text>
    </view>
  </view>

  <!-- ========== 底部自定义TabBar ========== -->
  <driver-tab-bar current="workbench" elderly="{{elderlyMode}}"></driver-tab-bar>
</view>
