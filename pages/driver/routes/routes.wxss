/* 路线页 - 对齐用户端「山乡巴士·站牌与车票」米纸暖色主题 */
.routes-page {
  min-height: 100vh;
  background: var(--color-paper, #F6F2E9);
  color: var(--color-ink, #2B2B28);
  padding-bottom: 140rpx;
}

/* 头部（深站牌绿，与用户端导航一致） */
.page-header {
  background: linear-gradient(180deg, var(--color-primary-dark, #1C4B2E), var(--color-primary, #2E7D32));
  padding: 0 32rpx 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  display: block;
}

.page-date {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  display: block;
  margin-top: 8rpx;
}

/* 路线卡片 */
.route-card {
  margin: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(43, 43, 40, 0.08);
  box-shadow: 0 8rpx 24rpx rgba(43, 43, 40, 0.06);
}

.route-card.running {
  border-color: var(--color-primary, #2E7D32);
}

.route-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.route-card-number {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--color-primary, #2E7D32);
  display: block;
}

.route-card-direction {
  font-size: 26rpx;
  color: var(--color-text-secondary, #6B675C);
  display: block;
  margin-top: 4rpx;
}

.route-card-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.route-card-status.running {
  background: rgba(46, 125, 50, 0.12);
  color: var(--color-primary, #2E7D32);
}

.route-card-status.pending {
  background: rgba(199, 91, 42, 0.12);
  color: var(--color-clay, #C75B2A);
}

.route-card-status.done {
  background: rgba(43, 43, 40, 0.06);
  color: var(--color-text-tertiary, #8A8778);
}

.route-time {
  font-size: 28rpx;
  color: var(--color-text-secondary, #6B675C);
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 30rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(43, 43, 40, 0.08);
}

/* 时间线 —— 山路线：虚线山路 + 站点圆点（路过=站牌绿，当前=陶土橙脉冲） */
.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  position: relative;
  gap: 20rpx;
}

/* 站点间虚线山路（未路过=浅灰虚线，路过=主题强调色虚线） */
.timeline-item::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 48rpx;
  bottom: -18rpx;
  width: 3rpx;
  background: repeating-linear-gradient(180deg, rgba(43, 43, 40, 0.18) 0, rgba(43, 43, 40, 0.18) 8rpx, transparent 8rpx, transparent 14rpx);
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-item.done::before {
  background: repeating-linear-gradient(180deg, var(--color-primary, #2E7D32) 0, var(--color-primary, #2E7D32) 8rpx, transparent 8rpx, transparent 14rpx);
}

/* 站点圆点：路过=实心绿，未到=空心浅灰，当前=陶土橙带脉冲 */
.timeline-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 3rpx solid rgba(43, 43, 40, 0.25);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}

.timeline-item.done .timeline-dot {
  background: var(--color-primary, #2E7D32);
  border-color: var(--color-primary, #2E7D32);
}

.timeline-item.current .timeline-dot {
  background: var(--color-clay, #C75B2A);
  border-color: var(--color-clay, #C75B2A);
  box-shadow: 0 0 0 8rpx rgba(199, 91, 42, 0.16);
  animation: station-pulse 1.8s ease-in-out infinite;
}

@keyframes station-pulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(199, 91, 42, 0.14); }
  50% { box-shadow: 0 0 0 12rpx rgba(199, 91, 42, 0.04); }
}

.dot-inner {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffffff;
}

.timeline-name {
  font-size: 28rpx;
  color: var(--color-text-tertiary, #8A8778);
  flex: 1;
}

.timeline-item.done .timeline-name {
  color: var(--color-text-secondary, #6B675C);
}

.timeline-item.current .timeline-name {
  color: var(--color-ink, #2B2B28);
  font-weight: 700;
  font-size: 32rpx;
}

.timeline-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(199, 91, 42, 0.12);
  color: var(--color-clay, #C75B2A);
}

.timeline-tag.end {
  background: rgba(192, 57, 43, 0.1);
  color: #C0392B;
}

.timeline-tag.current-tag {
  background: rgba(199, 91, 42, 0.2);
  color: var(--color-clay, #C75B2A);
  font-weight: 700;
}

/* ============ 老年人模式：司机端路线页字号放大 ============ */
.elderly-mode .page-title { font-size: 52rpx; }
.elderly-mode .page-date { font-size: 30rpx; }
.elderly-mode .route-card-number { font-size: 50rpx; }
.elderly-mode .route-card-direction { font-size: 32rpx; }
.elderly-mode .route-card-status { font-size: 28rpx; }
.elderly-mode .route-time { font-size: 34rpx; }
.elderly-mode .timeline-name { font-size: 34rpx; }
.elderly-mode .timeline-tag { font-size: 24rpx; }


/* ========== 路线地图 ========== */
.route-map-section {
  margin-top: 24rpx;
  border-top: 1rpx solid rgba(43, 43, 40, 0.08);
  padding-top: 20rpx;
}

.route-map-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  background: rgba(46, 125, 50, 0.06);
  border-radius: 12rpx;
}

.route-map-toggle.hover {
  background: rgba(46, 125, 50, 0.12);
}

.route-map-toggle-icon {
  font-size: 24rpx;
  color: var(--color-primary, #2E7D32);
}

.route-map-toggle-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary, #2E7D32);
}

.route-map-container {
  margin-top: 16rpx;
}

.route-map {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.route-map-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #2E7D32 0%, #43A047 100%);
  border-radius: 14rpx;
}

.route-map-nav.hover {
  opacity: 0.85;
}

.route-map-nav-icon {
  font-size: 30rpx;
}

.route-map-nav-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 老年人模式 */
.elderly-mode .route-map-toggle-text { font-size: 34rpx; }
.elderly-mode .route-map { height: 380rpx; }
.elderly-mode .route-map-nav-text { font-size: 34rpx; }

