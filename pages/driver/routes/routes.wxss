/* 路线页 - 暗黑主题 */
.routes-page {
  min-height: 100vh;
  background: #1A1A1A;
  color: #fff;
  padding-bottom: 140rpx;
}

/* 头部 */
.page-header {
  background: linear-gradient(180deg, #0D0D0D, #1A1A1A);
  padding: 0 32rpx 32rpx;
  border-bottom: 1rpx solid #2A2A2A;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  display: block;
}

.page-date {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-top: 8rpx;
}

/* 路线卡片 */
.route-card {
  margin: 24rpx;
  background: #222;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #2A2A2A;
}

.route-card.running {
  border-color: rgba(111,191,122,0.3);
}

.route-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.route-card-number {
  font-size: 42rpx;
  font-weight: 800;
  color: #6FBF7A;
  display: block;
}

.route-card-direction {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.route-card-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.route-card-status.running {
  background: rgba(111,191,122,0.18);
  color: #8FE09A;
}

.route-card-status.pending {
  background: rgba(224,122,63,0.18);
  color: #E8925B;
}

.route-time {
  font-size: 28rpx;
  color: #ccc;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 30rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #2A2A2A;
}

/* 时间线 —— 山路线：虚线山路 + 站点圆点（路过=绿，当前=陶土橙脉冲） */
.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  position: relative;
  gap: 20rpx;
}

/* 站点间虚线山路（未路过=暗灰虚线，路过=新芽绿虚线） */
.timeline-item::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 48rpx;
  bottom: -18rpx;
  width: 3rpx;
  background: repeating-linear-gradient(180deg, #444 0, #444 8rpx, transparent 8rpx, transparent 14rpx);
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-item.done::before {
  background: repeating-linear-gradient(180deg, #6FBF7A 0, #6FBF7A 8rpx, transparent 8rpx, transparent 14rpx);
}

/* 站点圆点：路过=实心绿，未到=空心暗，当前=陶土橙带脉冲 */
.timeline-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #222;
  border: 3rpx solid #555;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}

.timeline-item.done .timeline-dot {
  background: #6FBF7A;
  border-color: #6FBF7A;
}

.timeline-item.current .timeline-dot {
  background: #E07A3F;
  border-color: #E07A3F;
  box-shadow: 0 0 0 8rpx rgba(224, 122, 63, 0.18);
  animation: station-pulse 1.8s ease-in-out infinite;
}

@keyframes station-pulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(224, 122, 63, 0.16); }
  50% { box-shadow: 0 0 0 12rpx rgba(224, 122, 63, 0.05); }
}

.dot-inner {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1A1A1A;
}

.timeline-name {
  font-size: 28rpx;
  color: #999;
  flex: 1;
}

.timeline-item.done .timeline-name {
  color: #ccc;
}

.timeline-item.current .timeline-name {
  color: #fff;
  font-weight: 700;
  font-size: 32rpx;
}

.timeline-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(224,122,63,0.2);
  color: #E8925B;
}

.timeline-tag.end {
  background: rgba(255,82,82,0.2);
  color: #EF5350;
}

.timeline-tag.current-tag {
  background: rgba(224,122,63,0.28);
  color: #F0A06C;
  font-weight: 700;
}
