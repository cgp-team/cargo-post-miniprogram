/* 路线页 - 对齐用户端「山乡巴士·站牌与车票」米纸暖色主题 */
.routes-page {
  min-height: 100vh;
  background: var(--color-paper);
  color: var(--color-ink);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 头部站牌：深绿实板 + 落款横档 + 装饰光晕（与司机工作台一致） */
.page-header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  padding: 0 32rpx 40rpx;
}

/* 顶部落款横档（站牌金属边） */
.page-header::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 30rpx;
  right: 30rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

/* 装饰光晕 */
.page-header::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.header-safe {
  width: 100%;
}

.page-title-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.page-date {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  display: block;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

/* 右上角身份角标（站牌线路号位） */
.header-badge {
  position: absolute;
  bottom: 40rpx;
  right: 32rpx;
  z-index: 2;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

/* 班次卡：暖白票面 + 柔和阴影 */
.route-card {
  margin: 24rpx;
  background: #FFFDF8;
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

/* 进行中的班次描一圈主题绿 */
.route-card.running {
  box-shadow: var(--shadow-card), inset 0 0 0 2rpx var(--color-primary);
}

.route-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.route-card-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

/* 线路 chip：绿底白巴士，似站牌上的路线角标 */
.route-line-chip {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  box-shadow: 0 6rpx 16rpx var(--color-primary-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.route-card-title {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.route-card-number {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: 1rpx;
}

.route-card-direction {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

/* 状态胶囊：圆角 999、语义浅底深字；进行中带呼吸点 */
.route-card-status {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  font-weight: 600;
}

.route-card-status.running {
  position: relative;
  background: var(--color-primary-light);
  color: var(--color-primary);
  padding-left: 36rpx;
}

.route-card-status.running::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  background: var(--color-accent);
  border-radius: 50%;
  animation: status-pulse 1.5s ease-in-out infinite;
}

@keyframes status-pulse {
  0%, 100% { opacity: 1; transform: translateY(-50%) scale(1); }
  50% { opacity: 0.5; transform: translateY(-50%) scale(1.3); }
}

.route-card-status.pending {
  background: rgba(199, 91, 42, 0.12);
  color: var(--color-clay);
}

.route-card-status.done {
  background: rgba(43, 43, 40, 0.06);
  color: var(--color-text-tertiary);
}

.route-time {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 26rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #F0E8D5;
}

/* 时间线 —— 山路线：竖向虚线山路 + 站点圆点（路过=站牌绿，当前=陶土橙脉冲） */
.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  position: relative;
  gap: 20rpx;
}

/* 站点间虚线山路（未路过=暖灰虚线，路过=主题绿虚线） */
.timeline-item::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 48rpx;
  bottom: -18rpx;
  width: 3rpx;
  background: repeating-linear-gradient(180deg, #D8D2C4 0, #D8D2C4 8rpx, transparent 8rpx, transparent 14rpx);
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-item.done::before {
  background: repeating-linear-gradient(180deg, var(--color-primary) 0, var(--color-primary) 8rpx, transparent 8rpx, transparent 14rpx);
}

/* 站点圆点：路过=实心绿，未到=空心浅灰，当前=陶土橙带脉冲 */
.timeline-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 3rpx solid #C9C2B0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}

.timeline-item.done .timeline-dot {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.timeline-item.current .timeline-dot {
  background: var(--color-clay);
  border-color: var(--color-clay);
  box-shadow: 0 0 0 8rpx rgba(199, 91, 42, 0.16);
  animation: station-pulse 1.8s ease-in-out infinite;
}

@keyframes station-pulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(199, 91, 42, 0.14); }
  50% { box-shadow: 0 0 0 12rpx rgba(199, 91, 42, 0.04); }
}

.dot-inner {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffffff;
}

.timeline-name {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  flex: 1;
}

.timeline-item.done .timeline-name {
  color: var(--color-text-secondary);
}

.timeline-item.current .timeline-name {
  color: var(--color-ink);
  font-weight: 700;
  font-size: 32rpx;
}

/* 站点标签：始发=浅绿底深绿字，终点=浅橙底陶土字，当前=陶土实底白字 */
.timeline-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

.timeline-tag.end {
  background: rgba(199, 91, 42, 0.10);
  color: var(--color-clay);
}

.timeline-tag.current-tag {
  background: var(--color-clay);
  color: #ffffff;
}

/* ========== 路线地图 ========== */
.route-map-section {
  margin-top: 24rpx;
  border-top: 1rpx solid #F0E8D5;
  padding-top: 20rpx;
}

.route-map-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius-pill);
}

.route-map-toggle-icon {
  font-size: 24rpx;
  color: var(--color-primary);
}

.route-map-toggle-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.route-map-container {
  margin-top: 16rpx;
}

.route-map {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 导航按钮：陶土橙行动按钮（司机行动色） */
.route-map-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, var(--color-clay), #A64A1F);
  border-radius: 14rpx;
  box-shadow: 0 6rpx 16rpx rgba(199, 91, 42, 0.24);
}

.route-map-nav-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ============ 老年人模式：司机端路线页字号放大 ============ */
.elderly-mode .page-title { font-size: 52rpx; }
.elderly-mode .page-date { font-size: 30rpx; }
.elderly-mode .header-badge { font-size: 24rpx; }
.elderly-mode .route-line-chip { width: 84rpx; height: 84rpx; }
.elderly-mode .route-card-number { font-size: 50rpx; }
.elderly-mode .route-card-direction { font-size: 32rpx; }
.elderly-mode .route-card-status { font-size: 28rpx; }
.elderly-mode .route-time { font-size: 34rpx; }
.elderly-mode .timeline-name { font-size: 34rpx; }
.elderly-mode .timeline-tag { font-size: 24rpx; }
.elderly-mode .route-map-toggle-text { font-size: 34rpx; }
.elderly-mode .route-map { height: 380rpx; }
.elderly-mode .route-map-nav-text { font-size: 34rpx; }
