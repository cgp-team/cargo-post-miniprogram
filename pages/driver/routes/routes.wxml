<!-- 司机路线页 -->
<view class="routes-page {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- 顶部站牌头（深绿实板 + 落款横档，与工作台一致） -->
  <view class="page-header">
    <view class="header-safe" style="height: {{statusBarHeight}}px;"></view>
    <view class="page-title-row">
      <icon name="road" size="40" color="#FFFFFF" />
      <text class="page-title">我的路线</text>
    </view>
    <text class="page-date">今日排班</text>
    <text class="header-badge">司机端</text>
  </view>

  <!-- 班次卡：线路 chip + 竖向山路时间线 -->
  <view class="route-card {{item.status}} anim-rise" wx:for="{{todayRoutes}}" wx:key="id" style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms">
    <!-- 路线头部 -->
    <view class="route-card-header">
      <view class="route-card-left">
        <view class="route-line-chip">
          <icon name="bus" size="34" color="#FFFFFF" />
        </view>
        <view class="route-card-title">
          <text class="route-card-number">{{item.routeNumber}}</text>
          <text class="route-card-direction">{{item.direction}}</text>
        </view>
      </view>
      <view class="route-card-status {{item.status}}">
        <view wx:if="{{item.status === 'running'}}" class="dot-live"></view>
        {{item.statusText}}
      </view>
    </view>

    <!-- 发车时间 -->
    <view class="route-time">
      <icon name="clock" size="28" color="#8A8778" />
      <text>{{item.time}}</text>
    </view>

    <!-- 站点时间线 -->
    <view class="timeline">
      <view
        class="timeline-item {{index === item.currentStop ? 'current' : ''}} {{index < item.currentStop ? 'done' : ''}}"
        wx:for="{{item.stopNames}}"
        wx:key="*this"
        wx:for-item="stop"
        wx:for-index="index"
      >
        <view class="timeline-dot">
          <view class="dot-inner"></view>
        </view>
        <text class="timeline-name">{{stop}}</text>
        <text class="timeline-tag" wx:if="{{index === 0}}">始发</text>
        <text class="timeline-tag end" wx:if="{{index === item.stopNames.length - 1}}">终点</text>
        <text class="timeline-tag current-tag" wx:if="{{index === item.currentStop}}">当前</text>
      </view>
    </view>

    <!-- 路线地图 -->
    <view class="route-map-section" wx:if="{{item.hasMap}}">
      <view class="route-map-toggle" bindtap="toggleRouteMap" data-id="{{item.id}}" hover-class="hover">
        <text class="route-map-toggle-icon">{{item.showMap ? '▼' : '▶'}}</text>
        <text class="route-map-toggle-text">{{item.showMap ? '收起地图' : '查看地图'}}</text>
      </view>
      <view class="route-map-container" wx:if="{{item.showMap}}">
        <map
          class="route-map"
          latitude="{{item.mapCenter.latitude}}"
          longitude="{{item.mapCenter.longitude}}"
          markers="{{item.mapMarkers}}"
          polyline="{{item.mapPolyline}}"
          include-points="{{item.mapPoints}}"
          padding="{{[60, 40, 50, 40]}}"
          show-location="{{false}}"
          enable-zoom="{{true}}"
          enable-scroll="{{true}}"
        ></map>
        <!-- 导航按钮（陶土橙行动按钮） -->
        <view class="route-map-nav" wx:if="{{item.status === 'running'}}" bindtap="navigateRoute" data-id="{{item.id}}" hover-class="hover">
          <icon name="send" size="30" color="#FFFFFF" />
          <text class="route-map-nav-text">导航到下一站</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载骨架（仿班次卡轮廓）/ 错误态 / 空态 -->
  <view wx:if="{{loading}}">
    <view class="skeleton-card" wx:for="{{[1, 2]}}" wx:key="*this">
      <view class="sk-head">
        <view class="skeleton sk-chip"></view>
        <view class="sk-head-mid">
          <view class="skeleton sk-title"></view>
          <view class="skeleton sk-sub"></view>
        </view>
        <view class="skeleton sk-pill"></view>
      </view>
      <view class="skeleton sk-line w90"></view>
      <view class="skeleton sk-line w70"></view>
      <view class="skeleton sk-line w55"></view>
    </view>
  </view>
  <empty-state wx:elif="{{hasError}}" icon="bus" text="网络不太好，班次没加载出来" btnText="重新加载" bind:tapbtn="loadRoutes" />
  <empty-state wx:elif="{{loaded && !todayRoutes.length}}" icon="bus" text="今日暂无班次" subText="新的排班会显示在这里" />

  <!-- 底部TabBar -->
  <driver-tab-bar current="routes" elderly="{{elderlyMode}}"></driver-tab-bar>
</view>
