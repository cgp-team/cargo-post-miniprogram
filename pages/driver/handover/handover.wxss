/* 交接页 - 对齐「山乡巴士·站牌与车票」米纸暖色主题（陶土橙行动色 + 深绿头部） */
.handover-page {
  min-height: 100vh;
  background: var(--color-paper);
  color: var(--color-ink);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 站牌式页头：深绿实板 + 落款横档 + 装饰光晕，与默认导航栏同色衔接 */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  padding: 36rpx 32rpx 44rpx;
}

.hero::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 30rpx;
  right: 30rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

.hero::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-title-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.hero-sub {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.5;
}

/* 分区标题：图标 + 深绿字（与路线/收益页同一节奏） */
.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 32rpx 28rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 0.5rpx;
}

/* ==================== 当前运输段任务卡（陶土橙描边 = 待行动） ==================== */
.current-leg {
  margin: 24rpx;
  background: #FFFDF8;
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-card), inset 0 0 0 2rpx var(--color-clay);
}

.cl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cl-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-ink);
}

/* 当前任务状态：陶土实底胶囊，最抢眼 */
.cl-status {
  font-size: 22rpx;
  color: #ffffff;
  background: var(--color-clay);
  border-radius: var(--radius-pill);
  padding: 6rpx 18rpx;
  font-weight: 600;
  white-space: nowrap;
}

.cl-route-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.cl-route {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
  word-break: break-word;
}

.cl-meta {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.cl-eta {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.cl-est {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.cl-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 段操作按钮：陶土橙行动按钮 */
.cl-btn {
  flex: 1 1 40%;
  min-width: 240rpx;
  height: 84rpx;
  /* view 当按钮：文字必须水平垂直居中且不溢出 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  box-sizing: border-box;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
  border-radius: 14rpx;
  background: linear-gradient(135deg, var(--color-clay), #A64A1F);
  box-shadow: 0 6rpx 16rpx rgba(199, 91, 42, 0.22);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

/* ==================== 待交接清单：可勾选感卡片行 ==================== */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 0 24rpx;
}

.ho-card {
  background: #FFFDF8;
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.ho-main {
  display: flex;
  gap: 20rpx;
}

/* 勾选圈：陶土橙描边 + 对勾，清单待勾语感 */
.ho-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-clay);
  background: rgba(199, 91, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.ho-body {
  flex: 1;
  min-width: 0;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-no {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 60%;
}

/* 待交接状态：浅橙底陶土字胶囊（待处理语义） */
.status {
  font-size: 22rpx;
  color: var(--color-clay);
  background: rgba(199, 91, 42, 0.10);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  font-weight: 600;
  flex-shrink: 0;
}

.goods {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.label {
  color: var(--color-text-tertiary);
}

.value {
  color: var(--color-ink);
  max-width: 60%;
  text-align: right;
  word-break: break-all;
}

/* 确认按钮：全局 .btn-orange + 相机图标居中 */
.ho-confirm {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

/* ==================== 我的运输段 ==================== */
.leg-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 0 24rpx;
}

.leg {
  background: #FFFDF8;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.leg-progress {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.leg-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.leg-status {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-weight: 600;
}

.leg-eta {
  color: var(--color-text-secondary);
}

.leg-plate {
  color: var(--color-text-tertiary);
}

/* ============ 老年人模式：交接页字号放大 ============ */
.elderly-mode .hero-title { font-size: 52rpx; }
.elderly-mode .hero-sub { font-size: 30rpx; }
.elderly-mode .section-title { font-size: 38rpx; }
.elderly-mode .cl-title { font-size: 38rpx; }
.elderly-mode .cl-status { font-size: 26rpx; }
.elderly-mode .cl-route { font-size: 36rpx; }
.elderly-mode .cl-meta,
.elderly-mode .cl-eta { font-size: 30rpx; }
.elderly-mode .cl-est { font-size: 26rpx; }
.elderly-mode .cl-btn { font-size: 36rpx; height: 96rpx; }
.elderly-mode .ho-check { width: 60rpx; height: 60rpx; }
.elderly-mode .order-no,
.elderly-mode .goods,
.elderly-mode .row { font-size: 34rpx; }
.elderly-mode .status { font-size: 26rpx; }
.elderly-mode .leg-progress { font-size: 36rpx; }
.elderly-mode .leg-meta { font-size: 28rpx; }
.elderly-mode .leg-status { font-size: 26rpx; }
