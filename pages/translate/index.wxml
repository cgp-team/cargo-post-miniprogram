<!-- 面对面翻译 - 长按说话，自动中英互译 -->
<view class="page-translate {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">

  <view class="translate-tip">
    <text class="tip-emoji">🌐</text>
    <text class="tip-text">两人各按住一个按钮说话，说完自动翻译给对方</text>
  </view>

  <!-- 对话列表 -->
  <scroll-view scroll-y class="translate-list">
    <view wx:if="{{dialogList.length === 0}}" class="empty-state">
      <text class="empty-emoji">💬</text>
      <text class="empty-text">按住下方按钮开始对话</text>
    </view>
    <view wx:for="{{dialogList}}" wx:key="index" class="dialog-item {{item.role === 'zh' ? 'from-zh' : 'from-en'}}">
      <view class="dialog-bubble">
        <text class="dialog-lang">{{item.role === 'zh' ? '中文' : 'English'}}</text>
        <text class="dialog-src">{{item.src}}</text>
        <text class="dialog-arrow">↓</text>
        <text class="dialog-dst">{{item.dst}}</text>
      </view>
      <text class="dialog-time">{{item.time}}</text>
    </view>
  </scroll-view>

  <!-- 底部操作区 -->
  <view class="translate-bottom">
    <button
      class="talk-btn btn-zh {{recording && voiceLang === 'zh' ? 'recording' : ''}}"
      bindtouchstart="startRecord" data-lang="zh"
      bindtouchend="stopRecord" bindtouchcancel="stopRecord"
      hover-class="none"
    >🎤 说中文</button>
    <button
      class="talk-btn btn-en {{recording && voiceLang === 'en' ? 'recording' : ''}}"
      bindtouchstart="startRecord" data-lang="en"
      bindtouchend="stopRecord" bindtouchcancel="stopRecord"
      hover-class="none"
    >🎤 English</button>
    <view class="bottom-actions">
      <button class="clear-btn" bindtap="clearDialog" wx:if="{{dialogList.length > 0}}">清空</button>
      <text class="recording-tip" wx:if="{{recording}}">正在聆听…松开结束</text>
    </view>
  </view>

</view>
