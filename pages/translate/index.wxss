/* 面对面翻译页 */
.page-translate {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-paper);
  padding: 20rpx;
  box-sizing: border-box;
}

/* 顶部提示 */
.translate-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--color-primary-light);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.tip-emoji { font-size: 36rpx; }
.tip-text { font-size: 26rpx; color: var(--color-ink); flex: 1; }

/* 对话列表 */
.translate-list {
  flex: 1;
  min-height: 0;
  padding: 4rpx 4rpx 20rpx;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  color: #999;
}
.empty-emoji { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; }

.dialog-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}
.from-zh .dialog-bubble {
  align-self: flex-start;
  background: #fff;
  border-left: 8rpx solid var(--color-primary);
}
.from-en .dialog-bubble {
  align-self: flex-end;
  background: #fff;
  border-right: 8rpx solid var(--color-clay);
  text-align: right;
}
.dialog-bubble {
  max-width: 85%;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
}
.dialog-lang {
  font-size: 22rpx;
  color: var(--color-clay);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.dialog-src {
  font-size: 30rpx;
  color: var(--color-ink);
  line-height: 1.5;
}
.dialog-arrow { font-size: 24rpx; color: #ccc; margin: 8rpx 0; }
.dialog-dst {
  font-size: 30rpx;
  color: var(--color-primary-dark);
  font-weight: 600;
  line-height: 1.5;
}
.dialog-time { font-size: 20rpx; color: #bbb; margin-top: 6rpx; }

/* 底部按钮 */
.translate-bottom {
  border-top: 2rpx solid rgba(0,0,0,0.06);
  padding-top: 20rpx;
}
.talk-btn {
  width: 100%;
  margin-bottom: 16rpx;
  border: none;
  border-radius: 16rpx;
  padding: 30rpx 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
  text-align: center;
}
.talk-btn::after { border: none; }
.btn-zh { background: var(--color-primary); }
.btn-en { background: var(--color-clay); }
.talk-btn.recording {
  transform: scale(0.98);
  box-shadow: 0 0 0 8rpx var(--color-primary-light);
  animation: talk-pulse 1s ease-in-out infinite;
}
@keyframes talk-pulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(0,0,0,0.08); }
  50% { box-shadow: 0 0 0 14rpx rgba(0,0,0,0.02); }
}
.bottom-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 8rpx;
}
.clear-btn {
  font-size: 26rpx;
  color: #999;
  background: transparent;
  border: none;
  padding: 8rpx 20rpx;
}
.clear-btn::after { border: none; }
.recording-tip { font-size: 24rpx; color: var(--color-primary); }

/* 老年模式 */
.elderly-mode .talk-btn { font-size: 40rpx; padding: 36rpx 0; }
.elderly-mode .dialog-src, .elderly-mode .dialog-dst { font-size: 34rpx; }
.elderly-mode .tip-text { font-size: 30rpx; }
