/* 设置页样式 */
.page-settings {
  min-height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 头部站牌带：深绿渐变，与主题导航栏无缝衔接 */
.page-head {
  position: relative;
  overflow: hidden;
  padding: 28rpx 28rpx 32rpx;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
}

/* 顶部落款横档（站牌金属边） */
.page-head::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 28rpx;
  right: 28rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

.page-head::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.head-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.head-sub {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
}

/* 分组小标题：图标 + 深绿字 */
.section-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--color-primary-dark);
  font-weight: 700;
  margin: 32rpx 28rpx 16rpx;
  padding: 0 4rpx;
}

/* 分组卡片：圆角卡片 + 行间 1rpx 分隔线 */
.group-card {
  margin: 0 24rpx;
  background: #FFFDF8;
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.group-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
}

.group-row + .group-row {
  border-top: 1rpx solid #F0EADB;
}

/* 行首图标 chip */
.row-icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.row-name {
  font-size: 30rpx;
  color: var(--color-ink);
  font-weight: 600;
}

.row-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 自定义开关：右对齐，开=主题绿 */
.toggle-switch {
  flex-shrink: 0;
  width: 96rpx;
  height: 54rpx;
  border-radius: 27rpx;
  transition: background 0.25s;
  position: relative;
}
.toggle-switch.off { background: #D8D2C4; }
.toggle-switch.on { background: var(--color-primary); }
.toggle-knob {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #ffffff;
  position: absolute;
  top: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: left 0.25s;
}
.toggle-switch.off .toggle-knob { left: 4rpx; }
.toggle-switch.on .toggle-knob { left: 46rpx; }

/* 主题行：选中行浅绿底 + 色点打勾 */
.theme-row.active {
  background: var(--color-primary-light);
}

.theme-dot {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.35), 0 2rpx 8rpx rgba(60, 50, 30, 0.10);
}

.theme-current {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: #ffffff;
  border: 1rpx solid var(--color-primary);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
}

/* ============ 老年人模式：设置页字体放大 ============ */
.elderly-mode .head-title { font-size: 44rpx; }
.elderly-mode .head-sub { font-size: 28rpx; }
.elderly-mode .section-label { font-size: 30rpx; }
.elderly-mode .row-name { font-size: 34rpx; }
.elderly-mode .row-desc { font-size: 28rpx; }
.elderly-mode .theme-current { font-size: 26rpx; }
.elderly-mode .row-icon { width: 88rpx; height: 88rpx; }
.elderly-mode .toggle-switch { width: 108rpx; height: 60rpx; border-radius: 30rpx; }
.elderly-mode .toggle-knob { width: 52rpx; height: 52rpx; }
.elderly-mode .toggle-switch.on .toggle-knob { left: 52rpx; }
