.page-settings { min-height: 100vh; background: #F5F5F5; padding: 24rpx 28rpx; }

.section-label { font-size: 26rpx; color: #757575; font-weight: 600; margin: 30rpx 0 16rpx; padding-left: 8rpx; }
.section-label:first-child { margin-top: 8rpx; }

/* 开关行 */
.setting-item {
  background: #fff; border-radius: 20rpx; padding: 28rpx;
  display: flex; justify-content: space-between; align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.setting-left { display: flex; align-items: center; gap: 18rpx; flex: 1; }
.setting-emoji { font-size: 44rpx; }
.setting-info { display: flex; flex-direction: column; gap: 6rpx; }
.setting-name { font-size: 30rpx; color: #333; font-weight: 600; }
.setting-desc { font-size: 24rpx; color: #757575; }

/* 自定义开关 */
.toggle-switch {
  width: 96rpx; height: 54rpx; border-radius: 27rpx;
  transition: background 0.25s; position: relative; flex-shrink: 0;
}
.toggle-switch.off { background: #DDD; }
.toggle-switch.on { background: var(--color-accent); }
.toggle-knob {
  width: 46rpx; height: 46rpx; border-radius: 50%; background: #fff;
  position: absolute; top: 4rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  transition: left 0.25s;
}
.toggle-switch.off .toggle-knob { left: 4rpx; }
.toggle-switch.on .toggle-knob { left: 46rpx; }

/* 主题行 */
.theme-row {
  background: #fff; border-radius: 20rpx; padding: 26rpx 28rpx;
  display: flex; align-items: center; gap: 20rpx; margin-bottom: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border: 3rpx solid transparent; transition: all 0.15s ease;
}
.theme-row.active { border-color: var(--color-primary); box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.10); }
.theme-dot {
  width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.theme-check { color: #fff; font-size: 36rpx; font-weight: 700; }
.theme-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.theme-name { font-size: 30rpx; color: #333; font-weight: 600; }
.theme-desc { font-size: 24rpx; color: #757575; }
.theme-radio {
  width: 36rpx; height: 36rpx; border-radius: 50%; background: var(--color-primary);
  border: 3rpx solid #fff; box-shadow: 0 0 0 3rpx var(--color-primary);
}

/* ============ 老年人模式：设置页字体放大 ============ */
.elderly-mode .section-label { font-size: 30rpx; }
.elderly-mode .setting-name { font-size: 34rpx; }
.elderly-mode .setting-desc { font-size: 28rpx; }
.elderly-mode .theme-name { font-size: 34rpx; }
.elderly-mode .theme-desc { font-size: 28rpx; }
