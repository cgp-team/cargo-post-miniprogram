<!-- 设置页 -->
<view class="page-settings {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- 头部站牌带：与导航栏同色衔接 -->
  <view class="page-head">
    <view class="head-row">
      <icon name="gear" size="40" color="#FFFFFF" />
      <text class="head-title">设置</text>
    </view>
    <text class="head-sub">字体与主题颜色，全端即时生效</text>
  </view>

  <!-- 显示设置 -->
  <view class="section-label">
    <icon name="font" size="28" color="{{iconDeep}}" />
    <text>显示设置</text>
  </view>
  <view class="group-card">
    <view class="group-row" bindtap="toggleElderly" hover-class="hover">
      <view class="row-icon"><icon name="font" size="38" color="{{iconColor}}" /></view>
      <view class="row-info">
        <text class="row-name">老年人模式</text>
        <text class="row-desc">更大字体、更大按钮，方便长辈使用</text>
      </view>
      <view class="toggle-switch {{elderlyMode ? 'on' : 'off'}}">
        <view class="toggle-knob"></view>
      </view>
    </view>
  </view>

  <!-- 主题颜色 -->
  <view class="section-label">
    <icon name="sun" size="28" color="{{iconDeep}}" />
    <text>主题颜色</text>
  </view>
  <view class="group-card">
    <view
      wx:for="{{themeList}}"
      wx:key="key"
      class="group-row theme-row anim-rise {{themeColor === item.key ? 'active' : ''}}"
      style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms"
      data-key="{{item.key}}"
      bindtap="switchTheme" hover-class="hover"
    >
      <view class="theme-dot" style="background: {{item.color}}">
        <view wx:if="{{themeColor === item.key}}" class="anim-pop">
          <icon name="check" size="34" color="#FFFFFF" />
        </view>
      </view>
      <view class="row-info">
        <text class="row-name">{{item.name}}</text>
        <text class="row-desc">{{item.desc}}</text>
      </view>
      <text wx:if="{{themeColor === item.key}}" class="theme-current">使用中</text>
    </view>
  </view>
</view>
