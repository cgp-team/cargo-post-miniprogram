<!-- 寄货/包裹追踪页 -->
<view class="page-parcel {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- 顶部栏 -->
  <view class="top-bar" style="padding-top: {{statusBarHeight + 16}}px">
    <view class="top-bar-main">
      <view class="location-info" bindtap="switchVillage" hover-class="hover">
        <text class="loc-emoji">📌</text>
        <text class="village-name">{{currentVillage}}</text>
        <text class="arrow-down">▾</text>
      </view>
      <text class="header-title">包裹</text>
      <view class="user-avatar">
        <text>{{userInfo.nickname || '👤'}}</text>
      </view>
    </view>

    <!-- 单号查询 -->
    <view class="search-bar">
      <text class="search-emoji">📦</text>
      <input
        class="search-input"
        type="text"
        value="{{trackingNo}}"
        placeholder="输入运单号查询物流"
        bindinput="onTrackingInput"
        confirm-type="search"
        bindconfirm="searchParcel"
      />
      <view class="search-btn" bindtap="searchParcel" hover-class="hover">查询</view>
    </view>
  </view>

  <!-- 乘车安排（村民到站通知：客运订单已派车，含车辆与实时位置入口） -->
  <view wx:if="{{arrangements.length}}" class="arrange-section">
    <view class="arrange-header">
      <text class="arrange-title">🚌 我的乘车安排</text>
      <text class="arrange-sub" bindtap="goToBusTracking">实时公交 ›</text>
    </view>
    <view class="arrange-card" wx:for="{{arrangements}}" wx:key="orderId">
      <view class="arrange-route">
        <view class="arrange-station">
          <text class="station-name">{{item.boardingStationName || '—'}}</text>
          <text class="station-label">上车站</text>
        </view>
        <view class="arrange-mid">
          <view class="mid-line"></view>
          <text class="mid-bus">🚌</text>
        </view>
        <view class="arrange-station">
          <text class="station-name">{{item.alightingStationName || '—'}}</text>
          <text class="station-label">下车站</text>
        </view>
      </view>
      <view class="arrange-footer">
        <text class="arrange-no">{{item.orderNo}} · {{item.vehiclePlateNo || '待派车'}}</text>
        <text class="arrange-status {{item.planStatus === 1 || item.planStatus === 2 ? 'live' : ''}}">
          {{item.planStatus === 1 || item.planStatus === 2 ? '在途' : item.statusName}}
        </text>
      </view>
      <view class="arrange-cta" bindtap="goToBusTracking">📍 查看车辆实时位置 ›</view>
    </view>
  </view>

  <!-- 状态切换 -->
  <view class="tab-row">
    <view
      class="tab-item {{activeTab === 0 ? 'active' : ''}}"
      data-index="{{0}}"
      bindtap="switchTab" hover-class="hover"
    >我的寄货</view>
    <view
      class="tab-item {{activeTab === 1 ? 'active' : ''}}"
      data-index="{{1}}"
      bindtap="switchTab" hover-class="hover"
    >单号查询</view>
  </view>

  <!-- Tab0: 我的寄货列表 -->
  <view wx:if="{{activeTab === 0}}" class="parcel-list">
    <view class="parcel-card" wx:for="{{sendList}}" wx:key="id">
      <view class="parcel-header">
        <view class="parcel-title-row">
          <text class="parcel-icon">📦</text>
          <view class="parcel-info">
            <text class="parcel-name">{{item.goodsName || '寄货'}}</text>
            <text class="parcel-no">单号: {{item.orderNo}}</text>
          </view>
        </view>
        <view class="parcel-status" style="color: {{item.statusColorText}}">{{item.statusName}}</view>
      </view>
      <view class="parcel-route">
        <text>🚌 重量 {{item.goodsWeight}}kg</text>
        <text class="parcel-eta">{{item.createTimeText}}</text>
      </view>
      <!-- 邮快件取件码直显（点击复制，司机核销凭码） -->
      <view
        wx:if="{{item.pickupCode}}"
        class="parcel-code-row"
        data-code="{{item.pickupCode}}"
        bindtap="copyPickupCode" hover-class="hover"
      >
        <text class="parcel-code-label">取件码</text>
        <text class="parcel-code-value">{{item.pickupCode}}</text>
        <text class="parcel-code-copy">点击复制</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!sendList.length && !loading}}">
      <text class="empty-emoji">📭</text>
      <text class="empty-text">还没有寄货记录</text>
    </view>
  </view>

  <!-- Tab1: 单号查询结果 -->
  <view wx:if="{{activeTab === 1}}" class="parcel-list">
    <view wx:if="{{trackResult}}" class="parcel-card">
      <view class="parcel-header">
        <view class="parcel-title-row">
          <text class="parcel-icon">📦</text>
          <view class="parcel-info">
            <text class="parcel-name">{{trackResult.goodsName || '寄货'}}</text>
            <text class="parcel-no">单号: {{trackResult.orderNo}}</text>
          </view>
        </view>
        <view class="parcel-status" style="color: {{trackResult.statusColorText}}">{{trackResult.statusName}}</view>
      </view>
      <view class="parcel-route">
        <text>🚌 重量 {{trackResult.goodsWeight}}kg</text>
        <text class="parcel-eta">{{trackResult.createTimeText}}</text>
      </view>

      <!-- 货运审核状态 -->
      <view wx:if="{{trackResult.auditStatus === 0}}" class="parcel-audit warn">⏳ 审核中：货物正在等待平台审核</view>
      <view wx:elif="{{trackResult.auditStatus === 2}}" class="parcel-audit fail">❌ 审核未通过：{{trackResult.rejectReason || '货物不符合运输要求'}}</view>

      <!-- 进度条 -->
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{trackResult.progress}}%"></view>
      </view>

      <!-- 时间轴 -->
      <view class="timeline">
        <view class="timeline-item" wx:for="{{trackResult.timeline}}" wx:key="label">
          <view class="timeline-dot {{item.done ? 'done' : ''}}"></view>
          <view class="timeline-content">
            <text class="timeline-time">{{item.label}}</text>
            <text class="timeline-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <!-- 查件二维码：取件 / 司机扫码核销 -->
      <view class="parcel-qr-block">
        <text class="parcel-pickup-code" wx:if="{{trackResult.pickupCode}}">取件码：{{trackResult.pickupCode}}</text>
        <canvas type="2d" id="parcelQrCanvas" class="parcel-qr-canvas"></canvas>
        <text class="parcel-qr-tip">取件 · 司机扫码核销</text>
        <text class="parcel-qr-receiver" wx:if="{{trackResult.pickupCode && (trackResult.receiverName || trackResult.receiverMobile)}}">
          收件人：{{trackResult.receiverName || ''}} {{trackResult.receiverMobile || ''}}
        </text>
        <button class="parcel-qr-copy" bindtap="copyTrackNo">复制单号</button>
      </view>
    </view>

    <view wx:elif="{{noResult}}" class="empty-state">
      <text class="empty-emoji">🔍</text>
      <text class="empty-text">未查询到该单号，请确认后重试</text>
    </view>
    <view wx:else class="empty-state">
      <text class="empty-emoji">🔎</text>
      <text class="empty-text">输入上方的运单号，查询物流进度</text>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-area-bottom"></view>
</view>
