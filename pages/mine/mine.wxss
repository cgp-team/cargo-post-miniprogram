/* 我的页样式 */
.page-mine {
  background: var(--color-paper);
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ---- 未登录 ---- */
.login-banner {
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 40%, var(--color-accent) 100%);
  padding: 0 30rpx 40rpx;
  padding-top: env(safe-area-inset-top);
}

.login-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 60rpx;
  padding-bottom: 20rpx;
}

.login-avatar { font-size: 80rpx; }
.login-text { flex: 1; font-size: 32rpx; color: #fff; font-weight: 600; }
.login-arrow { font-size: 48rpx; color: rgba(255,255,255,0.7); }

/* ---- 用户信息区 ---- */
.user-banner {
  position: relative;
  padding: 0 30rpx 50rpx;
  padding-top: env(safe-area-inset-top);
}

.banner-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 320rpx;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 40%, var(--color-accent) 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.banner-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 60rpx;
}

.user-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255,255,255,0.4);
  overflow: hidden;
}
.user-avatar-img {
  width: 100%;
  height: 100%;
}

.user-avatar-emoji { font-size: 60rpx; }

.user-detail { flex: 1; }
.user-name { font-size: 36rpx; font-weight: 700; color: #fff; display: block; margin-bottom: 8rpx; }
.user-mobile { font-size: 26rpx; color: rgba(255,255,255,0.8); }

.user-role-tag {
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* ---- 农户服务大按钮 ---- */
.farmer-section {
  margin: -20rpx 28rpx 24rpx;
  position: relative;
  z-index: 2;
}

.farmer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 0.5rpx;
  margin-bottom: 18rpx;
  padding-left: 4rpx;
}

.farmer-buttons {
  display: flex;
  gap: 18rpx;
}

.farmer-btn {
  flex: 1;
  border-radius: 24rpx;
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.12), 0 14rpx 40rpx rgba(0,0,0,0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.farmer-btn:active {
  transform: scale(0.96);
}

.send-btn {
  background: linear-gradient(135deg, var(--color-clay), var(--color-clay));
}

.ledger-btn {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
}

.farmer-btn-emoji { font-size: 64rpx; margin-bottom: 14rpx; }
.farmer-btn-text { font-size: 36rpx; font-weight: 700; color: #fff; margin-bottom: 10rpx; }
.farmer-btn-desc { font-size: 22rpx; color: rgba(255,255,255,0.85); }

/* ---- 菜单 ---- */
.menu-section {
  margin: 0 28rpx 18rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 30rpx 28rpx;
  transition: all 0.15s ease;
  border-bottom: 1rpx solid var(--color-paper);
}

.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #F8FAF8; }

.menu-emoji { font-size: 40rpx; flex-shrink: 0; }
.menu-text { flex: 1; font-size: 30rpx; color: #333; font-weight: 500; }
.menu-sub { font-size: 22rpx; color: #757575; display: block; }
.menu-item-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.menu-arrow { font-size: 36rpx; color: #CCC; }
.menu-item.logout .menu-text { color: #E53935; }

/* 自定义滑动开关 */
.toggle-switch {
  width: 96rpx; height: 52rpx; border-radius: 26rpx;
  transition: background 0.25s; position: relative; flex-shrink: 0;
}
.toggle-switch.off { background: #DDD; }
.toggle-switch.on { background: var(--color-accent); }
.toggle-knob {
  width: 44rpx; height: 44rpx; border-radius: 50%; background: #fff;
  position: absolute; top: 4rpx; left: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15); transition: left 0.25s;
}
.toggle-switch.on .toggle-knob { left: 48rpx; }

/* 主题颜色标签 */
.menu-label { font-size: 24rpx; color: #757575; padding: 20rpx 28rpx 12rpx; }
.menu-divider { height: 1rpx; background: var(--color-paper); margin: 0 28rpx; }

.theme-row {
  display: flex; gap: 16rpx; padding: 8rpx 28rpx 24rpx;
}

.theme-chip {
  flex: 1; text-align: center; padding: 18rpx 0;
  border-radius: 14rpx; font-size: 26rpx; font-weight: 600;
  transition: all 0.15s ease;
}

.safe-area-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ============ 老年人模式：我的页字体放大 ============ */
.elderly-mode .login-text { font-size: 36rpx; }
.elderly-mode .user-name { font-size: 42rpx; }
.elderly-mode .user-mobile { font-size: 30rpx; }
.elderly-mode .user-role-tag { font-size: 28rpx; }
.elderly-mode .farmer-title { font-size: 32rpx; }
.elderly-mode .farmer-btn-text { font-size: 42rpx; }
.elderly-mode .farmer-btn-desc { font-size: 26rpx; }
.elderly-mode .menu-text { font-size: 34rpx; }
.elderly-mode .menu-sub { font-size: 26rpx; }
.elderly-mode .menu-label { font-size: 28rpx; }
.elderly-mode .theme-chip { font-size: 30rpx; padding: 22rpx 0; }
.elderly-mode .farmer-btn { padding: 44rpx 24rpx; }
