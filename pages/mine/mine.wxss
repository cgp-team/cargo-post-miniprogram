/* 我的页样式 */
.page-mine {
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-paper) 300rpx);
  min-height: 100vh;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

/* ---- 未登录：站牌头 ---- */
.login-banner {
  position: relative;
  padding: 0 30rpx 44rpx;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 60%, var(--color-primary-dark) 100%);
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
}

/* 顶部落款横档（站牌金属边） */
.login-banner::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 30rpx;
  right: 30rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

/* 角落光晕 */
.login-banner::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.login-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding-top: 48rpx;
}

.login-avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.login-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.login-text { font-size: 34rpx; color: #fff; font-weight: 700; letter-spacing: 1rpx; }
.login-sub { font-size: 22rpx; color: rgba(255,255,255,0.82); letter-spacing: 1rpx; }
.login-arrow { font-size: 48rpx; color: rgba(255,255,255,0.7); }

/* ---- 用户信息区：站牌式头部 ---- */
.user-banner {
  position: relative;
  padding: 0 28rpx 60rpx;
}

.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 60%, var(--color-primary-dark) 100%);
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
}

/* 顶部落款横档 */
.banner-bg::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 30rpx;
  right: 30rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

/* 角落光晕 */
.banner-bg::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.banner-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding-top: 44rpx;
}

.user-avatar-wrap {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.user-avatar-img {
  width: 100%;
  height: 100%;
}

.user-detail {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.user-name { font-size: 40rpx; font-weight: 800; color: #fff; letter-spacing: 1rpx; }
.user-mobile { font-size: 26rpx; color: rgba(255,255,255,0.82); letter-spacing: 1rpx; }

/* 角色线路章（站牌上的路线标识） */
.user-role-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

/* ---- 农户服务：悬浮卡（压站牌下沿） ---- */
.farmer-section {
  margin: -36rpx 24rpx 24rpx;
  padding: 24rpx 24rpx 26rpx;
  background: var(--color-card);
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
  position: relative;
  z-index: 2;
}

.farmer-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.farmer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 0.5rpx;
}

.farmer-buttons {
  display: flex;
  gap: 18rpx;
}

/* 陶土橙大按钮：渐变实板 + 顶部浅色横档 + 光晕，质感对齐 btn 体系 */
.farmer-btn {
  position: relative;
  flex: 1;
  border-radius: 16rpx;
  padding: 36rpx 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.farmer-btn:active {
  transform: scale(0.97);
  filter: brightness(0.94);
}

.send-btn {
  background: linear-gradient(150deg, #D4692F 0%, var(--color-clay) 55%, #B04E20 100%);
  box-shadow: inset 0 6rpx 0 rgba(255, 255, 255, 0.16), 0 8rpx 22rpx rgba(199, 91, 42, 0.28);
}

/* 角落光晕 */
.send-btn::after {
  content: '';
  position: absolute;
  top: -36rpx;
  right: -24rpx;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.14) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.farmer-btn-icon { margin-bottom: 14rpx; }
.farmer-btn-text { font-size: 36rpx; font-weight: 700; color: #fff; margin-bottom: 10rpx; letter-spacing: 1rpx; }
.farmer-btn-desc { font-size: 22rpx; color: rgba(255,255,255,0.88); }

/* ---- 菜单分组 ---- */
.menu-caption {
  margin: 4rpx 32rpx 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
}

.menu-section {
  margin: 0 24rpx 24rpx;
  background: var(--color-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  transition: all 0.15s ease;
  border-bottom: 1rpx solid var(--color-track);
}

.menu-item:last-child { border-bottom: none; }

/* 菜单图标：浅绿圆角小块托底 */
.menu-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon-box.clay-box { background: rgba(199, 91, 42, 0.12); }
.menu-icon-box.danger-box { background: rgba(192, 57, 43, 0.10); }

.menu-text { flex: 1; font-size: 30rpx; color: var(--color-ink); font-weight: 500; }
.menu-arrow { font-size: 36rpx; color: var(--color-text-tertiary); }
.menu-item.logout .menu-text { color: var(--color-danger); }

/* ============ 老年人模式：我的页字体放大 ============ */
.elderly-mode .login-text { font-size: 38rpx; }
.elderly-mode .login-sub { font-size: 26rpx; }
.elderly-mode .user-name { font-size: 46rpx; }
.elderly-mode .user-mobile { font-size: 30rpx; }
.elderly-mode .user-role-tag { font-size: 26rpx; padding: 10rpx 22rpx; }
.elderly-mode .farmer-title { font-size: 36rpx; }
.elderly-mode .farmer-btn-text { font-size: 42rpx; }
.elderly-mode .farmer-btn-desc { font-size: 26rpx; }
.elderly-mode .farmer-btn { padding: 44rpx 24rpx 40rpx; }
.elderly-mode .menu-caption { font-size: 28rpx; }
.elderly-mode .menu-text { font-size: 34rpx; }
.elderly-mode .menu-arrow { font-size: 42rpx; }
.elderly-mode .login-arrow { font-size: 56rpx; }
.elderly-mode .menu-item { padding: 32rpx 28rpx; }
.elderly-mode .menu-icon-box { width: 84rpx; height: 84rpx; }
