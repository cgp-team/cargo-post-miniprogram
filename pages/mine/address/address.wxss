/* 收货地址管理页 */
.page-address {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-paper) 280rpx);
  padding-bottom: 40rpx;
}

/* 选择模式提示（稻谷金浅底，与公告条同族） */
.select-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 32rpx;
  background: #FBF3DF;
  color: #8A6A1F;
  font-size: 26rpx;
  letter-spacing: 0.5rpx;
}

.addr-list {
  padding: 24rpx 24rpx 0;
}

/* 地址卡：定位图标块 + 姓名电话一行 + 地址辅文 + 底部操作行 */
.addr-card {
  background: #FFFDF8;
  border-radius: 20rpx;
  padding: 26rpx 28rpx 18rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.addr-top {
  display: flex;
  gap: 20rpx;
}

.addr-pin {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.addr-main {
  flex: 1;
  min-width: 0;
}

.addr-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.addr-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-ink);
  margin-right: 18rpx;
}
.addr-mobile {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  flex: 1;
}
/* 默认标记：浅绿底深绿字胶囊 */
.addr-default {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  flex-shrink: 0;
}
.addr-detail {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.addr-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F2ECDF;
}
.addr-action {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.addr-action.primary {
  color: var(--color-primary);
  font-weight: 600;
}
.addr-action.danger {
  color: var(--color-danger);
}

/* 新增按钮：站牌绿实板（沿用全局 .btn-primary，补页边距） */
.add-btn {
  width: auto;
  margin: 4rpx 24rpx 0;
}

/* 编辑弹层 */
.form-mask {
  position: fixed;
  inset: 0;
  background: rgba(30, 40, 30, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.form-panel {
  width: 100%;
  background: #FFFDF8;
  border-radius: 28rpx 28rpx 0 0;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-shadow: 0 -8rpx 32rpx rgba(60, 50, 30, 0.12);
}
/* 顶部抓手条 */
.form-panel::before {
  content: '';
  display: block;
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E0D9C8;
  margin: 12rpx auto 8rpx;
}
.form-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  text-align: center;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}
.form-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F2ECDF;
  font-size: 28rpx;
}
.form-item:last-of-type {
  border-bottom: none;
}
.form-label {
  width: 150rpx;
  color: var(--color-ink);
  font-weight: 500;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-ink);
}
.form-ph {
  color: var(--color-text-tertiary);
}
.form-picker {
  flex: 1;
}
.picker-text {
  font-size: 28rpx;
  color: var(--color-ink);
}
.picker-text.placeholder {
  color: var(--color-text-tertiary);
}
.save-btn {
  margin-top: 32rpx;
}

/* 老年人模式 */
.elderly-mode .select-tip { font-size: 30rpx; }
.elderly-mode .addr-name { font-size: 36rpx; }
.elderly-mode .addr-mobile { font-size: 30rpx; }
.elderly-mode .addr-default { font-size: 24rpx; }
.elderly-mode .addr-detail { font-size: 30rpx; }
.elderly-mode .addr-action { font-size: 30rpx; padding: 10rpx 24rpx; }
.elderly-mode .form-title { font-size: 36rpx; }
.elderly-mode .form-item { font-size: 32rpx; padding: 32rpx 0; }
.elderly-mode .form-label { width: 170rpx; }
.elderly-mode .form-input { font-size: 32rpx; }
.elderly-mode .picker-text { font-size: 32rpx; }

/* 骨架屏：地址卡轮廓（姓名条 + 地址条） */
.sk-name { width: 45%; height: 32rpx; margin-bottom: 18rpx; }
.sk-line { width: 85%; height: 24rpx; margin-bottom: 14rpx; }
.skeleton-card .skeleton:last-child { margin-bottom: 0; }
