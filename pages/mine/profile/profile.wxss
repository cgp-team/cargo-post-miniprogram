/* 个人资料页 */
.page-profile {
  min-height: 100vh;
  background: #F5F7F5;
  padding-bottom: 40rpx;
}

.section-label {
  padding: 28rpx 32rpx 14rpx;
  font-size: 26rpx;
  color: #888;
}

.card {
  margin: 0 24rpx;
  padding: 8rpx 28rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  font-size: 28rpx;
}
.form-item:last-of-type {
  border-bottom: none;
}
.form-label {
  width: 140rpx;
  color: #333;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
}
.form-static {
  flex: 1;
  color: #999;
}
.form-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.form-arrow {
  color: #CCC;
  font-size: 36rpx;
  margin-left: 12rpx;
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}
.avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.sex-row {
  flex: 1;
  display: flex;
  gap: 20rpx;
}
.sex-chip {
  padding: 10rpx 36rpx;
  border-radius: 999rpx;
  background: #F5F5F5;
  color: #666;
  font-size: 26rpx;
}
.sex-chip.active {
  background: var(--color-primary, #2E7D32);
  color: #fff;
}

.code-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-primary, #2E7D32);
  color: var(--color-primary, #2E7D32);
  font-size: 24rpx;
}
.code-btn.disabled {
  border-color: #CCC;
  color: #999;
}

.primary-btn {
  margin-top: 28rpx;
  background: var(--color-primary, #2E7D32);
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
}
.primary-btn[disabled] {
  opacity: 0.6;
}

.safe-area-bottom {
  height: calc(env(safe-area-inset-bottom) + 20rpx);
}

/* 老年人模式 */
.elderly-mode .section-label { font-size: 30rpx; }
.elderly-mode .form-item { font-size: 32rpx; padding: 32rpx 0; }
.elderly-mode .form-input { font-size: 32rpx; }
.elderly-mode .sex-chip { font-size: 30rpx; padding: 14rpx 42rpx; }
.elderly-mode .code-btn { font-size: 28rpx; }
.elderly-mode .primary-btn { font-size: 34rpx; padding: 8rpx 0; }
