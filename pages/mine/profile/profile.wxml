<!-- 个人资料页 -->
<view class="page-profile {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">

  <!-- 资料编辑 -->
  <view class="section-label">👤 基本资料</view>
  <view class="card">
    <view class="form-item" bindtap="chooseAvatar" hover-class="hover">
      <text class="form-label">头像</text>
      <view class="form-right">
        <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">👤</view>
        <text class="form-arrow">›</text>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" value="{{nickname}}" placeholder="请输入昵称" bindinput="onNicknameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">性别</text>
      <view class="sex-row">
        <view
          wx:for="{{[{value: 1, name: '男'}, {value: 2, name: '女'}, {value: 0, name: '保密'}]}}"
          wx:key="value"
          class="sex-chip {{sex === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectSex" hover-class="hover"
        >{{item.name}}</view>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <text class="form-static">{{mobile || '未绑定'}}</text>
    </view>
    <button class="primary-btn" bindtap="saveProfile" disabled="{{saving}}" loading="{{saving}}">保存资料</button>
  </view>

  <!-- 修改密码 -->
  <view class="section-label">🔒 修改密码</view>
  <view class="card">
    <view class="form-item">
      <text class="form-label">验证码</text>
      <input class="form-input" type="number" maxlength="6" value="{{smsCode}}" placeholder="短信验证码" bindinput="onSmsCodeInput" />
      <view class="code-btn {{codeCountdown > 0 ? 'disabled' : ''}}" bindtap="sendPwdCode" hover-class="hover">
        {{codeCountdown > 0 ? codeCountdown + 's' : '获取验证码'}}
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">新密码</text>
      <input class="form-input" password value="{{password}}" placeholder="4-16 位新密码" bindinput="onPasswordInput" />
    </view>
    <view class="form-item">
      <text class="form-label">确认密码</text>
      <input class="form-input" password value="{{passwordConfirm}}" placeholder="再次输入新密码" bindinput="onPasswordConfirmInput" />
    </view>
    <button class="primary-btn" bindtap="changePassword" disabled="{{changingPwd}}" loading="{{changingPwd}}">修改密码</button>
  </view>

  <view class="safe-area-bottom"></view>
</view>
