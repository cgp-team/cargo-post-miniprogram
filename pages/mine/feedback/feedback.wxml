<!-- 意见反馈页 -->
<view class="page-feedback {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">

  <!-- 提交表单 -->
  <view class="section-head">
    <icon name="edit" size="30" color="{{iconDeep}}" />
    <text class="section-title">我要反馈</text>
  </view>
  <view class="card form-card anim-rise">
    <textarea
      class="content-input"
      value="{{content}}"
      maxlength="500"
      placeholder="请描述您遇到的问题或建议（500 字以内）"
      placeholder-class="form-ph"
      bindinput="onContentInput"
    />
    <view class="form-item">
      <text class="form-label">称呼</text>
      <input class="form-input" value="{{name}}" placeholder="选填" placeholder-class="form-ph" bindinput="onNameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" value="{{mobile}}" placeholder="选填，便于我们联系您" placeholder-class="form-ph" bindinput="onMobileInput" />
    </view>
    <button class="btn-primary submit-btn" bindtap="submit" disabled="{{submitting}}" loading="{{submitting}}">提交反馈</button>
  </view>

  <!-- 我的反馈 -->
  <view class="section-head">
    <icon name="list" size="30" color="{{iconDeep}}" />
    <text class="section-title">我的反馈</text>
  </view>
  <view class="fb-list">
    <view class="fb-card anim-rise" style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms" wx:for="{{list}}" wx:key="id">
      <view class="fb-head">
        <text class="fb-status {{item.status === 1 ? 'replied' : ''}}">{{item.status === 1 ? '已回复' : '待处理'}}</text>
        <text class="fb-time">{{item.createTimeText}}</text>
      </view>
      <text class="fb-content">{{item.content}}</text>
      <view wx:if="{{item.reply}}" class="fb-reply">
        <view class="fb-reply-tag">
          <icon name="notice" size="24" color="{{iconColor}}" />
          <text>平台回复</text>
        </view>
        <text class="fb-reply-text">{{item.reply}}</text>
      </view>
    </view>
    <!-- 加载态：骨架屏（状态胶囊 + 内容条，仿反馈卡轮廓） -->
    <view wx:if="{{loading && !list.length}}">
      <view class="skeleton-card">
        <view class="skeleton sk-pill"></view>
        <view class="skeleton sk-line"></view>
        <view class="skeleton sk-line sk-line-mid"></view>
      </view>
      <view class="skeleton-card">
        <view class="skeleton sk-pill"></view>
        <view class="skeleton sk-line"></view>
        <view class="skeleton sk-line sk-line-mid"></view>
      </view>
    </view>
    <empty-state wx:if="{{!list.length && !loading}}" emoji="📭" text="还没有反馈记录" />
  </view>

  <view class="safe-area-bottom"></view>
</view>
