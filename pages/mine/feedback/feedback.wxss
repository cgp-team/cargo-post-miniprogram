/* 意见反馈页 */
.page-feedback {
  min-height: 100vh;
  background: var(--color-paper);
  padding-bottom: 40rpx;
}

.section-label {
  padding: 28rpx 32rpx 14rpx;
  font-size: 26rpx;
  color: #888;
}

.card {
  margin: 0 24rpx;
  padding: 24rpx 28rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
}

.content-input {
  width: 100%;
  height: 200rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: #F8FAF8;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0 0;
  font-size: 28rpx;
}
.form-label {
  width: 120rpx;
  color: #333;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
}

.primary-btn {
  margin-top: 28rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
}
.primary-btn[disabled] {
  opacity: 0.6;
}

.fb-list {
  padding: 0 24rpx;
}
.fb-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
}
.fb-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.fb-status {
  font-size: 22rpx;
  color: #B8860B;
  background: #FFF8E1;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.fb-status.replied {
  color: var(--color-primary);
  background: #F0F7F0;
}
.fb-time {
  font-size: 22rpx;
  color: #999;
}
.fb-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}
.fb-reply {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #F8FAF8;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
}
.fb-reply-tag {
  font-size: 22rpx;
  color: var(--color-primary);
  margin-bottom: 6rpx;
}
.fb-reply-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

/* 老年人模式 */
.elderly-mode .section-label { font-size: 30rpx; }
.elderly-mode .content-input { font-size: 32rpx; height: 240rpx; }
.elderly-mode .form-item { font-size: 32rpx; }
.elderly-mode .form-input { font-size: 32rpx; }
.elderly-mode .primary-btn { font-size: 34rpx; padding: 8rpx 0; }
.elderly-mode .fb-content { font-size: 32rpx; }
.elderly-mode .fb-reply-text { font-size: 30rpx; }
