/* 意见反馈页 */
.page-feedback {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-paper) 280rpx);
  padding-bottom: 40rpx;
}

/* 分区标题（对齐首页 section 手法：图标 + 深绿粗题） */
.section-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 32rpx 32rpx 18rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 0.5rpx;
}

/* 表单卡片 */
.card.form-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx 28rpx 28rpx;
}

/* 反馈内容输入框：对齐全局 .input-field 质感 */
.content-input {
  width: 100%;
  height: 220rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  background: #FBF8F1;
  border: 2rpx solid #E4DECD;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: var(--color-ink);
  line-height: 1.5;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0 0;
  font-size: 28rpx;
}
.form-label {
  width: 130rpx;
  color: var(--color-ink);
  font-weight: 500;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-ink);
}
.form-ph {
  color: var(--color-text-tertiary);
}

.submit-btn {
  margin-top: 28rpx;
}
/* 去掉微信 button 默认描边 */
.submit-btn::after {
  border: none;
}

/* 我的反馈列表 */
.fb-list {
  padding: 0 24rpx;
}
.fb-card {
  background: #FFFDF8;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}
.fb-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
/* 状态胶囊：待处理浅橙底，已回复浅绿底 */
.fb-status {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-status-pending);
  background: rgba(199, 91, 42, 0.10);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  letter-spacing: 0.5rpx;
}
.fb-status.replied {
  color: var(--color-status-shipping);
  background: var(--color-primary-light);
}
.fb-time {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.fb-content {
  font-size: 28rpx;
  color: var(--color-ink);
  line-height: 1.6;
}
/* 平台回复：浅绿底 + 左侧主题色竖条 */
.fb-reply {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  background: var(--color-primary-light);
  border-radius: 14rpx;
  border-left: 6rpx solid var(--color-primary);
  display: flex;
  flex-direction: column;
}
.fb-reply-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 8rpx;
}
.fb-reply-text {
  font-size: 26rpx;
  color: var(--color-ink);
  line-height: 1.5;
}

/* 骨架屏：反馈卡轮廓（状态胶囊 + 内容条） */
.sk-pill { width: 140rpx; height: 28rpx; border-radius: 999rpx; margin-bottom: 18rpx; }
.sk-line { width: 90%; height: 24rpx; margin-bottom: 14rpx; }
.sk-line-mid { width: 70%; }
.skeleton-card .skeleton:last-child { margin-bottom: 0; }

/* 老年人模式 */
.elderly-mode .section-title { font-size: 36rpx; }
.elderly-mode .content-input { font-size: 32rpx; height: 260rpx; }
.elderly-mode .form-item { font-size: 32rpx; }
.elderly-mode .form-label { width: 150rpx; }
.elderly-mode .form-input { font-size: 32rpx; }
.elderly-mode .fb-status { font-size: 26rpx; }
.elderly-mode .fb-time { font-size: 26rpx; }
.elderly-mode .fb-content { font-size: 32rpx; }
.elderly-mode .fb-reply-tag { font-size: 26rpx; }
.elderly-mode .fb-reply-text { font-size: 30rpx; }

/* 分页 footer：加载中 / 没有更多了（与订单页 .order-nomore 同范式） */
.fb-foot {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  padding: 20rpx 0;
}
.elderly-mode .fb-foot { font-size: 28rpx; }
