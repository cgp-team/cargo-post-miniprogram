<!-- 实时公交 · 农村客货邮版"车来了"：定位 → 地图（第一视觉）→ 附近线路 → 正在运行 -->
<view class="bus-page {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">

  <!-- 定位状态条：已定位 · 精度 XXm / 定位精度较低 · 已扩大搜索范围 / 无法获取当前位置 -->
  <view class="loc-bar {{radiusExpanded ? 'warn' : ''}} {{locationLevel === 'UNKNOWN' ? 'fail' : ''}}" bindtap="locateMe" hover-class="hover">
    <icon name="pin" size="26" color="#FFFFFF" />
    <text class="loc-text">{{locationText}}</text>
    <!-- 精度低（可能差到公里级）时给手动选点入口：catchtap 防止冒泡触发重新定位 -->
    <text wx:if="{{radiusExpanded}}" class="loc-action loc-action-pick" catchtap="manualPickLocation">手动选位置</text>
    <text class="loc-action">{{locationLevel === 'UNKNOWN' ? '重新定位' : '定位'}} ↻</text>
  </view>

  <!-- 概览：根据当前位置 · 附近 N 个公交站 · M 条线路 -->
  <view class="summary">
    <text class="summary-main">{{nearbyLocatedText || '正在获取当前位置…'}}</text>
    <text class="summary-sub">附近 {{nearbyStationCount}} 个公交站 · {{nearbyLineCount}} 条线路</text>
  </view>

  <!-- 地图：第一视觉焦点（约 45% 屏高），含我的位置 / 公交站 / 运行车辆 / 线路 -->
  <view class="map-wrap">
    <map
      id="busMap"
      class="bus-map"
      longitude="{{mapCenter.longitude}}"
      latitude="{{mapCenter.latitude}}"
      scale="{{mapScale}}"
      markers="{{markers}}"
      polyline="{{polyline}}"
      show-location
      bindmarkertap="onMarkerTap"
      bindregionchange="onRegionChange"
    ></map>
    <view class="map-legend">
      <text class="legend-item"><text class="dot dot-me"></text>我的位置</text>
      <text class="legend-item"><text class="dot dot-stop"></text>公交站</text>
      <text class="legend-item"><text class="dot dot-real"></text>实时车</text>
      <text class="legend-item"><text class="dot dot-sim"></text>模拟车</text>
    </view>
    <view class="map-btn" bindtap="locateMe" hover-class="hover">
      <icon name="pin" size="26" color="{{iconDeep}}" />
      <text>回到我的位置</text>
    </view>
  </view>

  <!-- 附近线路（默认最多 6 条，可展开全部） -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-wrap">
        <icon name="bus" size="30" color="{{iconDeep}}" />
        <text class="section-title">附近线路</text>
      </view>
      <text class="section-more" bindtap="toggleAllLines" hover-class="hover">{{showAllLines ? '收起' : '全部线路'}} ›</text>
    </view>
    <scroll-view class="line-scroll" scroll-x enable-flex wx:if="{{visibleLines.length}}">
      <view
        class="line-chip {{activeLineKey === item.key ? 'active' : ''}}"
        wx:for="{{visibleLines}}"
        wx:key="key"
        data-key="{{item.key}}"
        data-name="{{item.name}}"
        data-source="{{item.dataSource}}"
        bindtap="selectNearbyLine"
        hover-class="hover"
      >
        <text class="line-name">{{item.name}}</text>
        <text class="line-tag {{item.dataSource === 'REAL_TRANSIT' ? 'tag-real' : 'tag-project'}}">{{item.dataSource === 'REAL_TRANSIT' ? '现实公交' : '客货邮'}}</text>
      </view>
    </scroll-view>
    <view wx:elif="{{loading}}" class="empty">正在加载附近线路…</view>
    <view wx:elif="{{hasError}}" class="empty" bindtap="loadNearby" hover-class="hover">加载失败，点击重试</view>
    <view wx:else class="empty">附近暂无公交线路</view>
  </view>

  <!-- 正在运行车辆 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-wrap">
        <icon name="bus" size="30" color="{{iconDeep}}" />
        <text class="section-title">正在运行</text>
      </view>
      <text class="section-sub">{{vehicles.length}} 辆</text>
    </view>

    <view wx:if="{{!vehicles.length && !loading}}" class="empty">
      <text wx:if="{{nearbyLineCount}}">附近有 {{nearbyLineCount}} 条线路，当前暂无实时车辆数据</text>
      <text wx:else>附近暂无公交车</text>
    </view>

    <view
      class="vehicle-card"
      wx:for="{{vehicles}}"
      wx:key="busId"
      data-bus="{{item.busId}}"
      bindtap="goToBusDetail"
      hover-class="hover"
    >
      <view class="vehicle-eta-area">
        <text class="vehicle-eta-num">{{item.etaMinutes || '—'}}</text>
        <text class="vehicle-eta-unit">分钟</text>
        <text class="vehicle-dist" wx:if="{{item.distanceKm != null}}">{{item.distanceKm}}km</text>
      </view>
      <view class="vehicle-info">
        <view class="vehicle-route-tag">{{item.routeName}}</view>
        <view class="vehicle-plate-row">
          <image class="vehicle-icon" src="{{item.simulated ? '/images/marker-bus-sim.png' : '/images/marker-bus-real.png'}}" mode="aspectFit" />
          <text class="vehicle-plate">{{item.plateNo}}</text>
        </view>
        <view class="vehicle-next">下一站：{{item.nextStation}}</view>
      </view>
      <view class="vehicle-badge">
        <text class="vehicle-status {{item.statusText === '行驶中' ? 'running' : ''}}">{{item.statusText}}</text>
        <text class="vehicle-source {{item.simulated ? 'src-sim' : 'src-real'}}">{{item.sourceText}}</text>
      </view>
    </view>
  </view>

  <view class="safe-area-bottom"></view>
</view>

