/* 实时公交页 · 地图优先（车来了式），保持项目"山乡巴士"绿色主题 */

.bus-page {
  min-height: 100vh;
  background: var(--color-paper);
  padding-bottom: 24rpx;
}

/* ---------- 定位状态条 ---------- */
.loc-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 26rpx;
}

.loc-bar.warn {
  background: var(--color-clay);
}

.loc-bar.fail {
  background: #8A8778;
}

.loc-text {
  flex: 1;
  color: #fff;
  font-weight: 600;
}

.loc-action {
  color: #fff;
  opacity: 0.92;
  font-size: 24rpx;
}
.loc-action-pick {
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-weight: 600;
  opacity: 1;
}

/* ---------- 概览 ---------- */
.summary {
  padding: 16rpx 24rpx 8rpx;
  display: flex;
  flex-direction: column;
}

.summary-main {
  font-size: 28rpx;
  color: var(--color-ink);
  font-weight: 600;
}

.summary-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ---------- 地图（第一视觉焦点） ---------- */
.map-wrap {
  position: relative;
  margin: 12rpx 20rpx 0;
  height: 45vh;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx var(--color-primary-shadow);
}

.bus-map {
  width: 100%;
  height: 100%;
}

.map-legend {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  display: flex;
  gap: 14rpx;
  padding: 8rpx 14rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--color-ink);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
}

.dot-me { background: #1F5E9E; }
.dot-stop { background: #8A8778; }
.dot-real { background: #2E7D32; }
.dot-sim { background: #C75B2A; }

.map-btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-primary-dark);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

/* ---------- 区块 ---------- */
.section {
  margin-top: 22rpx;
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}

.section-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.section-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

.empty {
  display: block;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ---------- 附近线路 ---------- */
.line-scroll {
  white-space: nowrap;
}

.line-chip {
  display: inline-flex;
  flex-direction: column;
  gap: 6rpx;
  margin-right: 16rpx;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #E8ECEE;
}

.line-chip.active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.line-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.line-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.tag-real {
  background: #F8ECE3;
  color: var(--color-clay);
}

.tag-project {
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
}

/* ---------- 车辆卡片（车来了风格：左侧大字ETA + 中间信息 + 右侧状态） ---------- */
.vehicle-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
}

.vehicle-eta-area {
  flex-shrink: 0;
  width: 140rpx;
  text-align: center;
  padding-right: 20rpx;
  border-right: 2rpx solid #f0f0f0;
}

.vehicle-eta-num {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--color-primary-dark);
  line-height: 1;
  display: block;
}

.vehicle-eta-unit {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.vehicle-dist {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-top: 6rpx;
}

.vehicle-info {
  flex: 1;
  min-width: 0;
}

.vehicle-route-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #fff;
  background: var(--color-primary);
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.vehicle-plate-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.vehicle-icon {
  width: 36rpx;
  height: 36rpx;
}

.vehicle-plate {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}

.vehicle-next {
  font-size: 24rpx;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vehicle-badge {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.vehicle-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #EFEAE0;
  color: var(--color-text-secondary);
}

.vehicle-status.running {
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-weight: 600;
}

.vehicle-source {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.src-real { background: var(--color-primary-light); color: var(--color-primary-dark); }
.src-sim { background: #F8ECE3; color: var(--color-clay); }

/* ---------- 老年模式与安全区 ---------- */
.elderly-mode .loc-text { font-size: 30rpx; }
.elderly-mode .summary-main { font-size: 32rpx; }
.elderly-mode .section-title { font-size: 34rpx; }
.elderly-mode .line-name { font-size: 32rpx; }
.elderly-mode .vehicle-plate { font-size: 34rpx; }
.elderly-mode .vehicle-next { font-size: 30rpx; }
.elderly-mode .stub-eta { font-size: 34rpx; }

.safe-area-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

