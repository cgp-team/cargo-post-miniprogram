/* 实时公交页 · 地图优先（车来了式），设计语言：山乡巴士 · 站牌与车票 */

.bus-page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-paper) 420rpx);
  padding-bottom: 24rpx;
}

/* ---------- 站牌头：深绿实板承接导航栏 ---------- */
.bus-head {
  position: relative;
  overflow: hidden;
  padding: 24rpx 28rpx 28rpx;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 70%, var(--color-primary-dark) 100%);
  border-radius: 0 0 28rpx 28rpx;
  box-shadow: 0 8rpx 24rpx var(--color-primary-shadow);
}

/* 顶部落款横档（站牌金属边） */
.bus-head::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 28rpx;
  right: 28rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

/* 角落装饰光晕 */
.bus-head::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* 概览：根据当前位置 · 附近 N 站 · M 条线路 */
.summary {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.summary-main {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.summary-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 定位状态胶囊：精度低告警陶土橙、定位失败置灰 */
.loc-bar {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 22rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  font-size: 26rpx;
  color: #ffffff;
}

.loc-bar.warn {
  background: var(--color-clay);
  border-color: rgba(255, 255, 255, 0.4);
}

.loc-bar.fail {
  background: var(--color-status-done);
  border-color: rgba(255, 255, 255, 0.4);
}

.loc-text {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-weight: 600;
}

.loc-action {
  flex: none;
  color: #ffffff;
  opacity: 0.92;
  font-size: 24rpx;
}

.loc-action-pick {
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.22);
  font-weight: 600;
  opacity: 1;
}

/* ---------- 地图（第一视觉焦点） ---------- */
.map-wrap {
  position: relative;
  margin: 24rpx 24rpx 0;
  height: 45vh;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(60, 50, 30, 0.05);
  box-shadow: var(--shadow-card);
}

.bus-map {
  width: 100%;
  height: 100%;
}

.map-legend {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  display: flex;
  gap: 14rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: var(--radius-pill);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  font-size: 20rpx;
  color: var(--color-ink);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
}

.dot-me { background: #1F5E9E; } /* 与 marker-me.png 图标同色 */
.dot-stop { background: var(--color-text-tertiary); }
.dot-real { background: var(--color-primary); }
.dot-sim { background: var(--color-clay); }

.map-btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: #ffffff;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  color: var(--color-primary-dark);
  font-weight: 600;
  box-shadow: var(--shadow-float);
}

/* ---------- 区块（对齐首页分区节奏） ---------- */
.section {
  margin: 0 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 4rpx 18rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 0.5rpx;
}

/* 右侧计数/更多：浅绿胶囊 */
.section-sub {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
  padding: 4rpx 18rpx;
  border-radius: var(--radius-pill);
}

.section-more {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
  padding: 8rpx 18rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius-pill);
}

.lines-state,
.running-empty {
  padding-bottom: 12rpx;
}

/* 空态组件内边距收紧（apply-shared 可命中组件内部） */
.lines-state .es,
.running-empty .es {
  padding: 48rpx 0;
}

/* ---------- 附近线路 ---------- */
.line-scroll {
  white-space: nowrap;
  padding: 4rpx 2rpx 14rpx;
}

.line-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  margin-right: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: #FFFDF8;
  border: 2rpx solid rgba(60, 50, 30, 0.06);
  box-shadow: var(--shadow-card);
  transition: all 0.18s ease;
}

.line-chip.active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.line-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.line-chip.active .line-name {
  color: var(--color-primary-dark);
}

.line-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
}

.tag-real {
  background: #F8ECE3;
  color: var(--color-clay);
}

.tag-project {
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
}

/* ---------- 车辆车票卡（卡片本体由全局 .ticket-card 提供：主券+副券+打孔撕票线） ---------- */
.vehicle-card {
  margin-bottom: 16rpx;
}

.vehicle-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.vehicle-route {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 状态胶囊：行驶中带呼吸点 */
.vehicle-status {
  flex: none;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  padding: 6rpx 18rpx;
  background: #EFEAE0;
  border-radius: var(--radius-pill);
  font-weight: 500;
}

.vehicle-status.running {
  color: var(--color-status-shipping);
  background: var(--color-primary-light);
}

/* 行驶中呼吸点：统一用全局 .dot-live（色取 currentColor，即状态字色） */
.vehicle-status .status-dot {
  margin-right: 8rpx;
}

/* 离用户最近的那台车：列表首条，一眼可辨 */
.vehicle-nearest {
  flex: none;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-weight: 600;
}

.vehicle-plate-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.vehicle-icon {
  width: 36rpx;
  height: 36rpx;
}

.vehicle-plate {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}

.vehicle-source {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
}

.src-real { background: var(--color-primary-light); color: var(--color-primary-dark); }
.src-sim { background: #F8ECE3; color: var(--color-clay); }

/* 山路线收紧：车牌行与下一站行之间的衔接 */
.vehicle-road {
  margin: 18rpx 0 14rpx;
}

.vehicle-next-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.vehicle-next {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.vehicle-dist {
  flex: none;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 副券：非数字态（待发/—）大字收窄；待发时长附在副券下方 */
.ticket-card__stub-value.stub-word {
  font-size: 30rpx;
}

.stub-wait {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 2rpx;
}

/* ---------- 骨架屏：附近线路 chip / 正在运行车票卡 ---------- */
.sk-chips {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 2rpx 14rpx;
}

/* 仿真实 chip：高约 106rpx，宽度三档错开 */
.sk-chip {
  flex: none;
  width: 180rpx;
  height: 108rpx;
  border-radius: 18rpx;
}
.sk-chip-w2 { width: 224rpx; }
.sk-chip-w3 { width: 148rpx; }

/* 仿真实车辆卡：左主券条块 + 右副券块（间距与真实卡片节奏一致） */
.vehicle-skeletons .skeleton-card {
  margin-bottom: 16rpx;
}
.sk-ticket {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.sk-ticket-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.sk-serial { width: 38%; height: 20rpx; }
.sk-serial-w2 { width: 46%; }
.sk-title { width: 55%; height: 32rpx; }
.sk-title-w2 { width: 44%; }
.sk-line { width: 90%; height: 24rpx; }
.sk-line-short { width: 70%; }
.sk-stub { flex: none; width: 120rpx; height: 72rpx; }

/* ---------- 老年模式与安全区 ---------- */
.elderly-mode .summary-main { font-size: 36rpx; }
.elderly-mode .summary-sub { font-size: 28rpx; }
.elderly-mode .loc-bar { font-size: 30rpx; }
.elderly-mode .loc-text { font-size: 30rpx; }
.elderly-mode .loc-action { font-size: 28rpx; }
.elderly-mode .map-legend { font-size: 24rpx; }
.elderly-mode .map-btn { font-size: 26rpx; }
.elderly-mode .section-title { font-size: 38rpx; }
.elderly-mode .section-sub { font-size: 26rpx; }
.elderly-mode .section-more { font-size: 30rpx; }
.elderly-mode .line-name { font-size: 32rpx; }
.elderly-mode .line-tag { font-size: 24rpx; }
.elderly-mode .vehicle-route { font-size: 40rpx; }
.elderly-mode .vehicle-status { font-size: 26rpx; }
.elderly-mode .vehicle-nearest { font-size: 24rpx; }
.elderly-mode .vehicle-plate { font-size: 32rpx; }
.elderly-mode .vehicle-source { font-size: 24rpx; }
.elderly-mode .vehicle-next { font-size: 30rpx; }
.elderly-mode .vehicle-dist { font-size: 26rpx; }
.elderly-mode .stub-word { font-size: 36rpx; }
.elderly-mode .stub-wait { font-size: 24rpx; }

.safe-area-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
