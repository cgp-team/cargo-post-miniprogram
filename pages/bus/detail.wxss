/* 车辆详情页 · 设计语言：山乡巴士 · 站牌与车票 */

.detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-paper) 380rpx);
  padding: 24rpx;
  box-sizing: border-box;
}

/* ---------- 站牌头（底板/落款横档/光晕由全局 .signpost 提供，内容压在上层） ---------- */
.head-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.head-plate {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* 状态胶囊：行驶中着稻谷金，一眼可辨 */
.head-status {
  flex: none;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
}

.head-status.running {
  background: var(--color-gold);
  border-color: transparent;
  font-weight: 600;
}

/* 行驶中呼吸点：统一用全局 .dot-live（色取 currentColor，白点落在金色胶囊上） */
.head-status-dot {
  margin-right: 8rpx;
}

.head-route {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
}

.head-station {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.head-tags {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.tag {
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  border-radius: var(--radius-pill);
  padding: 6rpx 18rpx;
  margin: 0 12rpx 8rpx 0;
}

/* 运行说明：与票身信息分隔一道浅线 */
.head-meta {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.head-state {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}

.head-meta-line {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ---------- 地图卡 ---------- */
.detail-map-wrap {
  margin-top: 24rpx;
  height: 40vh;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(60, 50, 30, 0.05);
  box-shadow: var(--shadow-card);
}

.detail-map {
  width: 100%;
  height: 100%;
}

/* ---------- 区块标题（对齐首页/列表页节奏） ---------- */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 4rpx 18rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 0.5rpx;
}

.section-sub {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
  padding: 4rpx 18rpx;
  border-radius: var(--radius-pill);
}

/* ---------- 行程进度：虚线山路轨道，巴士图标走到当前进度 ---------- */
.progress-card {
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 40rpx 28rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.progress-track {
  position: relative;
  height: 12rpx;
  border-radius: 6rpx;
  background: repeating-linear-gradient(90deg, var(--color-line) 0, var(--color-line) 10rpx, transparent 10rpx, transparent 18rpx);
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--color-accent), var(--color-primary));
}

.progress-thumb {
  position: absolute;
  top: -16rpx;
  width: 44rpx;
  height: 44rpx;
  margin-left: -22rpx;
  border-radius: 50%;
  background: var(--color-primary);
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx var(--color-primary-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 22rpx;
}

/* ---------- 经停站点：竖向时间线（圆点 + 虚线山路连线） ---------- */
.stops {
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  box-shadow: var(--shadow-card);
}

.stop-item {
  display: flex;
  align-items: stretch;
}

.stop-rail {
  position: relative;
  flex: none;
  width: 44rpx;
  display: flex;
  justify-content: center;
  padding-top: 30rpx;
}

/* 圆点上方的来路 / 下方的去路：首尾相接成一条连续虚线山路 */
.stop-rail::before,
.stop-rail::after {
  content: '';
  position: absolute;
  left: 50%;
  margin-left: -2rpx;
  width: 4rpx;
  background: repeating-linear-gradient(180deg, #DCD5C2 0, #DCD5C2 8rpx, transparent 8rpx, transparent 16rpx);
}

.stop-rail::before { top: 0; height: 34rpx; }
.stop-rail::after { top: 48rpx; bottom: 0; }

/* 首站无来路，末站无去路 */
.stop-item:first-child .stop-rail::before,
.stop-item:last-child .stop-rail::after {
  display: none;
}

/* 分色：已过站的去路绿色；到达已过站/当前站的来路绿色（车已驶过） */
.stop-item.passed .stop-rail::after,
.stop-item.passed .stop-rail::before,
.stop-item.current .stop-rail::before {
  background: repeating-linear-gradient(180deg, var(--color-accent) 0, var(--color-accent) 8rpx, transparent 8rpx, transparent 16rpx);
}

.stop-dot {
  position: relative;
  z-index: 1;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--color-card);
  border: 3rpx solid #CFC8B4;
}

.stop-item.passed .stop-dot {
  background: var(--color-accent);
  border-color: var(--color-accent);
}

.stop-item.current .stop-dot {
  width: 24rpx;
  height: 24rpx;
  background: var(--color-primary);
  border-color: #ffffff;
  /* 当前站：绿环内嵌白色呼吸点（全局 .dot-live，取 currentColor） */
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

.stop-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-track);
}

.stop-item:last-child .stop-body {
  border-bottom: none;
}

.stop-name {
  font-size: 28rpx;
  color: var(--color-ink);
}

.stop-item.passed .stop-name {
  color: var(--color-text-tertiary);
  text-decoration: line-through;
}

.stop-item.current .stop-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}

.stop-min {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  margin-left: 12rpx;
}

.stop-state {
  flex: none;
  align-self: flex-start;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  width: 96rpx;
  margin-top: 24rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.stop-state.passed {
  color: var(--color-status-done);
}

/* 当前站：浅绿胶囊深绿字 + 静态圆点（非呼吸点，用 CSS 画） */
.stop-state.current {
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
  border-radius: var(--radius-pill);
  padding: 4rpx 0;
  justify-content: center;
  font-weight: 600;
}

.stop-state-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

/* ---------- 空态/加载 ---------- */
.detail-state {
  padding: 20rpx 0;
}

/* ---------- 骨架时间线（加载态，仿经停站点卡轮廓） ---------- */
.sk-timeline {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-top: 36rpx;
  padding-bottom: 36rpx;
}
.sk-stop {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.sk-stop-dot {
  flex: none;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.sk-stop-bar { height: 28rpx; }
.sk-w-lg { width: 62%; }
.sk-w-md { width: 48%; }
.sk-w-sm { width: 34%; }

/* ---------- 老年模式 ---------- */
.elderly-mode .head-plate { font-size: 50rpx; }
.elderly-mode .head-status { font-size: 26rpx; }
.elderly-mode .head-route { font-size: 30rpx; }
/* 放大后起讫站名允许换行，不再单行省略 */
.elderly-mode .head-station { white-space: normal; }
.elderly-mode .tag { font-size: 26rpx; }
.elderly-mode .head-state { font-size: 30rpx; }
.elderly-mode .head-meta-line { font-size: 28rpx; }
.elderly-mode .section-title { font-size: 38rpx; }
.elderly-mode .section-sub { font-size: 26rpx; }
.elderly-mode .progress-label { font-size: 26rpx; }
.elderly-mode .stop-name { font-size: 32rpx; }
/* 当前站名选择器优先级更高（.stop-item.current .stop-name），老年模式需单独覆盖 */
.elderly-mode .stop-item.current .stop-name { font-size: 36rpx; }
.elderly-mode .stop-min { font-size: 24rpx; }
.elderly-mode .stop-state { font-size: 24rpx; width: 112rpx; }
