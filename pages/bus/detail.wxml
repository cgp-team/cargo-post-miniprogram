<!-- 实时公交车辆详情：站牌头 → 地图 → 行程进度（山路线）→ 经停站点时间线 -->
<view class="detail-page {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <block wx:if="{{bus}}">
    <!-- 站牌头：车牌 + 起讫站 + 班次/数据源标签（底板/落款横档由全局 .signpost 提供） -->
    <view class="signpost">
      <view class="head-top">
        <view class="head-plate">{{bus.plateNo}}</view>
        <text class="head-status {{bus.status === 1 ? 'running' : ''}}">{{bus.status === 1 ? '行驶中' : '待发车'}}</text>
      </view>
      <view class="head-route">
        <text class="head-station">{{bus.startStation}}</text>
        <icon name="arrow" size="26" color="#FFFFFF" />
        <text class="head-station">{{bus.endStation}}</text>
      </view>
      <view class="head-tags">
        <text class="tag">{{bus.shiftCode}}</text>
        <text class="tag" wx:if="{{bus.dataSource === 'SIMULATED'}}">位置推算</text>
        <text class="tag" wx:if="{{sourceText}}">数据：{{sourceText}}</text>
        <text class="tag" wx:if="{{bus.speedKmh}}">{{bus.speedKmh}} km/h</text>
      </view>
      <view class="head-meta">
        <text class="head-state">{{stateText}}</text>
        <block wx:if="{{locationAvailable}}">
          <text class="head-meta-line">当前站：{{currentStationText}} · 下一站：{{nextStationText}}{{etaText ? ' · ' + etaText : ''}}</text>
          <text class="head-meta-line" wx:if="{{bus.dataSource === 'SIMULATED'}}">按班次计划推算的位置（非司机实时上报）</text>
        </block>
      </view>
    </view>

    <!-- 地图：车辆实时位置 + 线路 polyline + 我的位置 -->
    <view class="detail-map-wrap">
      <map
        id="busDetailMap"
        class="detail-map"
        longitude="{{mapCenter.longitude}}"
        latitude="{{mapCenter.latitude}}"
        scale="{{mapScale}}"
        markers="{{markers}}"
        polyline="{{polyline}}"
        show-location
      ></map>
    </view>

    <!-- 行程进度：虚线山路轨道，巴士图标走到当前进度 -->
    <view class="section-header">
      <view class="section-title-wrap">
        <icon name="road" size="30" color="{{iconDeep}}" />
        <text class="section-title">行程进度</text>
      </view>
    </view>
    <view class="progress-card">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progress}}%"></view>
        <view class="progress-thumb" style="left: {{progress}}%">
          <icon name="bus" size="24" color="#FFFFFF" />
        </view>
      </view>
      <view class="progress-label">
        <text>已完成 {{progress}}%</text>
        <text wx:if="{{bus.status === 1}}">等待实时位置</text>
      </view>
    </view>

    <!-- 山路线衔接：从总进度走进逐站时间线 -->
    <view class="road-line"></view>

    <!-- 经停站点：竖向时间线（已过/当前/待达分色） -->
    <view class="section-header">
      <view class="section-title-wrap">
        <icon name="list" size="30" color="{{iconDeep}}" />
        <text class="section-title">经停站点</text>
      </view>
      <text class="section-sub">{{stops.length}} 站</text>
    </view>
    <view class="stops">
      <view class="stop-item {{item.state}}" wx:for="{{stops}}" wx:key="sequenceNo">
        <view class="stop-rail">
          <view class="stop-dot"></view>
        </view>
        <view class="stop-body">
          <text class="stop-name">{{item.stationName}}</text>
          <text class="stop-min" wx:if="{{item.plannedMinutes}}">计划{{item.plannedMinutes}}分</text>
        </view>
        <text class="stop-state {{item.state}}">{{item.state === 'passed' ? '✓ 已过' : item.state === 'current' ? '● 当前' : ''}}</text>
      </view>
    </view>
  </block>

  <view wx:elif="{{!loading}}" class="detail-state" bindtap="loadDetail" hover-class="hover">
    <empty-state icon="bus" text="{{loadError === 'notfound' ? '该车辆暂未上线' : '网络异常，加载失败，点击重试'}}" />
  </view>
  <view wx:else class="detail-state">
    <empty-state icon="bus" text="加载中…" />
  </view>
</view>
