<!-- 首页 - 农村客货邮小程序 -->
<view class="home-page {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- 顶部站牌栏 -->
  <view class="top-bar" style="padding-top: {{statusBarHeight + 16}}px">
    <view class="top-row">
      <view class="top-left">
      <view class="location-info" bindtap="switchVillage" hover-class="hover">
        <text class="village-name">{{currentVillage || (locationUnavailable ? '定位不可用' : '当前位置')}}</text>
          <text class="arrow-down">▾</text>
          <text class="top-badge">县城⇄乡村</text>
        </view>
        <text class="top-sub">客货邮 · 城乡直达</text>
      </view>
      <view class="user-avatar" bindtap="goToProfile" hover-class="hover">
        <image wx:if="{{userInfo.avatar}}" src="{{userInfo.avatar}}" mode="aspectFill" />
        <icon wx:else name="user" size="40" color="#FFFFFF" />
      </view>
    </view>
    <!-- 定位状态提示（权限拒绝/不可用；不影响其他功能） -->
    <view wx:if="{{locationDenied}}" class="loc-hint" bindtap="goToLocationSetting" hover-class="hover">
      <text class="loc-hint-text">开启定位后，可查看附近公交 ›</text>
    </view>
    <view wx:elif="{{locationUnavailable}}" class="loc-hint">
      <text class="loc-hint-text">定位不可用</text>
    </view>
    <!-- 定位精度较低（accuracy > 100m）：引导用户重新定位，避免"附近公交"按偏差几百米的坐标查询 -->
    <view wx:elif="{{locationPoorAccuracy}}" class="loc-hint loc-hint-warn">
      <text class="loc-hint-text" bindtap="relocate" hover-class="hover">
        定位精度较低{{locationAccuracyText ? '（约 ' + locationAccuracyText + '）' : ''}}{{locationVeryPoorAccuracy ? '，区域名可能不准' : ''}}，点此重新定位
      </text>
      <!-- 手动选点：手机未开"精确位置"/室内/WiFi 定位时误差可达公里级，点一次即可纠正 -->
      <text class="loc-hint-action" bindtap="manualPickLocation" hover-class="hover">手动选择位置 ›</text>
    </view>
    <view wx:elif="{{locationManual}}" class="loc-hint">
      <text class="loc-hint-text" bindtap="manualPickLocation" hover-class="hover">已手动选择位置，点此可修改 ›</text>
    </view>
    <!-- 天气胶囊：一行浓缩，点击展开完整预报卡 -->
    <view wx:if="{{weather.temp != null}}" class="weather-pill" bindtap="toggleWeather" hover-class="hover">
      <icon name="sun" size="30" color="#FFFFFF" />
      <text class="weather-pill-text">{{weather.temp}}°C {{weather.condition}}<text wx:if="{{weather.locationName}}"> · {{weather.locationName}}</text></text>
      <text class="weather-pill-more">{{weatherExpanded ? '收起' : '4日预报'}} ›</text>
    </view>
  </view>

  <!-- 天气详情卡（默认收起，点胶囊展开；主题色系） -->
  <view wx:if="{{weatherExpanded && weather.temp != null}}" class="weather-card anim-rise">
    <view class="weather-main">
      <view class="weather-left">
        <view class="weather-icon-circle">
          <text class="weather-icon">{{weather.icon}}</text>
        </view>
        <view class="weather-info">
          <view class="weather-temp-row">
            <text class="weather-temp">{{weather.temp}}°</text>
            <text class="weather-condition">{{weather.condition}}</text>
          </view>
          <view class="weather-detail">
            <text class="weather-tag">湿度 {{weather.humidity}}%</text>
            <text class="weather-tag">风 {{weather.wind}}</text>
          </view>
          <view class="weather-meta">
            <view wx:if="{{weatherLoading}}" class="weather-refresh"><icon name="refresh" size="20" color="#8A8778" /><text>更新中…</text></view>
            <view wx:elif="{{weather.mock}}" class="weather-refresh warn"><icon name="info" size="20" color="#C75B2A" /><text>网络异常，展示本地天气</text></view>
            <text wx:elif="{{weatherUpdateTime}}" class="weather-refresh">{{weatherUpdateTime}}</text>
          </view>
        </view>
      </view>
      <view class="weather-tips">
        <text>{{weather.tips}}</text>
      </view>
    </view>
    <view class="weather-forecast">
      <view class="forecast-item" wx:for="{{weather.forecast}}" wx:key="day">
        <text class="forecast-day">{{item.day}}</text>
        <text class="forecast-icon">{{item.icon}}</text>
        <text class="forecast-temp">{{item.tempLo}}° {{item.tempHi}}°</text>
      </view>
    </view>
  </view>

  <!-- 公告横幅 -->
  <swiper class="notice-swiper" autoplay interval="3000" circular>
    <swiper-item wx:for="{{notices}}" wx:key="id">
      <view class="notice-item" data-item="{{item}}" bindtap="showNotice" hover-class="hover">
        <view class="notice-tag">
          <icon name="notice" size="24" color="#FFFFFF" />
          <text>公告</text>
        </view>
        <text class="notice-text">{{item.title}}</text>
      </view>
    </swiper-item>
  </swiper>

  <!-- 功能入口 - 四宫格（阶梯入场） -->
  <view class="feature-grid">
    <view class="feature-item anim-rise" bindtap="goToBusTracking" hover-class="hover">
      <view class="feature-icon-box green-bg">
        <icon name="bus" size="50" color="#FFFFFF" />
      </view>
      <text class="feature-name">实时公交</text>
    </view>

    <view class="feature-item anim-rise" style="animation-delay: 50ms" bindtap="goToProducts" hover-class="hover">
      <view class="feature-icon-box gold-bg">
        <icon name="leaf" size="50" color="#FFFFFF" />
      </view>
      <text class="feature-name">农产品</text>
    </view>

    <view class="feature-item anim-rise" style="animation-delay: 100ms" bindtap="goToParcel" hover-class="hover">
      <view class="feature-icon-box deep-bg">
        <icon name="box" size="50" color="#FFFFFF" />
      </view>
      <text class="feature-name">我的快递</text>
    </view>

    <view class="feature-item anim-rise" style="animation-delay: 150ms" bindtap="goToSend" hover-class="hover">
      <view class="feature-icon-box clay-bg">
        <icon name="send" size="50" color="#FFFFFF" />
      </view>
      <text class="feature-name">我要寄货</text>
    </view>
  </view>

  <!-- 公交实时到站（真实附近公交；空/错误/加载有明确状态，不显示 Demo） -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-wrap">
        <icon name="bus" size="32" color="{{iconDeep}}" />
        <text class="section-title">附近公交</text>
      </view>
      <text class="section-more" bindtap="goToBusTracking" hover-class="hover">更多 ›</text>
    </view>

    <view wx:if="{{nearbyBusLocatedText || nearbyBusUpdatedText}}" class="bus-meta">
      <text wx:if="{{nearbyBusLocatedText}}" class="bus-meta-text">{{nearbyBusLocatedText}}</text>
      <text wx:if="{{nearbyBusUpdatedText}}" class="bus-meta-text">{{nearbyBusUpdatedText}}</text>
    </view>

    <!-- 加载中：骨架车票卡，轮廓对齐真实公交卡，替代纯文本 -->
    <view wx:if="{{nearbyBusStatus === 'loading'}}" class="skeleton-card bus-skeleton">
      <view class="skeleton sk-bus-title"></view>
      <view class="skeleton sk-bus-route"></view>
      <view class="skeleton sk-bus-info"></view>
    </view>

    <!-- 不在运营时间：如实说明服务时段与下一班，不铺"待发车"卡片 -->
    <view wx:elif="{{nearbyBusStatus === 'off'}}" class="bus-empty">
      <text class="bus-empty-title">当前不在运营时间</text>
      <text class="bus-empty-text">
        {{nearbyBusWindow ? '服务时段 ' + nearbyBusWindow : ''}}{{nearbyBusNextDeparture ? '，下一班 ' + nearbyBusNextDeparture + ' 发车' : ''}}
      </text>
      <block wx:if="{{nearbyLineCount}}">
        <text class="bus-empty-text">附近共 {{nearbyLineCount}} 条公交线路，运营时段可查看运行车辆</text>
      </block>
    </view>

    <!-- 空数据：有附近站点/线路但无运营车辆 = 不在运营时间，仍展示站点与线路说明 -->
    <view wx:elif="{{nearbyBusStatus === 'empty'}}" class="bus-empty">
      <!-- 附近有线路（现实公交或项目自建）但暂无实时车辆：不能说"附近没有公交" -->
      <block wx:if="{{nearbyLineCount}}">
        <text class="bus-empty-title">附近有 {{nearbyLineCount}} 条公交线路</text>
        <view class="bus-line-chip" wx:for="{{nearbyLinePreview}}" wx:key="routeName">
          {{item.routeName}}<text wx:if="{{item.dataSource === 'REAL_TRANSIT'}}"> · 现实公交</text><text wx:elif="{{item.dataSource === 'PROJECT_TRANSIT'}}"> · 项目线路</text>
        </view>
        <text class="bus-empty-text">当前暂无实时车辆数据{{nearbyLineCount > 6 ? '（仅显示前 6 条）' : ''}}</text>
      </block>
      <block wx:elif="{{nearbyStations.length}}">
        <text class="bus-empty-title">附近有 {{nearbyStations.length}} 个公交站点</text>
        <view class="bus-line-chip" wx:for="{{nearbyStations}}" wx:key="name">
          {{item.name}}<text wx:if="{{item.distanceKm != null}}"> · {{item.distanceKm}}km</text><text wx:if="{{item.dataSource === 'REAL_TRANSIT'}}"> · 现实公交</text>
        </view>
        <text class="bus-empty-text">当前暂无实时车辆数据</text>
      </block>
      <text wx:else class="bus-empty-text">附近暂无公交线路</text>
    </view>

    <!-- 接口失败 -->
    <view wx:elif="{{nearbyBusStatus === 'error'}}" class="bus-empty">
      <text class="bus-empty-text">实时公交暂时不可用</text>
      <view class="bus-retry" bindtap="loadNearbyBusData" hover-class="hover">重新加载</view>
    </view>

    <!-- 有数据 -->
    <view wx:elif="{{nearbyBuses.length}}" class="bus-list">
      <view
        class="bus-card ticket-card anim-rise"
        wx:for="{{nearbyBuses}}"
        wx:key="busId"
        style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms"
        bindtap="goToBusDetail" hover-class="hover"
        data-id="{{item.busId}}"
      >
        <view class="ticket-card__main">
          <view class="ticket-card__serial">{{item.routeName}} · {{item.shiftCode}}</view>
          <view class="bus-header">
            <text class="bus-number">{{item.routeName}}</text>
            <text class="bus-status {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <view class="bus-route">
            <icon name="pin" size="24" color="#8A8778" />
            <text>{{item.startStation}} → {{item.endStation}}</text>
          </view>
          <!-- 山路线：本站到下站之间的路 -->
          <view class="road-line"></view>
          <view class="bus-info">
            <text class="bus-next">{{item.running ? '下一站：' + item.nextStationText : (item.currentStation ? '当前位置：' + item.currentStation : '下一站：' + item.nextStationText)}}</text>
            <text wx:if="{{item.distanceKm != null}}" class="bus-dist">距 {{item.distanceKm}} km</text>
          </view>
          <view class="bus-tags">
            <text class="bus-tag {{item.sourceDot ? 'tag-live' : ''}}">{{item.sourceText}}</text>
            <text wx:if="{{item.routeProvider}}" class="bus-tag">{{item.routeProvider}}</text>
            <text wx:if="{{item.shiftCode}}" class="bus-tag">班次 {{item.shiftCode}}</text>
          </view>
        </view>
        <view class="ticket-card__stub">
          <text class="ticket-card__stub-value {{item.etaMinutes != null ? 'stub-eta' : ''}}" style="white-space:normal;">{{item.etaText}}</text>
          <text class="ticket-card__stub-label">{{item.etaLabel || '到站'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 推荐农产品 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-wrap">
        <icon name="leaf" size="32" color="{{iconDeep}}" />
        <text class="section-title">优质农产品 · 村里直发</text>
      </view>
      <text class="section-more" bindtap="goToProducts" hover-class="hover">更多 ›</text>
    </view>

    <scroll-view class="product-scroll" scroll-x>
      <view
        class="product-card anim-rise"
        wx:for="{{recommendProducts}}"
        wx:key="id"
        style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms"
        bindtap="goToProductDetail" hover-class="hover"
        data-id="{{item.id}}"
        data-demo="{{item.isDemo}}"
      >
        <view class="product-img">
          <image wx:if="{{item.imageUrl}}" class="product-img-real" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
          <icon wx:else name="leaf" size="72" color="{{iconAccent}}" />
        </view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <view class="product-from">
            <icon name="pin" size="20" color="#8A8778" />
            <text>{{item.fromVillage}}</text>
          </view>
          <view class="product-price-row">
            <text class="product-price">¥{{item.price}}</text>
            <text class="product-unit">/{{item.unit}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-area-bottom"></view>
</view>
