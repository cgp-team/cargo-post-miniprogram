<!-- 首页 - 农村客货邮小程序 -->
<view class="home-page {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- 顶部站牌栏 -->
  <view class="top-bar" style="padding-top: {{statusBarHeight + 16}}px">
    <view class="top-left">
      <view class="location-info" bindtap="switchVillage" hover-class="hover">
        <text class="village-name">{{currentVillage}}</text>
        <text class="arrow-down">▾</text>
        <text class="top-badge">县城⇄乡村</text>
      </view>
      <text class="top-sub">客货邮 · 城乡直达</text>
    </view>
    <view class="user-avatar" bindtap="goToProfile" hover-class="hover">
      <text>{{userInfo.avatarUrl || '👤'}}</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar card">
    <text class="search-emoji">🔍</text>
    <input
      class="search-input"
      type="text"
      placeholder="搜索公交线路、农产品、快递单号..."
      bindtap="goToSearch" hover-class="hover"
      disabled
    />
  </view>

  <!-- 天气卡片（秒开：先渲染缓存/兜底，再刷新真实数据） -->
  <view wx:if="{{weather.temp != null}}" class="weather-card">
    <view class="weather-main">
      <view class="weather-left">
        <view class="weather-icon-circle">
          <text class="weather-icon">{{weather.icon}}</text>
        </view>
        <view class="weather-info">
          <view class="weather-temp-row">
            <text class="weather-temp">{{weather.temp}}°</text>
            <text class="weather-condition">{{weather.condition}}</text>
          </view>
          <text wx:if="{{weather.locationName}}" class="weather-location">📍 {{weather.locationName}}</text>
          <view class="weather-detail">
            <text>💧 {{weather.humidity}}%  🌬 {{weather.wind}}</text>
          </view>
          <view class="weather-meta">
            <text wx:if="{{weatherLoading}}" class="weather-refresh">🔄 更新中…</text>
            <text wx:elif="{{weather.mock}}" class="weather-refresh warn">⚠ 网络异常，展示本地天气</text>
            <text wx:elif="{{weatherUpdateTime}}" class="weather-refresh">{{weatherUpdateTime}}</text>
          </view>
        </view>
      </view>
      <view class="weather-tips">
        <text>{{weather.tips}}</text>
      </view>
    </view>
    <view class="weather-forecast">
      <view class="forecast-item" wx:for="{{weather.forecast}}" wx:key="day">
        <text class="forecast-day">{{item.day}}</text>
        <text class="forecast-icon">{{item.icon}}</text>
        <text class="forecast-temp">{{item.tempLo}}° {{item.tempHi}}°</text>
      </view>
    </view>
  </view>

  <!-- 公告横幅 -->
  <swiper class="notice-swiper" autoplay interval="3000" circular>
    <swiper-item wx:for="{{notices}}" wx:key="id">
      <view class="notice-item">
        <text class="notice-tag">📢 公告</text>
        <text class="notice-text">{{item.title}}</text>
      </view>
    </swiper-item>
  </swiper>

  <!-- 功能入口 - 四宫格 -->
  <view class="feature-grid">
    <view class="feature-item" bindtap="goToBusTracking" hover-class="hover">
      <view class="feature-icon-box green-bg">
        <text class="feature-emoji">🚌</text>
      </view>
      <text class="feature-name">实时公交</text>
      <text class="feature-desc">查看车辆位置</text>
    </view>

    <view class="feature-item" bindtap="goToProducts" hover-class="hover">
      <view class="feature-icon-box orange-bg">
        <text class="feature-emoji">🥬</text>
      </view>
      <text class="feature-name">农产品选购</text>
      <text class="feature-desc">新鲜直达餐桌</text>
    </view>

    <view class="feature-item" bindtap="goToParcel" hover-class="hover">
      <view class="feature-icon-box blue-bg">
        <text class="feature-emoji">📦</text>
      </view>
      <text class="feature-name">我的快递</text>
      <text class="feature-desc">物流全程追踪</text>
    </view>

    <view class="feature-item" bindtap="goToSend" hover-class="hover">
      <view class="feature-icon-box red-bg">
        <text class="feature-emoji">📮</text>
      </view>
      <text class="feature-name">我要寄货</text>
      <text class="feature-desc">一键寄送农产品</text>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="quick-action-item" bindtap="goToBusTracking" hover-class="hover">
      <text class="quick-action-emoji">🕐</text>
      <text>实时到站</text>
    </view>
    <view class="quick-action-item" bindtap="goToParcel" hover-class="hover">
      <text class="quick-action-emoji">📍</text>
      <text>物流追踪</text>
    </view>
    <view class="quick-action-item" bindtap="goToProducts" hover-class="hover">
      <text class="quick-action-emoji">🔥</text>
      <text>今日特惠</text>
    </view>
  </view>

  <!-- 公交实时到站 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🚌 附近公交 · 实时到站</text>
      <text class="section-more" bindtap="goToBusTracking" hover-class="hover">更多 ›</text>
    </view>

    <view class="bus-list">
      <view
        class="bus-card ticket-card"
        wx:for="{{nearbyBuses}}"
        wx:key="id"
        bindtap="goToBusDetail" hover-class="hover"
        data-id="{{item.id}}"
      >
        <view class="bus-header">
          <text class="bus-number">{{item.routeNumber}}</text>
          <text class="bus-status {{item.status === 'running' ? 'running' : ''}}">
            {{item.status === 'running' ? '行驶中' : '已到站'}}
          </text>
        </view>
        <view class="bus-route">
          <text>{{item.startStation}} → {{item.endStation}}</text>
        </view>
        <!-- 山路线：本站到下站之间的路 -->
        <view class="road-line"></view>
        <view class="bus-info">
          <text class="text-gray">下一站: {{item.nextStation}}</text>
          <text class="text-orange">⏱ 约{{item.arriveTime}}分钟</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 推荐农产品 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🌽 优质农产品 · 村里直发</text>
      <text class="section-more" bindtap="goToProducts" hover-class="hover">更多 ›</text>
    </view>

    <scroll-view class="product-scroll" scroll-x>
      <view
        class="product-card"
        wx:for="{{recommendProducts}}"
        wx:key="id"
        bindtap="goToProductDetail" hover-class="hover"
        data-id="{{item.id}}"
      >
        <view class="product-img"><text class="product-img-emoji">{{item.image}}</text></view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-from">{{item.fromVillage}}</text>
          <view class="product-price-row">
            <text class="product-price">¥{{item.price}}</text>
            <text class="product-unit">/{{item.unit}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 悬浮寄货按钮 -->
  <view class="fab-send" bindtap="goToSend" hover-class="hover">
    <text class="fab-icon">📮</text>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-area-bottom"></view>
</view>
