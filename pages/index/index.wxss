/* 首页样式 - 农村客货邮小程序 */
.home-page {
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-primary-light) 10%, var(--color-paper) 30%);
  min-height: 100vh;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

/* 顶部栏 —— 站牌式：深绿实板 + 落款横档 + 线路号 chip */
.top-bar {
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 60%, var(--color-primary-dark) 100%);
  padding: 20rpx 30rpx 48rpx;
  position: relative;
  overflow: hidden;
}

/* 顶部落款横档（站牌金属边） */
.top-bar::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 30rpx;
  right: 30rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

/* 顶部装饰光晕 */
.top-bar::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.top-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.top-left {
  display: flex;
  flex-direction: column;
}

.location-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.arrow-down {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.village-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* 线路号 chip（站牌上的路线标识） */
.top-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  padding: 4rpx 14rpx;
  border-radius: 22rpx;
  letter-spacing: 1rpx;
}

.top-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

/* 定位状态提示（权限拒绝/不可用；适配深绿站牌背景，点击可"去设置"） */
.loc-hint {
  display: inline-flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}
.loc-hint-text {
  font-size: 22rpx;
  color: #ffffff;
  letter-spacing: 1rpx;
}
/* 定位精度低（可能差到公里级）：高亮告警 + 手动选点入口 */
.loc-hint-warn {
  background: rgba(192, 57, 43, 0.35);
  border-color: rgba(255, 255, 255, 0.55);
}
.loc-hint-action {
  margin-left: 16rpx;
  padding-left: 16rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  color: #ffe9c7;
  font-weight: 600;
  white-space: nowrap;
}

.user-avatar {
  position: relative;
  z-index: 1;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 3rpx solid rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.user-avatar image {
  width: 76rpx;
  height: 76rpx;
}

/* 天气胶囊：头部内一行浓缩天气，点击展开详情卡 */
.weather-pill {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: var(--radius-pill);
  padding: 12rpx 24rpx;
}

.weather-pill-text {
  flex: 1;
  font-size: 26rpx;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.weather-pill-more {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  flex-shrink: 0;
}

/* 搜索栏 */
.search-bar {
  margin: -24rpx 28rpx 0;
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 28rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(60, 50, 30, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(60, 50, 30, 0.12);
  background: #FFFDF8;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-ink);
}

.search-input::placeholder {
  color: var(--color-text-tertiary);
}

/* 天气详情卡（点击胶囊展开；主题色系：米纸底 + 深绿字 + 金色点缀） */
.weather-card {
  margin: 20rpx 28rpx 0;
  background: #FFFDF8;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(217, 164, 65, 0.28);
  box-shadow: var(--shadow-card);
}

.weather-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.weather-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.weather-icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FBF3DF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1rpx rgba(217, 164, 65, 0.30);
}

.weather-icon { font-size: 56rpx; line-height: 1; }

.weather-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.weather-temp-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.weather-temp {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  line-height: 1;
}

.weather-condition {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.weather-detail {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.weather-meta {
  margin-top: 2rpx;
}

.weather-refresh {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.weather-refresh.warn {
  color: var(--color-clay);
}

.weather-tips {
  max-width: 220rpx;
  font-size: 22rpx;
  color: #8A6A1F;
  text-align: right;
  line-height: 1.5;
  background: #FBF3DF;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
}

/* 预报条 */
.weather-forecast {
  display: flex;
  justify-content: space-around;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0E8D5;
}

.forecast-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.forecast-day {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.forecast-icon { font-size: 36rpx; }

.forecast-temp {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* 公告横幅 —— 稻谷金公告条 */
.notice-swiper {
  margin: 24rpx 28rpx;
  height: 78rpx;
  background: linear-gradient(135deg, #FBF3DF, #F6E8C4);
  border-radius: 12rpx;
  border: 1rpx solid rgba(217, 164, 65, 0.28);
  box-shadow: 0 2rpx 10rpx rgba(217, 164, 65, 0.10);
  overflow: hidden;
}

.notice-item {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 24rpx;
}

.notice-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, var(--color-gold), #C8952F);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 功能四宫格 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 24rpx 24rpx 16rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  transition: all 0.15s ease;
  border-radius: 20rpx;
}

.feature-item:active {
  background: rgba(0,0,0,0.03);
  transform: scale(0.95);
}

.feature-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.12);
  transition: all 0.15s ease;
}

/* 四宫格配色全部取自主题板：站牌绿 / 稻谷金 / 深站牌绿 / 陶土橙 */
.green-bg { background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); box-shadow: 0 6rpx 18rpx var(--color-primary-shadow); }
.gold-bg { background: linear-gradient(135deg, var(--color-gold), #B98A2E); box-shadow: 0 6rpx 18rpx rgba(217,164,65,0.24); }
.deep-bg { background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary)); box-shadow: 0 6rpx 18rpx var(--color-primary-shadow); }
.clay-bg { background: linear-gradient(135deg, var(--color-clay), #A64A1F); box-shadow: 0 6rpx 18rpx rgba(199,91,42,0.24); }

.feature-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-ink);
}

/* 通用section */
.section {
  margin: 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 4rpx 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 0.5rpx;
}

.section-more {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
  padding: 8rpx 16rpx;
  background: var(--color-primary-light);
  border-radius: 24rpx;
  transition: all 0.15s ease;
}

/* 公交列表（卡片本体样式由全局 .ticket-card 提供：主券+副券+打孔撕票线） */
.bus-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.bus-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.bus-number {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 1rpx;
}

.bus-status {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  padding: 6rpx 18rpx;
  background: #EFEAE0;
  border-radius: 20rpx;
  font-weight: 500;
}

.bus-status.running {
  color: var(--color-status-shipping);
  background: var(--color-primary-light);
  position: relative;
}

.bus-status.running::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  background: var(--color-accent);
  border-radius: 50%;
  margin-right: 8rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.3); }
}

.bus-route {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.bus-info {
  font-size: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14rpx;
  border-top: 1rpx solid #F0F0F0;
}

.bus-next {
  color: var(--color-text-secondary);
}

/* 公交元信息（位置/更新时间） */
.bus-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 4rpx 14rpx;
}
.bus-meta-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 公交空态 / 错误态 */
.bus-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 60rpx 0 40rpx;
}
.bus-empty-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}
.bus-empty-title {
  font-size: 28rpx;
  color: var(--color-ink);
  font-weight: 600;
}
.bus-line-chip {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  text-align: center;
}
.bus-retry {
  padding: 12rpx 40rpx;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: 999rpx;
  font-size: 26rpx;
}

/* 公交标签（数据来源/班次） */
.bus-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.bus-tag {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  background: var(--color-primary-light);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.bus-tag.tag-live {
  color: #ffffff;
  background: var(--color-primary);
}
.bus-dist {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}
.ticket-card__stub-value.stub-eta {
  font-size: 30rpx;
}

/* 推荐产品 */
.product-scroll {
  white-space: nowrap;
  padding-bottom: 10rpx;
}

.product-card {
  display: inline-block;
  width: 290rpx;
  background: #fff;
  border-radius: 18rpx;
  margin-right: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04), 0 6rpx 20rpx rgba(0,0,0,0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.product-card:active {
  transform: scale(0.97);
}

.product-img {
  width: 290rpx;
  height: 210rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-img-real {
  width: 100%;
  height: 100%;
}

.product-info {
  padding: 18rpx 20rpx 20rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.product-from {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 10rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.product-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-price);
}

.product-unit {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ============ 老年人模式：首页字体放大 ============ */
.elderly-mode .village-name { font-size: 38rpx; }
.elderly-mode .loc-hint { padding: 10rpx 22rpx; }
.elderly-mode .loc-hint-text { font-size: 28rpx; }
.elderly-mode .bus-meta-text { font-size: 26rpx; }
.elderly-mode .bus-empty-text { font-size: 30rpx; }
.elderly-mode .bus-empty-title { font-size: 32rpx; }
.elderly-mode .bus-line-chip { font-size: 26rpx; padding: 10rpx 24rpx; }
.elderly-mode .bus-retry { font-size: 30rpx; padding: 16rpx 48rpx; }
.elderly-mode .bus-tag { font-size: 24rpx; }
.elderly-mode .bus-next { font-size: 28rpx; }
.elderly-mode .bus-dist { font-size: 26rpx; }
.elderly-mode .search-input { font-size: 32rpx; }
.elderly-mode .weather-pill-text { font-size: 30rpx; }
.elderly-mode .weather-pill-more { font-size: 26rpx; }
.elderly-mode .weather-temp { font-size: 60rpx; }
.elderly-mode .weather-condition { font-size: 32rpx; }
.elderly-mode .weather-detail { font-size: 26rpx; }
.elderly-mode .weather-tips { font-size: 26rpx; max-width: 260rpx; }
.elderly-mode .weather-refresh { font-size: 24rpx; }
.elderly-mode .forecast-day { font-size: 26rpx; }
.elderly-mode .forecast-temp { font-size: 26rpx; }
.elderly-mode .notice-text { font-size: 30rpx; }
.elderly-mode .feature-name { font-size: 28rpx; }
.elderly-mode .feature-icon-box { width: 112rpx; height: 112rpx; }
.elderly-mode .section-title { font-size: 38rpx; }
.elderly-mode .section-more { font-size: 30rpx; }
.elderly-mode .bus-number { font-size: 44rpx; }
.elderly-mode .bus-status { font-size: 26rpx; }
.elderly-mode .bus-route { font-size: 30rpx; }
.elderly-mode .bus-info { font-size: 28rpx; }
.elderly-mode .product-name { font-size: 32rpx; }
.elderly-mode .product-from { font-size: 26rpx; }
.elderly-mode .product-price { font-size: 40rpx; }
.elderly-mode .product-unit { font-size: 26rpx; }
.elderly-mode .top-badge { font-size: 24rpx; }
.elderly-mode .top-sub { font-size: 26rpx; }
.elderly-mode .notice-tag { font-size: 26rpx; }
