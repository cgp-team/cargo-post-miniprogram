<!-- 消息通知中心 -->
<view class="page {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <!-- 头部站牌带：与导航栏同色衔接，放筛选与全部已读 -->
  <view class="page-head">
    <view class="head-row">
      <view class="tabs">
        <view class="tab {{filter === 'ALL' ? 'active' : ''}}" bindtap="onFilter" data-filter="ALL" hover-class="hover">全部</view>
        <view class="tab {{filter === 'UNREAD' ? 'active' : ''}}" bindtap="onFilter" data-filter="UNREAD" hover-class="hover">未读</view>
      </view>
      <view class="read-all" wx:if="{{unreadCount > 0}}" bindtap="onReadAll" hover-class="hover">全部已读</view>
    </view>
    <text class="head-sub">{{unreadCount > 0 ? '有 ' + unreadCount + ' 条未读消息，点一下即标为已读' : '订单与物流的新动态会在这里推送'}}</text>
  </view>

  <view class="list" wx:if="{{list.length > 0}}">
    <view class="n-card {{item.readStatus === 0 ? 'unread' : 'read'}} level-{{item.level || 'INFO'}}"
          wx:for="{{list}}" wx:key="id"
          bindtap="onTapItem" data-id="{{item.id}}" data-order-id="{{item.orderId}}" hover-class="hover">
      <view class="n-icon"><text class="n-icon-emoji">{{item.icon}}</text></view>
      <view class="n-body">
        <view class="n-top">
          <text class="n-title">{{item.title}}</text>
          <view class="n-dot" wx:if="{{item.readStatus === 0}}"></view>
        </view>
        <text class="n-content">{{item.content}}</text>
        <view class="n-meta">
          <text class="n-pill n-pill--type">{{item.eventTypeName || '通知'}}</text>
          <view class="n-pill n-pill--order" wx:if="{{item.orderNo}}">
            <icon name="box" size="20" color="{{iconClay}}" />
            <text class="n-pill--order-no">{{item.orderNo}}</text>
          </view>
          <text class="n-pill n-pill--action" wx:if="{{item.actionRequired}}">需要处理</text>
          <view class="n-pill n-pill--time">
            <icon name="clock" size="20" color="#8A8778" />
            <text>{{item.createTimeText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <empty-state wx:elif="{{!loading}}" emoji="📭" text="暂无消息" subText="订单状态更新后会在这里推送" />

  <view class="more" wx:if="{{hasMore && list.length > 0}}" bindtap="loadMore" hover-class="hover">
    {{loading ? '加载中...' : '点击加载更多'}}
  </view>
</view>
