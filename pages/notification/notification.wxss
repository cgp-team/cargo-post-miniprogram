page {
  background: #F6F2E9;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tabs {
  display: flex;
  background: #EFE9DC;
  border-radius: 999rpx;
  padding: 6rpx;
}

.tab {
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #6B6355;
}

.tab.active {
  background: #2E7D32;
  color: #FFFFFF;
}

.read-all {
  font-size: 26rpx;
  color: #2E7D32;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 50, 30, 0.06);
  position: relative;
}

.card.unread {
  border-left: 8rpx solid #2E7D32;
}

.card-hover {
  opacity: 0.85;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2B2B2B;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E5573F;
}

.card-content {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6B6355;
  line-height: 1.5;
}

.card-bottom {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  font-size: 22rpx;
  color: #2E7D32;
  background: #E7F2E8;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.time {
  font-size: 24rpx;
  color: #A79E8C;
}

.more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: #6B6355;
}

/* 老年模式：整体放大 */
.elderly-mode .card-title {
  font-size: 38rpx;
}

.elderly-mode .card-content,
.elderly-mode .tab,
.elderly-mode .read-all,
.elderly-mode .more {
  font-size: 32rpx;
}
