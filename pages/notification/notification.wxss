page {
  background: #F5F8FC;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tabs {
  display: flex;
  background: #EFE9DC;
  border-radius: 999rpx;
  padding: 6rpx;
}

.tab {
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #6B6355;
}

.tab.active {
  background: #1F5E9E;
  color: #FFFFFF;
}

.read-all {
  font-size: 26rpx;
  color: #1F5E9E;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 50, 30, 0.06);
  position: relative;
}

.card.unread {
  border-left: 8rpx solid #2E7BBF;
}

.card-hover {
  opacity: 0.85;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2B2B2B;
  /* 长标题不换行溢出：单行省略，避免文字跑到卡片外 */
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding-right: 12rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E5573F;
}

.card-content {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6B6355;
  line-height: 1.5;
  word-break: break-word;
}

.card-bottom {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  font-size: 22rpx;
  color: #1F5E9E;
  background: #E6EFF5;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  white-space: nowrap;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.time {
  font-size: 24rpx;
  color: #A79E8C;
  white-space: nowrap;
}

.more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: #6B6355;
}

/* 老年模式：整体放大 */
.elderly-mode .card-title {
  font-size: 38rpx;
}

.elderly-mode .card-content,
.elderly-mode .tab,
.elderly-mode .read-all,
.elderly-mode .more {
  font-size: 32rpx;
}
