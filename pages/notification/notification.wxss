/* 消息通知中心样式 */
.page {
  min-height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 头部站牌带：深绿渐变，与主题导航栏无缝衔接 */
.page-head {
  position: relative;
  overflow: hidden;
  padding: 28rpx 28rpx 32rpx;
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
}

/* 顶部落款横档（站牌金属边） */
.page-head::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 28rpx;
  right: 28rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 3rpx;
}

.page-head::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.head-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 筛选胶囊：绿带上的半透明白底 */
.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: var(--radius-pill);
  padding: 6rpx;
}

.tab {
  padding: 12rpx 36rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.88);
  transition: all 0.18s ease;
}

.tab.active {
  background: #ffffff;
  color: var(--color-primary-dark);
  font-weight: 700;
}

.read-all {
  font-size: 26rpx;
  color: #ffffff;
  padding: 10rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: var(--radius-pill);
}

.head-sub {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
}

/* 通知卡片列表 */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 24rpx 0;
}

.n-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: row;
  background: #FFFDF8;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 24rpx 28rpx;
  box-shadow: var(--shadow-card);
}

/* 未读：左侧语义色竖条（按级别取色）；已读无竖条、整体降透明度 */
.n-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: transparent;
}

.n-card.unread.level-SUCCESS::before { background: var(--color-accent); }
.n-card.unread.level-WARNING::before { background: var(--color-status-warn); }
.n-card.unread.level-EXCEPTION::before { background: var(--color-danger); }
.n-card.unread.level-ACTION_REQUIRED::before { background: var(--color-clay); }
.n-card.unread.level-INFO::before { background: var(--color-primary); }

.n-card.read {
  opacity: 0.72;
}

/* 左侧类型图标 chip：浅底圆角方块，emoji 居中 */
.n-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.n-card.level-WARNING .n-icon { background: #F7EFD8; }
.n-card.level-EXCEPTION .n-icon { background: #F9E5E2; }
.n-card.level-ACTION_REQUIRED .n-icon { background: #F9E9E0; }

.n-icon-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.n-body {
  flex: 1;
  min-width: 0;
}

.n-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.n-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  /* 长标题单行省略，避免溢出卡片 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding-right: 12rpx;
}

/* 未读标题加粗回墨 */
.n-card.unread .n-title {
  font-weight: 700;
  color: var(--color-ink);
}

.n-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-clay);
}

.n-content {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  word-break: break-word;
}

/* 底部胶囊行：类型 / 单号 / 需处理 / 时间 */
.n-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.n-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  white-space: nowrap;
}

.n-pill--type {
  color: var(--color-primary);
  background: var(--color-primary-light);
  font-weight: 600;
}

.n-pill--order {
  color: var(--color-clay);
  background: #F9E9E0;
  max-width: 320rpx;
}

.n-pill--order-no {
  overflow: hidden;
  text-overflow: ellipsis;
}

.n-pill--action {
  color: #ffffff;
  background: var(--color-clay);
  font-weight: 600;
}

.n-pill--time {
  margin-left: auto;
  color: var(--color-text-tertiary);
  background: rgba(60, 50, 30, 0.05);
}

/* 骨架通知卡（加载态）：仿 .n-card 轮廓——左图标块 + 右标题/正文条 */
.sk-n-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 0; /* .list 已有 gap，避免与 .skeleton-card 的下边距叠加 */
}
.sk-n-icon {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
}
.sk-n-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 4rpx;
}
.sk-n-title { width: 45%; height: 32rpx; }
.sk-w-60 { width: 60%; }
.sk-w-75 { width: 75%; }
.sk-n-line { width: 90%; height: 24rpx; }
.sk-n-short { width: 65%; }

.more {
  max-width: 320rpx;
  margin: 24rpx auto 0;
  padding: 14rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-primary);
  background: #FFFDF8;
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
  box-sizing: border-box;
}

/* ============ 老年人模式：通知页字体放大 ============ */
.elderly-mode .tab { font-size: 32rpx; padding: 14rpx 40rpx; }
.elderly-mode .read-all { font-size: 30rpx; }
.elderly-mode .head-sub { font-size: 28rpx; }
.elderly-mode .n-title { font-size: 38rpx; }
.elderly-mode .n-content { font-size: 32rpx; }
.elderly-mode .n-pill { font-size: 26rpx; padding: 8rpx 20rpx; }
.elderly-mode .more { font-size: 30rpx; }
