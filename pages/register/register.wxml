<!-- 注册页面 - 短信验证码注册 -->
<view class="register-page {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">
  <view class="page-header">
    <text class="page-title">📱 注册账号</text>
    <text class="page-desc">首次短信验证码登录即自动注册</text>
    <view class="header-wave"></view>
  </view>

  <view class="form-section">
    <view class="input-group">
      <text class="input-label">📱 手机号码 <text class="required">*</text></text>
      <input
        class="input-field"
        type="number"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>

    <view class="input-group">
      <text class="input-label">✉️ 验证码 <text class="required">*</text></text>
      <view class="sms-row">
        <input
          class="input-field sms-field"
          type="number"
          placeholder="验证码"
          value="{{smsCode}}"
          bindinput="onSmsCodeInput"
          maxlength="6"
        />
        <button
          class="sms-btn {{smsCountdown > 0 ? 'disabled' : ''}}"
          bindtap="handleSendSms" hover-class="hover"
          disabled="{{smsCountdown > 0 || smsCodeSending}}"
        >
          {{smsCountdown > 0 ? smsCountdown + 's' : '发送验证码'}}
        </button>
      </view>
    </view>
    <view class="sms-tip">测试环境固定验证码：9999</view>

    <button
      class="btn-primary register-btn"
      bindtap="handleRegister" hover-class="hover"
      loading="{{loading}}"
    >
      注册
    </button>

    <view class="login-link">
      <text class="text-gray">已有账号？</text>
      <text class="text-green" bindtap="goToLogin">返回登录</text>
    </view>
  </view>
</view>
