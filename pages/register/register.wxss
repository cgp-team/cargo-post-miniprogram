/* 注册页面样式 - 农村客货邮小程序 */
.register-page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-primary-light) 30%, var(--color-paper) 60%);
  padding-bottom: 80rpx;
  position: relative;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 30%, var(--color-primary) 60%, var(--color-accent) 100%);
  padding: 80rpx 40rpx 70rpx;
  position: relative;
  overflow: hidden;
}

/* 头部装饰 */
.page-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 30%;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 14rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

.page-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  position: relative;
  z-index: 1;
  line-height: 1.5;
}

/* 底部波浪 */
.header-wave {
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 100%;
  height: 40rpx;
  background: var(--color-paper);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  z-index: 2;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 36rpx 40rpx;
  gap: 0;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #999;
  font-weight: 600;
  transition: all 0.15s ease;
}

.step-dot.active {
  background: linear-gradient(135deg, var(--color-primary), #43A047);
  border-color: var(--color-primary);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(46,125,50,0.3);
}

.step-dot.done {
  background: var(--color-accent);
  border-color: var(--color-accent);
  color: #fff;
}

.step-line {
  width: 80rpx;
  height: 3rpx;
  background: #E0E0E0;
  margin: 0 4rpx;
  transition: all 0.15s ease;
}

.step-line.done {
  background: var(--color-accent);
}

/* 表单区域 */
.form-section {
  margin: 0 28rpx;
  position: relative;
  z-index: 1;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.07);
  background: #fff;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  padding-bottom: 24rpx;
  margin-bottom: 30rpx;
  border-bottom: 2rpx solid var(--color-primary-light);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, var(--color-primary), var(--color-accent));
  border-radius: 3rpx;
  display: inline-block;
}

/* 输入组 */
.register-page .input-group {
  margin-bottom: 28rpx;
}

.register-page .input-label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.register-page .input-field {
  width: 100%;
  height: 92rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  background-color: #F8FAF8;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.register-page .input-field:focus {
  border-color: var(--color-accent);
  background-color: #fff;
  box-shadow: 0 0 0 6rpx rgba(76, 175, 80, 0.08);
}

.register-page .input-field::placeholder {
  color: #A6A6A6;
}

.required {
  color: #E53935;
  font-weight: 600;
}

/* 选择器 */
.picker-field {
  width: 100%;
  height: 92rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  line-height: 92rpx;
  background-color: #F8FAF8;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.picker-field.placeholder {
  color: #A6A6A6;
}

/* 协议 */
.agreement {
  margin: 36rpx 0 10rpx;
  padding: 24rpx;
  background: #F8FAF8;
  border-radius: 14rpx;
  border: 1rpx solid var(--color-primary-light);
}

.agree-text {
  font-size: 26rpx;
  color: #777;
  margin-left: 8rpx;
  line-height: 1.7;
}

.agree-text .text-green {
  font-weight: 600;
}

/* 注册按钮 */
.register-btn {
  margin-top: 28rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: var(--color-on-primary);
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  transition: all 0.15s ease;
}

.register-btn:active {
  background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  transform: scale(0.98);
}

.register-btn[disabled] {
  background: #BDBDBD;
  color: #ffffff;
  box-shadow: none;
  letter-spacing: 2rpx;
}

/* 返回登录 */
.login-link {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
  font-size: 28rpx;
  gap: 8rpx;
  padding-bottom: 10rpx;
}

.login-link .text-green {
  font-weight: 600;
}

/* 短信验证码行 */
.sms-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sms-field {
  flex: 1;
}

.sms-btn {
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  background: #fff;
  border: 2rpx solid var(--color-accent);
  color: var(--color-primary);
  border-radius: 36rpx;
  padding: 0;
  text-align: center;
}

.sms-btn.disabled {
  border-color: #BDBDBD;
  color: #BDBDBD;
}

.sms-tip {
  text-align: center;
  font-size: 24rpx;
  color: #757575;
  margin-top: -8rpx;
  margin-bottom: 16rpx;
}

/* ============ 老年人模式：注册页字体放大 ============ */
.elderly-mode .page-title { font-size: 52rpx; }
.elderly-mode .page-desc { font-size: 30rpx; }
.elderly-mode .register-page .input-label { font-size: 32rpx; }
.elderly-mode .register-page .input-field { font-size: 34rpx; height: 104rpx; }
.elderly-mode .register-btn { font-size: 40rpx; }
.elderly-mode .sms-btn { font-size: 30rpx; width: 220rpx; }
.elderly-mode .login-link { font-size: 32rpx; }
