/* 注册页面样式 - 农村客货邮小程序 */
.register-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F5E9 0%, #F1F8E9 30%, #F5F5F5 60%);
  padding-bottom: 80rpx;
  position: relative;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(160deg, #1B5E20 0%, #2E7D32 30%, #388E3C 60%, #43A047 100%);
  padding: 80rpx 40rpx 70rpx;
  position: relative;
  overflow: hidden;
}

/* 头部装饰 */
.page-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 30%;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 14rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

.page-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  position: relative;
  z-index: 1;
  line-height: 1.5;
}

/* 底部波浪 */
.header-wave {
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 100%;
  height: 40rpx;
  background: #F5F5F5;
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  z-index: 2;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 36rpx 40rpx;
  gap: 0;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #999;
  font-weight: 600;
  transition: all 0.3s;
}

.step-dot.active {
  background: linear-gradient(135deg, #2E7D32, #43A047);
  border-color: #2E7D32;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(46,125,50,0.3);
}

.step-dot.done {
  background: #4CAF50;
  border-color: #4CAF50;
  color: #fff;
}

.step-line {
  width: 80rpx;
  height: 3rpx;
  background: #E0E0E0;
  margin: 0 4rpx;
  transition: all 0.3s;
}

.step-line.done {
  background: #4CAF50;
}

/* 表单区域 */
.form-section {
  margin: 0 28rpx;
  position: relative;
  z-index: 1;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.07);
  background: #fff;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1B5E20;
  padding-bottom: 24rpx;
  margin-bottom: 30rpx;
  border-bottom: 2rpx solid #E8F5E9;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #2E7D32, #4CAF50);
  border-radius: 3rpx;
  display: inline-block;
}

/* 输入组 */
.register-page .input-group {
  margin-bottom: 28rpx;
}

.register-page .input-label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.register-page .input-field {
  width: 100%;
  height: 92rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  background-color: #F8FAF8;
  box-sizing: border-box;
  transition: all 0.3s;
}

.register-page .input-field:focus {
  border-color: #4CAF50;
  background-color: #fff;
  box-shadow: 0 0 0 6rpx rgba(76,175,80,0.08);
}

.register-page .input-field::placeholder {
  color: #BDBDBD;
}

.required {
  color: #E53935;
  font-weight: 600;
}

/* 选择器 */
.picker-field {
  width: 100%;
  height: 92rpx;
  border: 2rpx solid #E8ECEE;
  border-radius: 14rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  line-height: 92rpx;
  background-color: #F8FAF8;
  box-sizing: border-box;
  transition: all 0.3s;
}

.picker-field.placeholder {
  color: #BDBDBD;
}

/* 协议 */
.agreement {
  margin: 36rpx 0 10rpx;
  padding: 24rpx;
  background: #F8FAF8;
  border-radius: 14rpx;
  border: 1rpx solid #E8F5E9;
}

.agree-text {
  font-size: 26rpx;
  color: #777;
  margin-left: 8rpx;
  line-height: 1.7;
}

.agree-text .text-green {
  font-weight: 600;
}

/* 注册按钮 */
.register-btn {
  margin-top: 28rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
  background: linear-gradient(135deg, #2E7D32, #43A047);
  color: #fff;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(46,125,50,0.3);
  transition: all 0.3s;
}

.register-btn:active {
  background: linear-gradient(135deg, #1B5E20, #2E7D32);
  transform: scale(0.98);
}

.register-btn[disabled] {
  background: #BDBDBD;
  color: #ffffff;
  box-shadow: none;
  letter-spacing: 2rpx;
}

/* 返回登录 */
.login-link {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
  font-size: 28rpx;
  gap: 8rpx;
  padding-bottom: 10rpx;
}

.login-link .text-green {
  font-weight: 600;
}
