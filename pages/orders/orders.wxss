/* 我的订单页样式 */
.page-orders {
  min-height: 100vh;
  background: var(--color-paper);
}

/* 状态 tab */
.order-tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  background: #fff;
  padding: 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.order-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 0;
  position: relative;
}

.order-tab.active {
  color: var(--color-primary);
  font-weight: 700;
}

.order-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

/* 订单卡片 */
.order-list {
  padding: 20rpx 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.order-no {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.order-status {
  font-size: 26rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
}

/* 状态 chip：浅底深字 */
.order-status.status-pending {
  color: var(--color-status-pending);
  background: #F9E9E0;
}

.order-status.status-shipping {
  color: var(--color-status-shipping);
  background: var(--color-primary-light);
}

.order-status.status-done {
  color: var(--color-status-done);
  background: #F2F0EA;
}

.order-goods {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.order-goods-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-s);
  flex-shrink: 0;
}

.order-goods-img-ph {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-s);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.order-goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-goods-name {
  font-size: 28rpx;
  color: #333;
}

.order-goods-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.order-goods-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

/* 配送提示：已发货=司机配送中（引导看溯源与到站提醒） */
.order-delivery-hint {
  margin-top: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  background: #EAF4EC;
  color: #2E7D32;
  font-size: 24rpx;
}

.order-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.order-foot-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.order-total {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.order-cancel {
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #D9D9D9;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
}

.order-trace {
  font-size: 26rpx;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
}

.order-nomore {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  padding: 20rpx 0;
}

/* 老年人模式 */
.elderly-mode .order-tab { font-size: 32rpx; }
.elderly-mode .order-goods-name { font-size: 32rpx; }
.elderly-mode .order-status { font-size: 30rpx; }
.elderly-mode .order-total { font-size: 32rpx; }
.elderly-mode .order-cancel { font-size: 30rpx; padding: 12rpx 28rpx; }
.elderly-mode .order-trace { font-size: 30rpx; padding: 12rpx 28rpx; }
.elderly-mode .order-no { font-size: 28rpx; }
.elderly-mode .order-goods-sub { font-size: 28rpx; }
.elderly-mode .order-time { font-size: 28rpx; }

/* 订单来源切换：商城订单 / 寄货订单（寄货订单点卡片进「快递」页看物流详情） */
.order-source-tabs {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx 0;
  background: #fff;
}
.order-source-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: #f6f2e9;
}
.order-source-tab.active {
  color: #fff;
  background: var(--color-primary);
  font-weight: 700;
}
.elderly-mode .order-source-tab { font-size: 32rpx; }
