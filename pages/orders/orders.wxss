/* 我的订单页样式 */
.page-orders {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 状态 tab */
.order-tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  background: #fff;
  padding: 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.order-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 0;
  position: relative;
}

.order-tab.active {
  color: var(--color-primary);
  font-weight: 700;
}

.order-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

/* 订单卡片 */
.order-list {
  padding: 20rpx 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: 700;
}

.order-goods {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.order-emoji {
  font-size: 56rpx;
}

.order-goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-goods-name {
  font-size: 28rpx;
  color: #333;
}

.order-goods-sub {
  font-size: 24rpx;
  color: #999;
}

.order-goods-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-foot-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.order-total {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.order-cancel {
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #D9D9D9;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
}

.order-nomore {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 20rpx 0;
}

/* 空状态 */
.order-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.empty-btn {
  font-size: 28rpx;
  color: #fff;
  background: var(--color-primary);
  border-radius: 36rpx;
  padding: 16rpx 48rpx;
}

.safe-area-bottom {
  height: 20rpx;
}

/* 老年人模式 */
.elderly-mode .order-tab { font-size: 32rpx; }
.elderly-mode .order-goods-name { font-size: 32rpx; }
.elderly-mode .order-status { font-size: 30rpx; }
.elderly-mode .order-total { font-size: 32rpx; }
.elderly-mode .order-cancel { font-size: 30rpx; padding: 12rpx 28rpx; }
