/* 我的订单页样式 */
.page-orders {
  min-height: 100vh;
  /* 顶部一段浅主题色渐变，与深绿导航栏顺色衔接 */
  background: linear-gradient(180deg, var(--color-primary-light) 0rpx, var(--color-paper) 260rpx);
}

/* 订单来源切换：站牌式分段开关（商城订单 / 寄货订单） */
.order-source-tabs {
  display: flex;
  gap: 8rpx;
  margin: 20rpx 24rpx 0;
  padding: 8rpx;
  background: #EDE7D9;
  border-radius: var(--radius-pill);
}
.order-source-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  padding: 14rpx 0;
  border-radius: var(--radius-pill);
  transition: all 0.15s ease;
}
.order-source-tab.active {
  color: #fff;
  background: var(--color-primary);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx var(--color-primary-shadow);
}

/* 状态筛选胶囊条：吸顶，与来源开关同一套分段语言 */
.order-tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 16rpx 24rpx;
  background: var(--color-paper);
  box-shadow: 0 2rpx 8rpx rgba(60, 50, 30, 0.04);
}
.order-tabs-track {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: #EDE7D9;
  border-radius: var(--radius-pill);
}
.order-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  padding: 12rpx 0;
  border-radius: var(--radius-pill);
  transition: all 0.15s ease;
}
.order-tab.active {
  color: #fff;
  background: var(--color-primary);
  font-weight: 700;
  box-shadow: 0 4rpx 10rpx var(--color-primary-shadow);
}

/* 订单列表（卡片本体由全局 .ticket-card 提供：主券 + 副券 + 打孔撕票线） */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 24rpx 8rpx;
}

/* 本页副券加宽，容纳金额大字 */
.page-orders .ticket-card__stub {
  width: 164rpx;
}
.ticket-card__stub-value.stub-price {
  font-size: 32rpx;
  color: var(--color-price);
}

/* 票头：单号 + 状态胶囊 */
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}
.order-serial {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-status {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
}

/* 状态胶囊：浅底深字，语义色跟随主题 */
.order-status.status-pending {
  color: var(--color-status-pending);
  background: #F9E9E0;
}
.order-status.status-shipping {
  color: var(--color-status-shipping);
  background: var(--color-primary-light);
}
.order-status.status-done {
  color: var(--color-status-done);
  background: #F2F0EA;
}

/* 商品行 */
.order-goods {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}
.order-goods-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-s);
  flex-shrink: 0;
}
.order-goods-img-ph {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-s);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.order-goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.order-goods-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-goods-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.order-goods-amount {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-price);
}

/* 配送提示：浅绿小路条 */
.order-delivery-hint {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 4rpx;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  background: var(--color-primary-light);
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-primary);
}
.order-delivery-hint-text {
  flex: 1;
}

/* 票脚：时间 + 操作 */
.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EBDD;
}
.order-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.order-foot-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.order-hint-link {
  font-size: 24rpx;
  color: var(--color-primary);
}
.order-cancel {
  position: relative;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid #D8D2C4;
  border-radius: var(--radius-pill);
  padding: 8rpx 24rpx;
}
.order-trace {
  position: relative;
  font-size: 26rpx;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
  padding: 8rpx 24rpx;
}
/* 扩热区：描边胶囊本体约 52rpx 高，伪元素把点击面扩到 80rpx */
.order-cancel::after,
.order-trace::after {
  content: '';
  position: absolute;
  top: -14rpx;
  right: -10rpx;
  bottom: -14rpx;
  left: -10rpx;
}
.order-nomore {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  padding: 20rpx 0;
}

/* 加载骨架：三张订单卡叠放（.loading-state 原为居中文案，骨架时改纵向铺满） */
.loading-state.order-skeletons {
  display: block;
  padding: 20rpx 24rpx 8rpx;
}
/* 仿真实订单卡：左主券（单号条 + 商品行 + 票脚条）+ 右副券块 */
.sk-order {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.sk-order-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sk-order-serial { width: 40%; height: 20rpx; }
.sk-serial-w2 { width: 52%; }
.sk-order-goods {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.sk-order-img {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-s);
}
.sk-order-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sk-order-name { width: 55%; height: 32rpx; }
.sk-name-w2 { width: 42%; }
.sk-order-sub { width: 70%; height: 24rpx; }
.sk-order-foot { width: 90%; height: 24rpx; }
.sk-order-stub { flex: none; width: 120rpx; height: 72rpx; }

/* 配送中（status-shipping）状态胶囊：呼吸点（全局 .dot-live，取 currentColor） */
.order-status-dot {
  margin-right: 8rpx;
}

/* 老年人模式 */
.elderly-mode .order-source-tab { font-size: 32rpx; min-height: 96rpx; }
.elderly-mode .order-tab { font-size: 32rpx; min-height: 96rpx; }
.elderly-mode .order-serial { font-size: 26rpx; }
.elderly-mode .order-status { font-size: 28rpx; }
.elderly-mode .order-goods-name { font-size: 32rpx; white-space: normal; }
.elderly-mode .order-goods-sub { font-size: 28rpx; }
.elderly-mode .order-goods-amount { font-size: 32rpx; }
.elderly-mode .order-delivery-hint { font-size: 28rpx; }
.elderly-mode .order-time { font-size: 28rpx; }
.elderly-mode .order-hint-link { font-size: 28rpx; }
.elderly-mode .order-cancel { font-size: 30rpx; padding: 12rpx 28rpx; }
.elderly-mode .order-trace { font-size: 30rpx; padding: 12rpx 28rpx; }
/* 老人模式胶囊本体约 66rpx，热区扩到 96rpx */
.elderly-mode .order-cancel::after,
.elderly-mode .order-trace::after { top: -15rpx; right: -12rpx; bottom: -15rpx; left: -12rpx; }
.elderly-mode .order-nomore { font-size: 28rpx; }
/* 金额 40rpx 时本页 164rpx 副券偏紧，与快递页同档放宽 */
.elderly-mode .ticket-card__stub { width: 200rpx; }
.elderly-mode .ticket-card__stub-value.stub-price { font-size: 40rpx; }
