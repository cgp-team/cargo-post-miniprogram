/* 商城（购物）订单详情：站牌状态头 + 分组卡片 + 竖向山路时间线 */
.page-order-detail {
  min-height: 100vh;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
  /* 顶部一段浅主题色渐变，与深绿导航栏顺色衔接 */
  background: linear-gradient(180deg, var(--color-primary-light) 0rpx, var(--color-paper) 280rpx);
}
.page-order-detail.elderly-mode {
  font-size: 34rpx;
}

/* 状态头：深绿站牌（本体由全局 .signpost 提供） */
.detail-status {
  margin-bottom: 20rpx;
}
.detail-status-name {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #ffffff;
}
.detail-status-no {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 当前配送状态一句话：稻谷金提醒带；妥投后变主题浅绿 */
.detail-arrival {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #FBF3DF;
  border: 1rpx solid rgba(217, 164, 65, 0.35);
  color: #8A5A12;
  font-size: 28rpx;
  line-height: 1.5;
}
.detail-arrival-text {
  flex: 1;
}
.detail-arrival.done {
  background: var(--color-primary-light);
  border-color: var(--color-primary-shadow);
  color: var(--color-primary-dark);
}

/* 分组卡片 */
.detail-card {
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: #FFFDF8;
  box-shadow: var(--shadow-card);
}
.detail-card-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
}
.detail-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 0.5rpx;
}

/* 配送进度：竖向山路时间线（站点圆点 + 虚线路相连） */
.step-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 14rpx 0 14rpx 44rpx;
}
/* 站到站之间的虚线山路：当前站到下一站 */
.step-row:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 40rpx;
  bottom: -20rpx;
  border-left: 4rpx dashed var(--color-accent);
  opacity: 0.45;
}
/* 已走过的路段加深一点 */
.step-row.done:not(:last-child)::before {
  opacity: 0.85;
}
.step-dot {
  position: absolute;
  left: 0;
  top: 50%;
  margin-top: -12rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: #FFFDF8;
  border: 3rpx solid #D8D2C4;
}
.step-dot.done {
  border-color: var(--color-primary);
  background: var(--color-primary);
  /* 站牌圆钉：绿底白芯 */
  box-shadow: inset 0 0 0 4rpx #FFFDF8;
}
.step-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.step-name.done {
  color: var(--color-ink);
  font-weight: 600;
}
.step-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 商品清单 */
.goods-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 12rpx 0;
}
.goods-img,
.goods-img-ph {
  width: 108rpx;
  height: 108rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: var(--color-primary-light);
}
.goods-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}
.goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.goods-amount {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-price);
}

/* 合计行：票根式小结带，金额全页最醒目 */
.detail-total-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 18rpx -6rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 14rpx;
  background: #FCF8EC;
}
.detail-total-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.detail-total-value {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-price);
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 10rpx 0;
}
.info-label {
  width: 140rpx;
  flex-shrink: 0;
  color: var(--color-text-secondary);
}
.info-value {
  flex: 1;
  color: var(--color-ink);
  line-height: 1.5;
  word-break: break-all;
}

/* 操作按钮 */
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.detail-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx var(--color-primary-shadow);
}
.detail-btn.ghost {
  background: var(--color-primary-light);
  color: var(--color-primary);
  box-shadow: none;
}

/* 核验凭证 */
.proof-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 12rpx 0;
}
.proof-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: var(--color-primary-light);
  flex-shrink: 0;
  box-shadow: var(--shadow-card);
}
.proof-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.proof-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}
.proof-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.detail-foot {
  margin: 24rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

/* 骨架屏：站牌头 + 分组卡轮廓 */
.sk-head {
  height: 150rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.sk-title { width: 55%; height: 32rpx; margin-bottom: 20rpx; }
.sk-line { width: 90%; height: 24rpx; margin-bottom: 16rpx; }
.sk-line-mid { width: 70%; }
.skeleton-card .skeleton:last-child { margin-bottom: 0; }

/* 老年人模式 */
.elderly-mode .detail-status-name { font-size: 46rpx; }
.elderly-mode .detail-status-no { font-size: 28rpx; }
.elderly-mode .detail-arrival { font-size: 32rpx; }
.elderly-mode .detail-card-title { font-size: 36rpx; }
.elderly-mode .step-name { font-size: 32rpx; }
.elderly-mode .step-time { font-size: 26rpx; }
.elderly-mode .goods-name { font-size: 32rpx; }
.elderly-mode .goods-sub { font-size: 28rpx; }
.elderly-mode .goods-amount { font-size: 32rpx; }
.elderly-mode .detail-total-label { font-size: 30rpx; }
.elderly-mode .detail-total-value { font-size: 48rpx; }
.elderly-mode .detail-btn { font-size: 32rpx; padding: 22rpx 0; }
.elderly-mode .proof-label { font-size: 32rpx; }
.elderly-mode .proof-time { font-size: 28rpx; }
.elderly-mode .detail-foot { font-size: 28rpx; }
