<!-- 商城（购物）订单详情：商品清单 + 收货信息 + 承运司机 + 配送进度与核验凭证 -->
<view class="page-order-detail {{elderlyMode ? 'elderly-mode' : ''}}" style="{{themeStyle}}">

  <block wx:if="{{order}}">
    <!-- 状态头：深绿站牌（与主题导航栏顺色衔接），角标注明订单类型 -->
    <view class="detail-status signpost anim-rise">
      <text class="signpost-badge">商城订单</text>
      <text class="detail-status-name">{{statusText}}</text>
      <text class="detail-status-no" bindlongpress="copyOrderNo">订单号 {{order.orderNo}}</text>
    </view>

    <!-- 当前配送状态一句话 -->
    <view wx:if="{{arrivedText}}" class="detail-arrival {{order.deliverTime ? 'done' : ''}} anim-rise" style="animation-delay: 80ms">
      <icon wx:if="{{order.deliverTime}}" name="check" size="28" color="{{iconColor}}" />
      <icon wx:else name="road" size="28" color="{{iconClay}}" />
      <text class="detail-arrival-text">{{arrivedText}}</text>
    </view>

    <!-- 配送进度：竖向山路时间线（站点圆点 + 虚线山路相连） -->
    <view class="detail-card anim-rise" style="animation-delay: 160ms">
      <view class="detail-card-head">
        <icon name="road" size="30" color="{{iconDeep}}" />
        <text class="detail-card-title">配送进度</text>
      </view>
      <view class="step-row {{item.done ? 'done' : ''}} anim-rise" style="animation-delay: {{(index > 7 ? 7 : index) * 45}}ms" wx:for="{{steps}}" wx:key="name">
        <view class="step-dot {{item.done ? 'done' : ''}}"></view>
        <text class="step-name {{item.done ? 'done' : ''}}">{{item.name}}</text>
        <text class="step-time">{{item.time}}</text>
      </view>
    </view>

    <!-- 商品清单 -->
    <view class="detail-card anim-rise" style="animation-delay: 240ms">
      <view class="detail-card-head">
        <icon name="shop" size="30" color="{{iconDeep}}" />
        <text class="detail-card-title">商品清单</text>
      </view>
      <view class="goods-row" wx:for="{{items}}" wx:for-item="g" wx:key="productId">
        <image wx:if="{{g.imageUrl}}" class="goods-img" src="{{g.imageUrl}}" mode="aspectFill" lazy-load />
        <view wx:else class="goods-img-ph"><icon name="leaf" size="44" color="{{iconColor}}" /></view>
        <view class="goods-info">
          <text class="goods-name">{{g.productName}}</text>
          <text class="goods-sub">¥{{g.productPrice}} × {{g.quantity}}</text>
        </view>
        <text class="goods-amount">¥{{g.amountText}}</text>
      </view>
      <!-- 合计行：票根式小结带，金额突出 -->
      <view class="detail-total-row">
        <text class="detail-total-label">合计</text>
        <text class="detail-total-value">¥{{totalText}}</text>
      </view>
    </view>

    <!-- 收货信息 -->
    <view class="detail-card anim-rise" style="animation-delay: 320ms">
      <view class="detail-card-head">
        <icon name="pin" size="30" color="{{iconDeep}}" />
        <text class="detail-card-title">收货信息</text>
      </view>
      <view class="info-row">
        <text class="info-label">收货人</text>
        <text class="info-value">{{order.receiverName || '—'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">联系电话</text>
        <text class="info-value">{{order.receiverMobile || '—'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">收货地址</text>
        <text class="info-value">{{order.receiverAddress || '—'}}</text>
      </view>
      <view wx:if="{{order.remark}}" class="info-row">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>

    <!-- 承运信息 -->
    <view class="detail-card anim-rise" style="animation-delay: 400ms">
      <view class="detail-card-head">
        <icon name="bus" size="30" color="{{iconDeep}}" />
        <text class="detail-card-title">承运信息</text>
      </view>
      <view class="info-row">
        <text class="info-label">承运车辆</text>
        <text class="info-value">{{order.vehiclePlate || '待发车'}}</text>
      </view>
      <view wx:if="{{order.driverName}}" class="info-row">
        <text class="info-label">承运司机</text>
        <text class="info-value">{{order.driverName}}{{order.driverMobile ? ' · ' + order.driverMobile : ''}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">交付站点</text>
        <text class="info-value">{{order.deliverStationName || '—'}}</text>
      </view>
      <view wx:if="{{order.routeName}}" class="info-row">
        <text class="info-label">班次线路</text>
        <text class="info-value">{{order.routeName}}{{order.shiftCode ? ' · ' + order.shiftCode : ''}}</text>
      </view>
      <view class="detail-actions">
        <!-- 与订单列表口径一致：仅已发货/已完成的订单有车辆轨迹可看 -->
        <view wx:if="{{order.status === 1 || order.status === 2}}" class="detail-btn" bindtap="goToTrace" hover-class="hover">查看车辆轨迹</view>
        <view class="detail-btn ghost" bindtap="copyOrderNo" hover-class="hover">复制订单号</view>
      </view>
    </view>

    <!-- 司机核验凭证（装车拍照 / 妥投拍照） -->
    <view wx:if="{{order.loadPhotoUrl || order.deliverPhotoUrl}}" class="detail-card anim-rise" style="animation-delay: 480ms">
      <view class="detail-card-head">
        <icon name="camera" size="30" color="{{iconDeep}}" />
        <text class="detail-card-title">司机核验凭证</text>
      </view>
      <view wx:if="{{order.loadPhotoUrl}}" class="proof-row">
        <image class="proof-img" src="{{order.loadPhotoUrl}}" mode="aspectFill" data-url="{{order.loadPhotoUrl}}" bindtap="previewProof" hover-class="hover" />
        <view class="proof-meta">
          <text class="proof-label">装车核验</text>
          <text class="proof-time">{{loadTimeText || '—'}}</text>
        </view>
      </view>
      <view wx:if="{{order.deliverPhotoUrl}}" class="proof-row">
        <image class="proof-img" src="{{order.deliverPhotoUrl}}" mode="aspectFill" data-url="{{order.deliverPhotoUrl}}" bindtap="previewProof" hover-class="hover" />
        <view class="proof-meta">
          <text class="proof-label">妥投凭证</text>
          <text class="proof-time">{{deliverTimeText || '—'}}</text>
        </view>
      </view>
    </view>

    <view class="detail-foot">下单时间：{{createTimeText || '—'}}</view>
  </block>

  <!-- 加载态：骨架屏（站牌头 + 分组卡轮廓） -->
  <view wx:if="{{loading && !order}}">
    <view class="skeleton sk-head"></view>
    <view class="skeleton-card">
      <view class="skeleton sk-title"></view>
      <view class="skeleton sk-line"></view>
      <view class="skeleton sk-line sk-line-mid"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton sk-title"></view>
      <view class="skeleton sk-line"></view>
      <view class="skeleton sk-line sk-line-mid"></view>
    </view>
  </view>
  <empty-state wx:if="{{!loading && !order}}" icon="box" text="没能打开这个订单" subText="可能是网络不太好，也可能订单不存在" btnText="重新加载" bind:tapbtn="loadDetail" />

  <view class="safe-area-bottom"></view>
</view>
